local function createResult(item, index)
    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, -2, 0, 72)
    card.BackgroundColor3 = Theme.panel2
    card.BorderSizePixel = 0
    card.LayoutOrder = index
    card.Parent = Results
    corner(card, 8)
    outline(card, Theme.border, 0.35)

    local Name = label(card, tostring(item.Name or "Unnamed Model"), 13, Theme.text, Enum.Font.GothamBold)
    Name.Position = UDim2.new(0, 12, 0, 9)
    Name.Size = UDim2.new(1, -130, 0, 20)
    Name.TextTruncate = Enum.TextTruncate.AtEnd

    local creator = tostring(item.CreatorName or "Unknown creator")
    local assetId = tonumber(item.AssetId) or tonumber(item.AssetVersionId) or 0

    local Info = label(card, "by " .. creator .. "  •  ID: " .. tostring(assetId), 10, Theme.muted, Enum.Font.Gotham)
    Info.Position = UDim2.new(0, 12, 0, 34)
    Info.Size = UDim2.new(1, -130, 0, 17)
    Info.TextTruncate = Enum.TextTruncate.AtEnd

    local Insert = Instance.new("TextButton")
    Insert.Size = UDim2.new(0, 92, 0, 32)
    Insert.Position = UDim2.new(1, -104, 0.5, -16)
    Insert.BackgroundColor3 = Color3.fromRGB(30, 84, 112)
    Insert.Text = "INSERT"
    Insert.TextColor3 = Theme.text
    Insert.Font = Enum.Font.GothamBold
    Insert.TextSize = 10
    Insert.Parent = card
    corner(Insert, 8)

    Insert.MouseButton1Click:Connect(function()
        if assetId <= 0 then
            setStatus("This result has no usable Asset ID.", Theme.danger)
            return
        end

        Insert.Text = "LOADING..."
        Insert.Active = false
        setStatus("Loading asset " .. tostring(assetId) .. "...", Theme.accent)

        task.spawn(function()
            -- DIRECT INSERT TEST:
            -- Use InsertService:LoadAsset(assetId) exactly as requested.
            local ok, result = pcall(function()
                return InsertService:LoadAsset(assetId)
            end)

            if ok and result then
                local parentOk, parentError = pcall(function()
                    result.Parent = workspace
                end)

                if parentOk then
                    setStatus(
                        "Inserted: " .. tostring(item.Name or assetId) ..
                        " • ID " .. tostring(assetId),
                        Theme.success
                    )
                    Insert.Text = "INSERTED"
                    Insert.BackgroundColor3 = Color3.fromRGB(32, 105, 77)
                else
                    pcall(function()
                        result:Destroy()
                    end)
                    setStatus(
                        "Loaded, but Workspace insert failed: " .. tostring(parentError),
                        Theme.danger
                    )
                    Insert.Text = "RETRY"
                    Insert.Active = true
                end
            else
                setStatus(
                    "Insert failed • ID " .. tostring(assetId) ..
                    " • " .. tostring(result),
                    Theme.danger
                )
                Insert.Text = "RETRY"
                Insert.Active = true
                warn("[HYAZ TOOLBOX] InsertService:LoadAsset failed:", result)
            end
        end)
    end)
end

local function searchModels(query)
    if searching then return end

    query = tostring(query or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if query == "" then
        setStatus("Enter a search term first.", Theme.danger)
        return
    end

    searching = true
    resultsToken += 1
    local token = resultsToken

    Search.Text = "..."
    Search.Active = false
    clearResults()
    setStatus("Searching free Creator Store models for: " .. query, Theme.accent)

    task.spawn(function()
        local ok, response = pcall(function()
            return InsertService:GetFreeModelsAsync(query, 0)
        end)

        if token ~= resultsToken then return end

        if not ok or not response then
            searching = false
            Search.Text = "SEARCH"
            Search.Active = true
            setStatus("Search failed. Your environment may not expose GetFreeModelsAsync.", Theme.danger)
            return
        end

        local page = response
        if type(response) == "table" and response[1] then
            page = response[1]
        end

        local list = (type(page) == "table" and page.Results) or {}

        if #list == 0 then
            setStatus("No free models found for: " .. query, Theme.muted)
        else
            for i, item in ipairs(list) do
                createResult(item, i)
            end
            setStatus(tostring(#list) .. " free model result(s) • no API key used", Theme.success)
        end

        searching = false
        Search.Text = "SEARCH"
        Search.Active = true
    end)
end

