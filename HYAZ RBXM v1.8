local function padding(obj, top, right, bottom, left)
    local p = Instance.new("UIPadding", obj)
    p.PaddingTop = UDim.new(0, top or 0)
    p.PaddingRight = UDim.new(0, right or 0)
    p.PaddingBottom = UDim.new(0, bottom or 0)
    p.PaddingLeft = UDim.new(0, left or 0)
    return p
end

local function addHover(button, target, normal, hover)
    button.MouseEnter:Connect(function()
        TweenService:Create(target,TweenInfo.new(0.14,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{BackgroundColor3=hover}):Play()
