-- INPUT — raycast pakai kamera (lebih aman utk executor)
-- ═══════════════════════════════════════════════════════════
local Camera = Workspace.CurrentCamera

local function getMouseHit()
	local input = UIS:GetMouseLocation()
	local unitRay = Camera:ViewportPointToRay(input.X, input.Y)
	local ok, result = pcall(function()
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		if player.Character then params.FilterDescendantsInstances = {player.Character} end
		return Workspace:Raycast(unitRay.Origin, unitRay.Direction * 1000, params)
	end)
	if ok and result then return result.Position end
	return nil
end

UIS.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		TB.isMouseDown = true
		if TB.placementOn then
			local pos = getMouseHit()
			if pos then
				if TB.lockY then pos = Vector3.new(pos.X, TB.lockedY, pos.Z) end
				brushOnce(pos)
				updateInfo()
			end
		end
	end
end)
UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		TB.isMouseDown = false
	end
end)
RunService.RenderStepped:Connect(function()
	if TB.isMouseDown and TB.placementOn then
		local pos = getMouseHit()
		if pos then
			if TB.lockY then pos = Vector3.new(pos.X, TB.lockedY, pos.Z) end
			brushOnce(pos)
			updateInfo()
		end
	end
end)

