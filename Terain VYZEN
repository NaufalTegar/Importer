local function getTerrain() return Workspace:FindFirstChild("Terrain") end

local function totalTerrainCount()
	local n = 0
	for _, list in pairs(TB.terrainData) do
		for _, e in ipairs(list) do if not e.undone then n = n + 1 end end
	end
	return n
end

local function accurateSize(shape, sx, sy, sz)
	if shape == "Bola" then local r = sx/2; return Vector3.new(r*2,r*2,r*2), r
	elseif shape == "Silinder" then return Vector3.new(sx,sy,sz), math.max(sx,sz)*0.6
	else return Vector3.new(sx,sy,sz), nil end
end

-- ═══════════════════════════════════════════════════════════
-- CORE ENGINE
-- ═══════════════════════════════════════════════════════════
local function fillTerrain(T, pos, size, shape, matE, rotDeg)
	local cf = CFrame.new(pos) * CFrame.Angles(0, math.rad(rotDeg or 0), 0)
	local accSize, accR = accurateSize(shape, size.X, size.Y, size.Z)
	if shape == "Bola" then
		T:FillBall(pos, accR, matE)
	elseif shape == "Silinder" then
		T:FillCylinder(cf * CFrame.Angles(0,0,math.rad(90)), size.Y, accR, matE)
	else
		T:FillBlock(cf, accSize, matE)
	end
end

local function placeTerrain(pos, size, shape, matName, rotDeg)
	local T = getTerrain(); if not T then return nil end
	local matE = MAT_ENUM[matName]; if not matE then return nil end
	if not TB.terrainData[matName] then TB.terrainData[matName] = {} end
	local rot = rotDeg or 0
	local entry = { pos = pos, size = size, shape = shape, mat = matName, rot = rot, undone = false }
	table.insert(TB.terrainData[matName], entry)
	pcall(fillTerrain, T, pos, size, shape, matE, rot)
	return entry
end

local function pushUndo(matName, index)
	table.insert(TB.undoStack, {mat = matName, index = index})
	if #TB.undoStack > 150 then table.remove(TB.undoStack, 1) end
	TB.redoStack = {}
end

local function undo()
	if #TB.undoStack == 0 then return end
	local last = table.remove(TB.undoStack)
	table.insert(TB.redoStack, last)
	local T = getTerrain(); if not T then return end
	local list = TB.terrainData[last.mat]
	local e = list and list[last.index]
	if e then
		e.undone = true
		pcall(function()
			local cf = CFrame.new(e.pos) * CFrame.Angles(0, math.rad(e.rot), 0)
			if e.shape == "Bola" then T:FillBall(e.pos, e.size.X/2, Enum.Material.Air)
			elseif e.shape == "Silinder" then T:FillCylinder(cf*CFrame.Angles(0,0,math.rad(90)), e.size.Y, math.max(e.size.X,e.size.Z)*0.6, Enum.Material.Air)
			else T:FillBlock(cf, e.size, Enum.Material.Air) end
		end)
	end
end

local function redo()
	if #TB.redoStack == 0 then return end
	local e2 = table.remove(TB.redoStack)
	table.insert(TB.undoStack, e2)
	local T = getTerrain(); if not T then return end
	local list = TB.terrainData[e2.mat]
	local e = list and list[e2.index]
	if e then
		e.undone = false
		pcall(fillTerrain, T, e.pos, e.size, e.shape, MAT_ENUM[e.mat], e.rot)
	end
end

local function brushOnce(pos)
	if not TB.placementOn then return end
	if not MAT_ENUM[TB.currentMat] then return end
	local t = tick()
	if t - TB.lastBrushTime < TB.brushCooldown then return end
	local minDist = math.min(TB.width, TB.height, TB.depth) * 0.8
	if TB.lastBrushPos and (pos - TB.lastBrushPos).Magnitude < minDist then return end
	if totalTerrainCount() >= TB.limit then return end
	TB.lastBrushTime = t
	TB.lastBrushPos = pos
	local shape = TB.shapes[TB.shapeIndex]
	local entry = placeTerrain(pos, TB.blockSize, shape, TB.currentMat, TB.rotation)
	if entry then pushUndo(TB.currentMat, #TB.terrainData[TB.currentMat]) end
end

-- ═══════════════════════════════════════════════════════════
-- PART → TERRAIN NATURAL
-- ═══════════════════════════════════════════════════════════
local function hash2d(cx, cz)
	local h = (cx * 374761393 + cz * 668265263)
	h = (h ~ (h >> 13)) * 1274126177
	h = h ~ (h >> 16)
	return math.abs(h % 100000)
end
local function seedFromPos(px, py, pz)
	local base = hash2d(math.floor(px/4), math.floor(pz/4))
	return (base + math.floor(py*3.7)) % 100000
end
local function pseudoNoise(n)
	n = (n << 13) ~ n
	n = (n * (n*n*15731 + 789221) + 1376312589)
	return math.abs(math.sin(n))
end
local function reliefAt(cx, cz, seed, strength, density)
	local s, amp, h = density, strength*2, 0
	for oct = 0, 2 do
		local f = s + oct
		local nx = (cx/f) + seed % 97
		local nz = (cz/f) + seed % 89
		h = h + math.sin(nx*2.3 + seed%13) * math.sin(nz*1.7 + seed%7) * (amp/(oct+1))
	end
	h = h + (pseudoNoise(cx*13+seed) - 0.5) * (amp*0.4)
	return h
end
local function bakeNaturalTerrain(T, center, size, matE, seed, strength, density)
	local g = 4
	local wHalf, dHalf, hBase = size.X/2, size.Z/2, size.Y/2
	for wx = -wHalf, wHalf, g do
		for wz = -dHalf, dHalf, g do
			local cellSeed = seed + hash2d(math.floor(wx), math.floor(wz)) % 500
			local isHole = pseudoNoise(math.floor((wx+wz)*3.7) + cellSeed) < 0.15
			local topY = reliefAt(wx, wz, cellSeed, strength, density)
			local baseY = -hBase * 0.8
			if not isHole then
				for ty = baseY, topY, g do
					T:FillBlock(CFrame.new(center.X+wx, center.Y+ty, center.Z+wz), Vector3.new(g,g,g), matE)
				end
			end
		end
		task.wait()
	end
end
local function applyTerrainForPart(part, matName)
	local T = getTerrain(); if not T then return 0 end
	local matE = MAT_ENUM[matName]; if not matE then return 0 end
	local center = part.Position
	local sz = part.Size
	local wSize = math.clamp(sz.X, 6, 40)
	local dSize = math.clamp(sz.Z, 6, 40)
	local hSize = math.clamp(sz.Y, 4, 40)
	local seed = seedFromPos(center.X, center.Y, center.Z) + math.random(0, 999)
	local strength = 4 + (seed % 3)
	local density  = 3 + (seed % 2)
	local ok = pcall(bakeNaturalTerrain, T, center, Vector3.new(wSize,hSize,dSize), matE, seed, strength, density)
	return ok and 1 or 0
end
local function convertPartsToTerrain()
	local T = getTerrain(); if not T then return 0 end
	local c = 0
	for _, matName in ipairs(MATERIALS) do
		local f = Workspace:FindFirstChild(matName)
		if f then
			for _, part in ipairs(f:GetChildren()) do
				if part:IsA("BasePart") then
					c = c + applyTerrainForPart(part, matName)
					task.wait()
				end
			end
		end
	end
	return c
end

local function applySeaLevel(targetY, matName, radius)
	local T = getTerrain(); if not T then return false end
	local matE = MAT_ENUM[matName] or Enum.Material.Water
	local step = 8
	local ok = pcall(function()
		for dx = -radius, radius, step do
			for dz = -radius, radius, step do
				T:FillBlock(CFrame.new(dx, targetY-step/2, dz), Vector3.new(step,step,step), matE)
			end
			task.wait()
		end
	end)
	return ok
end

local function replaceMaterial(fromMat, toMat)
	local T = getTerrain(); if not T then return 0 end
	local toE = MAT_ENUM[toMat]; if not toE then return 0 end
	local count = 0
	if TB.terrainData[fromMat] then
		if not TB.terrainData[toMat] then TB.terrainData[toMat] = {} end
		for _, e in ipairs(TB.terrainData[fromMat]) do
			if not e.undone then
				e.mat = toMat
				table.insert(TB.terrainData[toMat], e)
				pcall(fillTerrain, T, e.pos, e.size, e.shape, toE, e.rot)
				count = count + 1
			end
		end
		TB.terrainData[fromMat] = {}
	end
	return count
end

local function clearAll()
	TB.terrainData = {}
	TB.undoStack = {}
	TB.redoStack = {}
	TB.lastBrushPos = nil
end

