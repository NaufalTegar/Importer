    targetingHYAZ = true
    SpawnStatus.Text = "● CLICK A SURFACE TO SPAWN"
    SpawnStatus.TextColor3 = Color3.fromRGB(255, 190, 80)
    SpawnAction.BackgroundColor3 = Color3.fromRGB(150, 75, 20)
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not targetingHYAZ or gameProcessed then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
    local camera = Workspace.CurrentCamera
    if not camera then return end
    local ray = camera:ScreenPointToRay(input.Position.X, input.Position.Y)
    local params = RaycastParams.new()
    if LocalPlayer.Character then
        params.FilterDescendantsInstances = {LocalPlayer.Character}
        params.FilterType = Enum.RaycastFilterType.Exclude
    end
    local hit = Workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
    if hit then
        local part = Instance.new("Part")
        part.Name = "HYAZ_SpecialMeshPart"
        part.Size = currentSizeHYAZ
        part.Material = Enum.Material.SmoothPlastic
        part.TopSurface = Enum.SurfaceType.Smooth
        part.BottomSurface = Enum.SurfaceType.Smooth
        part.CFrame = CFrame.new(hit.Position) * CFrame.new(0, currentSizeHYAZ.Y / 2, 0)
        part.Anchored = true
        part.CanCollide = true
        local mesh = Instance.new("SpecialMesh")
        mesh.MeshType = Enum.MeshType.Brick
        mesh.Scale = currentSizeHYAZ
        local raw = TextureBox2.Text:gsub("%D", "")
        if raw ~= "" then mesh.TextureId = "rbxassetid://" .. raw end
        mesh.Parent = part
        part.Parent = Workspace
        targetingHYAZ = false
        SpawnStatus.Text = "● SPAWNED SUCCESSFULLY"
        SpawnStatus.TextColor3 = Theme.accent
        SpawnAction.BackgroundColor3 = Theme.accentDark
        task.delay(2, function()
            if SpawnStatus and SpawnStatus.Parent then SpawnStatus.Text = "● READY" end
        end)
    end
end)

