        LoadDots.Text = dotStates[dotIndex]

        if not RevealFinished then
            tick = tick + 1
            if tick % 2 == 0 then
                KingText.TextColor3 = Color3.fromRGB(255, 25, 45)
            else
                KingText.TextColor3 = Color3.fromRGB(255, 70, 85)
            end
