local RevealTarget = "KING HYAZ"
local RevealChars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%&*!?XZ"
local RevealFinished = false

local function randomRevealChar()
    local n = math.random(1, #RevealChars)
    return RevealChars:sub(n, n)
end

local function buildRevealText(lockedCount)
    local result = {}
    for i = 1, #RevealTarget do
        local targetChar = RevealTarget:sub(i, i)
        if targetChar == " " then
            result[i] = " "
        elseif i <= lockedCount then
            result[i] = targetChar
        else
            result[i] = randomRevealChar()
        end
    end
    return table.concat(result)
end

-- Real character reveal sequence.
-- Each character rapidly glitches before locking into the correct letter.
task.spawn(function()
    math.randomseed(os.clock() * 1000000)

    KingText.Text = buildRevealText(0)

    for locked = 1, #RevealTarget do
        local targetChar = RevealTarget:sub(locked, locked)

        if targetChar == " " then
            KingText.Text = buildRevealText(locked)
            task.wait(0.10)
        else
            for glitch = 1, 7 do
                KingText.Text = buildRevealText(locked - 1)
                KingText.TextColor3 = (glitch % 2 == 0)
                    and Color3.fromRGB(255, 35, 55)
                    or Color3.fromRGB(255, 110, 120)
                task.wait(0.045)
            end

            -- Lock the real character.
            KingText.Text = buildRevealText(locked)
            KingText.TextColor3 = Color3.fromRGB(255, 25, 45)

            -- Tiny reveal flash.
            local originalPos = KingText.Position
            KingText.Position = originalPos + UDim2.new(0, math.random(-2, 2), 0, 0)
            task.wait(0.035)
            KingText.Position = originalPos
            task.wait(0.11)
        end
    end

    KingText.Text = RevealTarget
    KingText.TextColor3 = Color3.fromRGB(255, 45, 60)
    RevealFinished = true
end)

