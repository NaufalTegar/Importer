	b.ZIndex           = 100
	b.Parent           = screenGui
	b.AutoButtonColor  = false
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 5)
	-- border
	local bs = Instance.new("UIStroke", b)
	bs.Color = C.border; bs.Thickness = 1; bs.Transparency = 0.5
	return b
end

local function mkRect(parent, x, y, w, h, col, rot)
	local f = Instance.new("Frame")
	f.Size             = UDim2.new(0, w, 0, h)
	f.Position         = UDim2.new(0, x, 0, y)
	f.BackgroundColor3 = col or Color3.new(1, 1, 1)
	f.BorderSizePixel  = 0
	f.ZIndex           = parent.ZIndex + 1
	f.Parent           = parent
	f.Rotation         = rot or 0
	Instance.new("UICorner", f).CornerRadius = UDim.new(0, 2)
	return f
end

local function drawIconPanel(btn)
	mkRect(btn, 8, 7, 5, 26, Color3.fromRGB(100, 175, 255))
	mkRect(btn, 16, 9, 14, 3, Color3.fromRGB(200, 210, 220))
	mkRect(btn, 16, 17, 14, 3, Color3.fromRGB(200, 210, 220))
	mkRect(btn, 16, 25, 14, 3, Color3.fromRGB(200, 210, 220))
end
