-- Fungsi bantu: set label kecil di quickDisableBtn (vector, tanpa emoji)
local function setQDLabel(txt, col)
	-- hapus label lama
	for _,c in ipairs(UI.quickDisableBtn:GetChildren()) do
		if c:IsA("TextLabel") and c.Name=="QDLabel" then c:Destroy() end
	end
	if txt and txt~="" then
		local lbl=Instance.new("TextLabel")
		lbl.Name="QDLabel";lbl.Size=UDim2.new(1,0,1,0);lbl.BackgroundTransparency=1
		lbl.Text=txt;lbl.Font=Enum.Font.GothamBold;lbl.TextSize=11
		lbl.TextColor3=col or Color3.new(1,1,1);lbl.ZIndex=UI.quickDisableBtn.ZIndex+1
		lbl.Parent=UI.quickDisableBtn
	end
end
local function updateQuickDisableBtn()
	if _TB.treeBrushActive then
		UI.quickDisableBtn.BackgroundColor3=Color3.fromRGB(55,135,55);setQDLabel("TRE",Color3.fromRGB(180,255,180))
	elseif _TB.treeBrushReady then
		UI.quickDisableBtn.BackgroundColor3=Color3.fromRGB(95,155,75);setQDLabel("TRE",Color3.fromRGB(220,255,200))
	elseif _TB.swipeMode and _TB.swipeModeActive then
		UI.quickDisableBtn.BackgroundColor3=Color3.fromRGB(95,55,145);setQDLabel("USP",Color3.fromRGB(220,180,255))
	elseif _TB.flattenMode then
		UI.quickDisableBtn.BackgroundColor3=Color3.fromRGB(0,115,195);setQDLabel("FLT",Color3.fromRGB(180,230,255))
	elseif _TB.smoothMode then
		UI.quickDisableBtn.BackgroundColor3=Color3.fromRGB(155,155,0);setQDLabel("SMT",Color3.fromRGB(255,255,180))
	elseif _TB.erodeMode then
		UI.quickDisableBtn.BackgroundColor3=Color3.fromRGB(175,35,35);setQDLabel("ERD",Color3.fromRGB(255,180,180))
	elseif _TB.growMode then
		UI.quickDisableBtn.BackgroundColor3=Color3.fromRGB(35,155,35);setQDLabel("GRW",Color3.fromRGB(180,255,180))
	elseif _TB.paintMode then
		UI.quickDisableBtn.BackgroundColor3=Color3.fromRGB(125,35,155);setQDLabel("PNT",Color3.fromRGB(220,180,255))
	elseif _TB.seaLevelMode then
		UI.quickDisableBtn.BackgroundColor3=Color3.fromRGB(0,100,200);setQDLabel("SEA",Color3.fromRGB(180,220,255))
	elseif _TB.placementEnabled then
		UI.quickDisableBtn.BackgroundColor3=Color3.fromRGB(55,175,75);setQDLabel("ON",Color3.fromRGB(200,255,210))
	else
		UI.quickDisableBtn.BackgroundColor3=Color3.fromRGB(115,35,35);setQDLabel("OFF",Color3.fromRGB(255,200,200))
	end
	updateHUD()
end
_TB.updateSpecialBtns   = updateSpecialBtns
_TB.updateQuickDisableBtn = updateQuickDisableBtn

