	mkRect(btn, 8, 12, 12, 3, Color3.fromRGB(255, 200, 80))
	mkRect(btn, 8, 12, 3, 12, Color3.fromRGB(255, 200, 80))
	mkRect(btn, 5, 9,  7, 3,  Color3.fromRGB(255, 200, 80), -45)
