local SB_W, SB_H, SB_X = 40, 40, 8

local function mkSideBtn(yPos, bgColor)
	local b = Instance.new("TextButton")
	b.Size             = UDim2.new(0, SB_W, 0, SB_H)
	b.Position         = UDim2.new(0, SB_X, 0, yPos)
	b.Text             = ""
	b.BackgroundColor3 = bgColor
