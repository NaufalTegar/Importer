local function switchTab(tn)
	_TB.activeTab = tn
	for _, n in ipairs(tabNames) do
		UI.tabFrames[n].Visible = (n == tn)
		local btn = UI.tabBtns[n]
		if btn then
			if n == tn then
				btn.BackgroundColor3 = C.tabBar
				btn.TextColor3       = C.text
				-- Tampilkan indicator aktif
				local ind = btn:FindFirstChild("ActiveInd")
				if ind then ind.Visible = true end
			else
				btn.BackgroundColor3 = C.tabBar
				btn.TextColor3       = C.textDim
				local ind = btn:FindFirstChild("ActiveInd")
				if ind then ind.Visible = false end
			end
		end
	end
end
_TB.switchTab = switchTab

for i, tn in ipairs(tabNames) do
	local tb = Instance.new("TextButton")
	tb.Size             = UDim2.new(0, TAB_W, 1, -1)
	tb.Position         = UDim2.new(0, (i-1)*TAB_W, 0, 0)
	tb.Text             = tn
	tb.Font             = Enum.Font.GothamBold
	tb.TextSize         = 11
	tb.TextColor3       = (tn == "ADD") and C.text or C.textDim
	tb.BackgroundColor3 = C.tabBar
	tb.BorderSizePixel  = 0
	tb.ZIndex           = 12
	tb.AutoButtonColor  = false
	tb.Parent           = UI.tabBar
	UI.tabBtns[tn]      = tb

	-- Garis bawah indikator aktif
	local ind = Instance.new("Frame")
	ind.Name             = "ActiveInd"
	ind.Size             = UDim2.new(1, -4, 0, 2)
	ind.Position         = UDim2.new(0, 2, 1, -2)
	ind.BackgroundColor3 = UI.tabColors[tn]
	ind.BorderSizePixel  = 0
	ind.ZIndex           = 13
	ind.Visible          = (tn == "ADD")
	ind.Parent           = tb

	tb.MouseEnter:Connect(function()
		if _TB.activeTab ~= tn then tb.TextColor3 = C.text end
	end)
	tb.MouseLeave:Connect(function()
		if _TB.activeTab ~= tn then tb.TextColor3 = C.textDim end
	end)
	tb.MouseButton1Click:Connect(function() switchTab(tn) end)
end

-- ─── HELPER WIDGET FACTORY ─────────────────────────────────
local function mkBtn(parent, name, pos, text, sizeX, sizeY, color)
	local btn = Instance.new("TextButton")
	btn.Name             = name
	btn.Size             = UDim2.new(0, sizeX or 80, 0, sizeY or 24)
	btn.Position         = pos
	btn.Text             = text
	btn.BackgroundColor3 = color or C.btn
	btn.TextColor3       = C.text
	btn.Font             = Enum.Font.GothamSemibold
	btn.TextSize         = 11
	btn.BorderSizePixel  = 0
	btn.AutoButtonColor  = false
	btn.ZIndex           = 10
	btn.Parent           = parent
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
	-- border halus
	local bs = Instance.new("UIStroke", btn)
	bs.Color = C.border; bs.Thickness = 1; bs.Transparency = 0.7
	local oc = color or C.btn
	btn.MouseEnter:Connect(function() btn.BackgroundColor3 = C.btnHover end)
	btn.MouseLeave:Connect(function() btn.BackgroundColor3 = oc end)
	return btn
end

local function mkLbl(parent, name, pos, text, size)
	local lbl = Instance.new("TextLabel")
	lbl.Name                = name
	lbl.Size                = size or UDim2.new(0, 80, 0, 20)
	lbl.Position            = pos
	lbl.Text                = text
	lbl.BackgroundTransparency = 1
	lbl.TextColor3          = C.textDim
	lbl.Font                = Enum.Font.Gotham
	lbl.TextSize            = 11
	lbl.TextXAlignment      = Enum.TextXAlignment.Left
	lbl.ZIndex              = 10
	lbl.Parent              = parent
	return lbl
end

local function mkSep(parent, yPos)
	local s = Instance.new("Frame")
	s.Size             = UDim2.new(1, -8, 0, 1)
	s.Position         = UDim2.new(0, 4, 0, yPos)
	s.BackgroundColor3 = C.separator
	s.BorderSizePixel  = 0
	s.ZIndex           = 10
	s.Parent           = parent
end

local function mkSectionHeader(parent, yPos, text)
	local l = Instance.new("TextLabel")
	l.Size             = UDim2.new(1, -8, 0, 20)
	l.Position         = UDim2.new(0, 4, 0, yPos)
	l.BackgroundColor3 = C.section
	l.BorderSizePixel  = 0
	l.Text             = "  " .. text
	l.Font             = Enum.Font.GothamBold
	l.TextSize         = 10
	l.TextColor3       = C.textHead
	l.TextXAlignment   = Enum.TextXAlignment.Left
	l.ZIndex           = 10
	l.Parent           = parent
	Instance.new("UICorner", l).CornerRadius = UDim.new(0, 3)
end

-- Tombol kecil +/- style spinbox
local function mkSpinBtn(parent, name, pos, text)
	local btn = Instance.new("TextButton")
	btn.Name             = name
	btn.Size             = UDim2.new(0, 22, 0, 20)
	btn.Position         = pos
	btn.Text             = text
	btn.BackgroundColor3 = C.btn
	btn.TextColor3       = C.text
	btn.Font             = Enum.Font.GothamBold
	btn.TextSize         = 12
	btn.BorderSizePixel  = 0
	btn.AutoButtonColor  = false
	btn.ZIndex           = 10
	btn.Parent           = parent
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 3)
	btn.MouseEnter:Connect(function() btn.BackgroundColor3 = C.btnHover end)
	btn.MouseLeave:Connect(function() btn.BackgroundColor3 = C.btn end)
	return btn
end

-- Value display (kotak input style)
local function mkValDisp(parent, name, pos, text, w)
	local f = Instance.new("Frame")
	f.Name             = name .. "Frame"
	f.Size             = UDim2.new(0, w or 30, 0, 20)
	f.Position         = pos
	f.BackgroundColor3 = C.input
	f.BorderSizePixel  = 0
	f.ZIndex           = 10
	f.Parent           = parent
	Instance.new("UICorner", f).CornerRadius = UDim.new(0, 3)
	local bs = Instance.new("UIStroke", f)
	bs.Color = C.border; bs.Thickness = 1; bs.Transparency = 0.4
	local lbl = Instance.new("TextLabel")
	lbl.Name            = name
	lbl.Size            = UDim2.new(1, 0, 1, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text            = text
	lbl.TextColor3      = C.text
	lbl.Font            = Enum.Font.GothamBold
	lbl.TextSize        = 11
	lbl.ZIndex          = 11
	lbl.Parent          = f
	return lbl
end

