local function drawIconGrid(btn)
	local cols = {
		Color3.fromRGB(80,200,120),  Color3.fromRGB(100,175,255), Color3.fromRGB(255,165,80),
		Color3.fromRGB(200,100,255), Color3.fromRGB(80,200,120),  Color3.fromRGB(255,100,100),
		Color3.fromRGB(100,175,255), Color3.fromRGB(255,165,80),  Color3.fromRGB(200,100,255),
	}
	local idx=1
	for row = 0, 2 do for col = 0, 2 do
		mkRect(btn, 9+col*9, 9+row*9, 6, 6, cols[idx])
		idx=idx+1
	end end
end

