local function applyLightingConfig(config)
    if type(config) ~= "table" then return false end
    pcall(function() Lighting.Technology = Enum.Technology.Future end)
    pcall(function() Lighting.GlobalShadows = true end)
    pcall(function() Lighting.ShadowSoftness = 0.4 end)
    pcall(function() Lighting.EnvironmentalThrottling = Enum.EnvironmentalThrottling.Default end)

    if config.brightness ~= nil then pcall(function() Lighting.Brightness = config.brightness end) end
    if config.clockTime ~= nil then pcall(function() Lighting.ClockTime = config.clockTime end) end
    if config.ambient then pcall(function() Lighting.Ambient = config.ambient end) end
    if config.outdoorAmbient then pcall(function() Lighting.OutdoorAmbient = config.outdoorAmbient end) end
    if config.exposure ~= nil then pcall(function() Lighting.ExposureCompensation = config.exposure end) end
    if config.diffuse ~= nil then pcall(function() Lighting.EnvironmentDiffuseScale = config.diffuse end) end
    if config.specular ~= nil then pcall(function() Lighting.EnvironmentSpecularScale = config.specular end) end
    if config.colorShiftTop then pcall(function() Lighting.ColorShift_Top = config.colorShiftTop end) end
    if config.fogColor then pcall(function() Lighting.FogColor = config.fogColor end) end
    if config.fogStart ~= nil then pcall(function() Lighting.FogStart = config.fogStart end) end
    if config.fogEnd ~= nil then pcall(function() Lighting.FogEnd = config.fogEnd end) end

    -- Remove any preset effect children so successive applies don't pile up.
    for _, child in ipairs(Lighting:GetChildren()) do
        if child.Name == "CoStudioPresetColor"
            or child.Name == "CoStudioPresetBloom"
            or child.Name == "CoStudioPresetAtmosphere" then
            pcall(function() child:Destroy() end)
        end
    end

    local cc = Instance.new("ColorCorrectionEffect")
    cc.Name = "CoStudioPresetColor"
    cc.Enabled = true
    if config.contrast ~= nil then pcall(function() cc.Contrast = config.contrast end) end
    if config.saturation ~= nil then pcall(function() cc.Saturation = config.saturation end) end
    pcall(function() cc.Brightness = (config.brightness or 2) > 2.0 and 0.02 or 0.05 end)
    if config.tint then pcall(function() cc.TintColor = config.tint end) end
    cc.Parent = Lighting

    if config.bloom then
        local bloom = Instance.new("BloomEffect")
        bloom.Name = "CoStudioPresetBloom"
        bloom.Enabled = true
        pcall(function() bloom.Intensity = config.bloomIntensity or 0.6 end)
        pcall(function() bloom.Size = config.bloomSize or 24 end)
        pcall(function() bloom.Threshold = 0.75 end)
        bloom.Parent = Lighting
    end

    if config.atmosphere then
        local atmo = Instance.new("Atmosphere")
        atmo.Name = "CoStudioPresetAtmosphere"
        atmo.Parent = Lighting
        local a = config.atmosphere
        if a.density ~= nil then pcall(function() atmo.Density = a.density end) end
        if a.haze ~= nil then pcall(function() atmo.Haze = a.haze end) end
        if a.glare ~= nil then pcall(function() atmo.Glare = a.glare end) end
        if a.color then pcall(function() atmo.Color = a.color end) end
        if a.decay then pcall(function() atmo.Decay = a.decay end) end
    end
    return true
end

local function applyPackByName(name)
    for _, p in ipairs(LIGHTING_PRESETS) do
        if p.name == name then
            applyLightingConfig(p)
            return true
        end
    end
    return false
end

