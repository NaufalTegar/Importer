            messages = {
                { role = "system", content = systemPrompt },
                { role = "user", content = description },
            },
            provider = { order = { "Google AI Studio" }, allow_fallbacks = true },
        }
        local encoded = HttpService:JSONEncode(body)
        local parsed = nil
        for _, candidate in ipairs(getHttpRequests()) do
            local ok, result = callHttpCandidate(candidate, {
                Url = "https://openrouter.ai/api/v1/chat/completions",
                Method = "POST",
