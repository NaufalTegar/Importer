        button:SetAttribute("StoreActive", false)
        local buttonStroke = Instance.new("UIStroke", button)
        buttonStroke.Name = "ButtonStroke"
        buttonStroke.Color = normal == S_ACCENT and S_HOVER or S_BORDER
        buttonStroke.Transparency = 0.28
        buttonStroke.Thickness = 1
        -- Use direct color assignment instead of competing background tweens.
        -- This prevents touch/haptic-style input events from leaving a button
        -- stuck in a bright or pressed state.
        local hovering = false
        local pressedState = false
        local function baseColor()
            return button:GetAttribute("StoreActive") and S_ACCENT or normal
        end
        local function restoreButton()
            if not button.Parent then return end
            local target = pressedState and pressed or (hovering and hover or baseColor())
            button.BackgroundColor3 = target
            local active = button:GetAttribute("StoreActive") == true
            buttonStroke.Color = (active or hovering) and S_HOVER or (normal == S_ACCENT and S_HOVER or S_BORDER)
            buttonStroke.Transparency = active and 0.05 or 0.28
        end
        button.MouseEnter:Connect(function()
            hovering = true
            restoreButton()
        end)
        button.MouseLeave:Connect(function()
            hovering = false
            restoreButton()
        end)
        button.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                pressedState = true
                restoreButton()
                task.delay(0.18, function()
                    pressedState = false
                    restoreButton()
                end)
            end
        end)
        button.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                pressedState = false
                restoreButton()
            end
        end)
        button.Activated:Connect(function()
