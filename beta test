toolButtons["Anchor"].MouseButton1Click:Connect(toggleAnchor)

-- =========================================================
-- Internal HYAZ JSON codec
-- Supports BaseParts and Models containing BaseParts.
-- =========================================================
local function colorToArray(c)
    return {math.floor(c.R*255+.5), math.floor(c.G*255+.5), math.floor(c.B*255+.5)}
end

local function serializePart(p)
    local rx,ry,rz = p.CFrame:ToOrientation()
    return {
        class = p.ClassName,
        name = p.Name,
        position = {p.Position.X,p.Position.Y,p.Position.Z},
        rotation = {math.deg(rx),math.deg(ry),math.deg(rz)},
        size = {p.Size.X,p.Size.Y,p.Size.Z},
        color = colorToArray(p.Color),
        material = p.Material.Name,
        transparency = p.Transparency,
        anchored = p.Anchored,
        canCollide = p.CanCollide,
    }
end

local function collectExportObjects()
    if selected then
        local arr = {}
        if selected:IsA("BasePart") then
            table.insert(arr, serializePart(selected))
        elseif selected:IsA("Model") then
            for _,d in ipairs(selected:GetDescendants()) do
                if d:IsA("BasePart") then table.insert(arr, serializePart(d)) end
            end
        end
        return arr
    end

    local arr = {}
    for _,d in ipairs(workspace:GetDescendants()) do
        local inCharacter = player.Character and d:IsDescendantOf(player.Character)
        if d:IsA("BasePart") and not inCharacter then
            table.insert(arr, serializePart(d))
            if #arr >= 500 then break end
        end
    end
    return arr
end

local function decodePart(data)
    if type(data) ~= "table" then return nil end
    local className = data.class
    if className ~= "Part" and className ~= "WedgePart" and className ~= "CornerWedgePart" and className ~= "TrussPart" then
        className = "Part"
    end
    local p = Instance.new(className)
    p.Name = tostring(data.name or className)

    local pos = data.position or {0,5,0}
    local rot = data.rotation or {0,0,0}
    local size = data.size or {4,1,4}
    local col = data.color or {163,162,165}

    p.Size = Vector3.new(tonumber(size[1]) or 4, tonumber(size[2]) or 1, tonumber(size[3]) or 4)
    p.CFrame = CFrame.new(
        tonumber(pos[1]) or 0,
        tonumber(pos[2]) or 5,
        tonumber(pos[3]) or 0
    ) * CFrame.Angles(
        math.rad(tonumber(rot[1]) or 0),
        math.rad(tonumber(rot[2]) or 0),
        math.rad(tonumber(rot[3]) or 0)
    )

    p.Color = Color3.fromRGB(
        math.clamp(tonumber(col[1]) or 163,0,255),
        math.clamp(tonumber(col[2]) or 162,0,255),
        math.clamp(tonumber(col[3]) or 165,0,255)
    )

    if data.material and Enum.Material[data.material] then p.Material = Enum.Material[data.material] end
    p.Transparency = math.clamp(tonumber(data.transparency) or 0,0,1)
    p.Anchored = data.anchored ~= false
    p.CanCollide = data.canCollide ~= false
    return p
end

