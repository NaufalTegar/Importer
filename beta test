-- MALWARE / BACKDOOR SCANNER
-- ==========================================
local function scanGameForThreats()
    local findings={}
    local suspicious={
        "loadstring", "getfenv", "setfenv", "getgenv", "HttpGet", "HttpGetAsync", "request(", "http_request", "syn.request", "fluxus", "require(", "InsertService", "LoadAsset", "FireServer", "InvokeServer", "TeleportService", "setclipboard", "writefile", "delfile", "makefolder"
    }
    local function inspect(obj)
        local source
        local ok=pcall(function() source=obj.Source end)
        if not ok or type(source)~="string" or source=="" then return end
        local lower=source:lower()
        local hits={}
        for _,needle in ipairs(suspicious) do if lower:find(needle:lower(),1,true) then table.insert(hits,needle) end end
        local longString=source:match("[A-Za-z0-9_/%+%=%-]{80,}")
        if #hits>0 or longString then
            table.insert(findings,{object=obj,path=obj:GetFullName(),hits=hits,obfuscated=longString~=nil})
        end
    end
    local projectRoot=workspace
    local inspected=0
    for _,obj in ipairs(projectRoot:GetDescendants()) do
        if obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript") then inspected+=1; inspect(obj) end
    end
    print("[CoStudio Scanner] Scan completed. Inspected Workspace scripts: "..tostring(inspected))
    if #findings==0 then print("[CoStudio Scanner] No suspicious script patterns detected.") else
        warn("[CoStudio Scanner] Suspicious script findings: "..tostring(#findings))
        for _,finding in ipairs(findings) do warn("[CoStudio Scanner] "..finding.path.." | patterns: "..table.concat(finding.hits,", ")..(finding.obfuscated and " | possible obfuscation" or "")) end
    end
    return findings
end

