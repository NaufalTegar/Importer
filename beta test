        quantumSessions = {}
        pcall(function()
            if listfiles then
                local files = listfiles(PLUTO_SESSIONS_FOLDER)
                for _, f in ipairs(files) do
                    if f:match("%.json$") then
                        local content = readfile(f)
                        if content then
                            local data = HttpService:JSONDecode(content)
                            if type(data) == "table" and data.id ~= nil then
                                if type(data.history) ~= "table" then data.history = {} end
                                table.insert(quantumSessions, data)
                            end
                        end
                    end
                end
            end
        end)
        table.sort(quantumSessions, function(a, b) return tonumber(a.id) > tonumber(b.id) end)
    end
    loadQuantumSessions()

    local function saveQuantumSession(id, title, history)
        pcall(function()
            if writefile then
                local data = {id = id, title = title, history = history}
                writefile(PLUTO_SESSIONS_FOLDER .. "/" .. id .. ".json", HttpService:JSONEncode(data))
            end
        end)
        local found = false
        for _, s in ipairs(quantumSessions) do
            if s.id == id then s.title = title; s.history = history; found = true; break end
        end
        if not found then
            table.insert(quantumSessions, 1, {id = id, title = title, history = history})
            table.sort(quantumSessions, function(a, b) return tonumber(a.id) > tonumber(b.id) end)
        end
    end

    local function deleteQuantumSession(id)
        pcall(function()
            if delfile then delfile(PLUTO_SESSIONS_FOLDER .. "/" .. id .. ".json") end
        end)
        for i, s in ipairs(quantumSessions) do
            if s.id == id then table.remove(quantumSessions, i); break end
        end
    end

    local function parseMarkdownToUI(container, text)
        local order = 0
        local remaining = text

        while true do
            local codeStart = remaining:find("```")
            if not codeStart then
                if #remaining > 0 then
                    order = order + 1
                    local lbl = Instance.new("TextLabel", container)
                    lbl.Text = formatQuantumText(remaining)
                    lbl.RichText = true; lbl.FontFace = Font.fromEnum(Enum.Font.Gotham); lbl.TextSize = 16
                    lbl.TextColor3 = P_TEXT; lbl.BackgroundTransparency = 1
                    lbl.Size = UDim2.new(1, 0, 0, 0); lbl.AutomaticSize = Enum.AutomaticSize.Y
                    lbl.TextWrapped = true; lbl.TextXAlignment = Enum.TextXAlignment.Left
                    lbl.LayoutOrder = order
                end
                break
            end

            local before = remaining:sub(1, codeStart - 1)
            if #before > 0 then
                order = order + 1
                local lbl = Instance.new("TextLabel", container)
                lbl.Text = formatQuantumText(before)
                lbl.RichText = true; lbl.FontFace = Font.fromEnum(Enum.Font.Gotham); lbl.TextSize = 16
                lbl.TextColor3 = P_TEXT; lbl.BackgroundTransparency = 1
                lbl.Size = UDim2.new(1, 0, 0, 0); lbl.AutomaticSize = Enum.AutomaticSize.Y
                lbl.TextWrapped = true; lbl.TextXAlignment = Enum.TextXAlignment.Left
                lbl.LayoutOrder = order
            end

            local rest = remaining:sub(codeStart + 3)
            local langEnd = rest:find("\n")
            if langEnd then
                local ml = rest:sub(1, langEnd - 1):match("^%s*(%w+)%s*$")
                if ml then rest = rest:sub(langEnd + 1) end
            end

            local codeEnd = rest:find("```")
            local codeText = ""
            if codeEnd then
                codeText = rest:sub(1, codeEnd - 1)
                remaining = rest:sub(codeEnd + 3)
            else
                codeText = rest
                remaining = ""
            end
            codeText = safeGsub(safeGsub(codeText, "^[\r\n]+", ""), "[\r\n%s]+$", "")

            order = order + 1
            local lineCount = #codeText:split("\n")
            local scrollH = math.min(math.max(lineCount * 19 + 22, 58), 300)

            local codeOuter = Instance.new("Frame", container)
