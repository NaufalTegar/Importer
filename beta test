    local function selectedTarget()
        local target = getSelectedAdornee()
        if target and target ~= workspace and target ~= game.ReplicatedStorage then return target end
        return nil
    end

    local function partsOf(target)
        local parts = {}
        if target:IsA("BasePart") then table.insert(parts, target) end
        for _, child in ipairs(target:GetDescendants()) do
            if child:IsA("BasePart") then table.insert(parts, child) end
        end
        return parts
    end

    local function applyCommand(target, command)
        local text = command:lower()
        local parts = partsOf(target)
        if #parts == 0 then return false, "The selected object has no editable parts." end
        local color
        if text:find("red", 1, true) then color = Color3.fromRGB(255, 70, 70)
        elseif text:find("blue", 1, true) then color = Color3.fromRGB(70, 130, 255)
        elseif text:find("green", 1, true) then color = Color3.fromRGB(70, 220, 110)
        elseif text:find("yellow", 1, true) then color = Color3.fromRGB(255, 220, 60)
        elseif text:find("purple", 1, true) then color = Color3.fromRGB(170, 80, 255)
        elseif text:find("black", 1, true) then color = Color3.fromRGB(20, 20, 20)
        elseif text:find("white", 1, true) then color = Color3.fromRGB(255, 255, 255) end
        if text:find("color", 1, true) or text:find("colour", 1, true) then
            if not color then return false, "Tell me a color, for example: make it red." end
            for _, part in ipairs(parts) do part.Color = color end
            return true, "Changed the color of " .. tostring(#parts) .. " part(s)."
        elseif text:find("anchor", 1, true) then
            local value = not text:find("unanchor", 1, true)
            for _, part in ipairs(parts) do part.Anchored = value end
            return true, value and "Anchored the selected object." or "Unanchored the selected object."
        elseif text:find("collid", 1, true) then
            local value = not (text:find("no collision", 1, true) or text:find("uncollid", 1, true) or text:find("non%-collid"))
            for _, part in ipairs(parts) do part.CanCollide = value end
            return true, value and "Enabled collision." or "Disabled collision."
        elseif text:find("transparen", 1, true) then
            local value = tonumber(text:match("([0]?%.?%d+)%s*%%?%s*transparen"))
            if not value then return false, "Give me a transparency value from 0 to 1." end
            if value > 1 then value = value / 100 end
            value = math.clamp(value, 0, 1)
            for _, part in ipairs(parts) do part.Transparency = value end
            return true, "Set transparency to " .. tostring(value) .. "."
        elseif text:find("material", 1, true) then
            local names = {plastic="Plastic", neon="Neon", glass="Glass", wood="Wood", metal="Metal", concrete="Concrete", brick="Brick"}
            local selected
            for word, name in pairs(names) do if text:find(word, 1, true) then selected = name break end end
            if not selected or not Enum.Material[selected] then return false, "Tell me a material such as Neon, Glass, Metal, or Wood." end
            for _, part in ipairs(parts) do part.Material = Enum.Material[selected] end
            return true, "Changed the material to " .. selected .. "."
        elseif text:find("rename", 1, true) then
            local newName = command:match("[Rr]ename.-[Tt]o%s+(.+)") or command:match("[Cc]all it%s+(.+)")
            if not newName or newName == "" then return false, "Use: rename it to NewName." end
            target.Name = safeTrim(newName)
            return true, "Renamed it to " .. target.Name .. "."
        end
        return false, "I can currently edit color, material, anchor, collision, transparency, and name."
    end

    local function applyAIPlan(target, plan)
        if type(plan) ~= "table" then return false, "Quantum returned an invalid edit plan." end
        local actions = plan.actions or plan
        if type(actions) ~= "table" then return false, "Quantum returned no edit actions." end
        local parts = partsOf(target)
        local function parseColor(value)
            if type(value) == "table" then
                return Color3.fromRGB(tonumber(value.r or value[1]) or 255, tonumber(value.g or value[2]) or 255, tonumber(value.b or value[3]) or 255)
            end
            local colors = {red=Color3.fromRGB(255,70,70), blue=Color3.fromRGB(70,130,255), green=Color3.fromRGB(70,220,110), yellow=Color3.fromRGB(255,220,60), purple=Color3.fromRGB(170,80,255), black=Color3.fromRGB(20,20,20), white=Color3.fromRGB(255,255,255), orange=Color3.fromRGB(255,140,40)}
            return colors[tostring(value):lower()]
        end
        local changed = 0
        for _, action in ipairs(actions) do
            if type(action) == "table" then
                local kind = tostring(action.type or "set"):lower()
                local property = tostring(action.property or action.name or "")
                local value = action.value
                if kind == "createpart" or kind == "create" or kind == "createbuilding" then
                    local part=Instance.new("Part")
                    part.Name=tostring(action.name or "QuantumPart")
                    local shapeName=tostring(action.shape or "Block"):lower()
                    part.Shape=shapeName=="ball" and Enum.PartType.Ball or (shapeName=="cylinder" and Enum.PartType.Cylinder or Enum.PartType.Block)
                    local size=action.size or {x=4,y=4,z=4}
                    part.Size=Vector3.new(tonumber(size.x or size[1]) or 4,tonumber(size.y or size[2]) or 4,tonumber(size.z or size[3]) or 4)
                    local position=action.position or {x=0,y=3,z=0}
                    part.Position=Vector3.new(tonumber(position.x or position[1]) or 0,tonumber(position.y or position[2]) or 3,tonumber(position.z or position[3]) or 0)
                    local createdColor=parseColor(action.color or "white"); if createdColor then part.Color=createdColor end
                    local materialName=tostring(action.material or "Plastic"); if Enum.Material[materialName] then part.Material=Enum.Material[materialName] end
                    part.Anchored=action.anchored ~= false
                    part.Parent=workspace
                    changed+=1
                elseif kind == "insertasset" and tonumber(action.assetId or action.id) then
                    local ok=pcall(function() insertModelAsset(tonumber(action.assetId or action.id)) end)
                    if ok then changed+=1 end
                elseif kind == "rename" or property:lower() == "name" then
                    if value and tostring(value) ~= "" then target.Name = tostring(value); changed += 1 end
                elseif kind == "set" or kind == "edit" then
                    local lower = property:lower()
                    if lower == "color" or lower == "colour" then
                        local c = parseColor(value)
                        if c then for _, part in ipairs(parts) do part.Color = c; changed += 1 end end
                    elseif lower == "material" and Enum.Material[tostring(value)] then
                        for _, part in ipairs(parts) do part.Material = Enum.Material[tostring(value)]; changed += 1 end
                    elseif lower == "anchored" or lower == "cancollide" or lower == "cantouch" or lower == "canquery" then
                        local bool = value == true or tostring(value):lower() == "true"
                        for _, part in ipairs(parts) do pcall(function() part[property] = bool; changed += 1 end) end
                    elseif lower == "transparency" or lower == "reflectance" then
                        local number = math.clamp(tonumber(value) or 0, 0, 1)
                        for _, part in ipairs(parts) do pcall(function() part[property] = number; changed += 1 end) end
                    elseif lower == "size" and type(value) == "table" then
                        local v = Vector3.new(tonumber(value.x or value[1]) or 1, tonumber(value.y or value[2]) or 1, tonumber(value.z or value[3]) or 1)
                        if target:IsA("BasePart") then target.Size = v; changed += 1 end
                    elseif lower == "position" and type(value) == "table" then
                        local v = Vector3.new(tonumber(value.x or value[1]) or 0, tonumber(value.y or value[2]) or 0, tonumber(value.z or value[3]) or 0)
                        if target:IsA("BasePart") then target.Position = v; changed += 1 end
                    end
                end
            end
        end
        return changed > 0, changed > 0 and ("Quantum applied " .. tostring(changed) .. " change(s).") or "Quantum did not return a supported change."
    end

    local function askQuantumForPlan(target, command)
        local body = {
            model = "google/gemma-4-26b-a4b-it:free",
            temperature = 0.1,
            max_tokens = 1200,
            stream = false,
            messages = {
                {role="system", content="You are Quantum Copilot for Roblox Studio Lite. Convert the user's request into JSON only. You can edit the selected target and create safe procedural Roblox parts in Workspace. Allowed actions: {type:'rename',value:'NewName'}, {type:'set',property:'Color|Material|Anchored|CanCollide|CanTouch|CanQuery|Transparency|Reflectance|Size|Position',value:...}, {type:'createPart|createBuilding',name,shape:'Block|Ball|Cylinder',size:{x,y,z},position:{x,y,z},color,material,anchored}, or {type:'insertAsset',assetId:number}. For multiple buildings, return many create actions with detailed parts, varied sizes, colors, and materials. Never return Lua, explanations, deletes, scripts, remotes, or game-wide changes. Color may be a name or {r,g,b}; vector values must be {x,y,z}; booleans must be true/false. Return {actions:[...]}."},
                {role="user", content=command .. "\nSelected target: " .. target:GetFullName()}
            },
            provider = {order={"Google AI Studio"}, allow_fallbacks=true}
        }
        local encoded = HttpService:JSONEncode(body)
        local candidates = getHttpRequests()
        for _, candidate in ipairs(candidates) do
            local ok, result = callHttpCandidate(candidate, {Url="https://openrouter.ai/api/v1/chat/completions", Method="POST", Headers={Accept="application/json", ["Content-Type"]="application/json", Authorization="Bearer " .. OPENROUTER_API_KEY, ["HTTP-Referer"]="https://openrouter.ai", ["X-Title"]="CoStudio Quantum Copilot"}, Body=encoded}, 45)
            if ok and result then
                local raw = type(result) == "table" and (result.Body or result.body or result.ResponseBody or result.responseBody) or result
                local decodeOk, decoded = pcall(function() return type(raw)=="table" and raw or HttpService:JSONDecode(raw) end)
                if decodeOk and type(decoded)=="table" then
                    local content = decoded.choices and decoded.choices[1] and decoded.choices[1].message and decoded.choices[1].message.content
                    if type(content)=="string" then
                        content = safeGsub(safeGsub(safeGsub(content, "^```json%s*", ""), "^```%s*", ""), "%s*```$", "")
                        local planOk, plan = pcall(function() return HttpService:JSONDecode(content) end)
                        if planOk then return true, plan end
                    end
                end
            end
        end
        return false, "Quantum could not reach its AI provider."
    end

    local function submit()
        local command = tostring(input.Text or "")
        local commandLower=command:lower()
        local canCreate=commandLower:find("create",1,true) or commandLower:find("build",1,true) or commandLower:find("make",1,true) or commandLower:find("add",1,true) or commandLower:find("insert",1,true)
        local target = selectedTarget()
        if not target and not canCreate then status.Text = "Select a part or model first."; return end
        target = target or workspace
        command = safeTrim(command)
        if command == "" then return end
        status.Text = "Quantum is thinking..."
        task.spawn(function()
            local aiOk, plan = askQuantumForPlan(target, command)
            if aiOk then
                local applied, message = applyAIPlan(target, plan)
                status.Text = (applied and "✓ " or "! ") .. message
                if applied then input.Text = "" end
            else
                local localOk, localMessage = applyCommand(target, command)
                status.Text = (localOk and "✓ " or "! ") .. (localOk and localMessage or tostring(plan))
                if localOk then input.Text = "" end
            end
        end)
    end
    input.FocusLost:Connect(function(enterPressed) if enterPressed then submit() end end)

    launcher.Activated:Connect(function() panel.Visible = not panel.Visible end)
    task.spawn(function()
        local lastTarget
        while gui.Parent do
            local target = selectedTarget()
            if target ~= lastTarget then
                lastTarget = target
                targetLabel.Text = target and ("Target: " .. target:GetFullName()) or "Target: nothing selected"
                if target then status.Text = "Ask Quantum what to change." end
            end
            task.wait(0.35)
        end
    end)
    return true
