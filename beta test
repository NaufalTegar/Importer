    progressBg.BackgroundColor3 = Color3.fromRGB(25, 32, 52)
    progressBg.BorderSizePixel = 0
    progressBg.Parent = bg
    hyazCorner(progressBg, 99)
    local progress = Instance.new("Frame")
    progress.Size = UDim2.new(0, 0, 1, 0)
    progress.BackgroundColor3 = Color3.fromRGB(50, 132, 255)
    progress.BorderSizePixel = 0
    progress.Parent = progressBg
    hyazCorner(progress, 99)
    local pGrad = Instance.new("UIGradient")
    pGrad.Color = ColorSequence.new(Color3.fromRGB(50, 132, 255), Color3.fromRGB(157, 82, 255))
    pGrad.Parent = progress

    local status = Instance.new("TextLabel")
    status.AnchorPoint = Vector2.new(0.5, 0)
    status.Position = UDim2.new(0.5, 0, 0.5, 128)
    status.Size = UDim2.new(0.9, 0, 0, 22)
    status.BackgroundTransparency = 1
    status.Text = "INITIALIZING CORE"
    status.TextColor3 = Color3.fromRGB(136, 151, 178)
    status.TextSize = 10
    status.FontFace = Font.fromEnum(Enum.Font.GothamMedium)
    status.Parent = bg

    local spinConnection
    spinConnection = RS.RenderStepped:Connect(function(dt)
        if not halo.Parent then
            if spinConnection then spinConnection:Disconnect() end
            return
        end
        orbit.Rotation = (orbit.Rotation + dt * 85) % 360
        diamond.Rotation = (diamond.Rotation - dt * 22) % 360
        h.Rotation = -diamond.Rotation
    end)

    local finalTitle = "HYAZ X VYZEN"
    local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#$%&"
    for reveal = 0, #finalTitle do
        local out = {}
        for i = 1, #finalTitle do
            local ch = finalTitle:sub(i, i)
            if ch == " " or ch == "X" then
                out[i] = ch
            elseif i <= reveal then
                out[i] = ch
            else
                local idx = math.random(1, #chars)
                out[i] = chars:sub(idx, idx)
            end
        end
        title.Text = table.concat(out)
        task.wait(0.045)
    end
    title.Text = finalTitle

    local stages = {
        "MOUNTING STUDIO LITE BRIDGE",
        "SYNCING CREATIVE MODULES",
        "BUILDING HYAZ X VYZEN INTERFACE",
        "CORE READY",
    }
    for i, text in ipairs(stages) do
        status.Text = text
        TS:Create(progress, TweenInfo.new(0.34, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.new(i / #stages, 0, 1, 0)}):Play()
        task.wait(0.36)
    end
    task.wait(0.18)

    local fadeTime = 0.35
    for _, obj in ipairs(bg:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            TS:Create(obj, TweenInfo.new(fadeTime), {TextTransparency = 1, BackgroundTransparency = 1}):Play()
        elseif obj:IsA("Frame") then
            TS:Create(obj, TweenInfo.new(fadeTime), {BackgroundTransparency = 1}):Play()
        elseif obj:IsA("UIStroke") then
            TS:Create(obj, TweenInfo.new(fadeTime), {Transparency = 1}):Play()
        end
    end
    TS:Create(bg, TweenInfo.new(fadeTime), {BackgroundTransparency = 1}):Play()
    task.wait(fadeTime + 0.05)
    if spinConnection then spinConnection:Disconnect() end
    gui:Destroy()
    if type(onComplete) == "function" then
        local ok, err = pcall(onComplete)
        if not ok then warn("[HYAZ X VYZEN] launch error: " .. tostring(err)) end
    end
end


local function LaunchCoStudio()
    -- Remove an older CoStudio window when the updated script is rerun so the
    -- user cannot accidentally interact with a stale UI/configuration.
    for _, gui in ipairs(CoreGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Name ~= "CoStudioSetup" and gui.Name ~= "QuantumAI_UI" then
            local oldRoot = gui:FindFirstChild("CoStudio")
            if oldRoot and oldRoot:IsA("Frame") then
                gui:Destroy()
            end
        end
    end

    -- Native HYAZ X VYZEN UI. Existing feature callbacks below remain unchanged.
    local Rayfield = HYAZUI
    local appliedTheme = globalState.theme or "HYAZ X VYZEN"

    local Window = Rayfield:CreateWindow({
        name = BRAND_NAME,
        subtitle = BRAND_SUBTITLE .. " • V" .. SCRIPT_VERSION,
        showName = BRAND_NAME,
        theme = appliedTheme,
    })

    -- TAB 1: MODEL INSERTER
    local TabInserter = Window:CreateTab({ name = "Model Inserter", icon = 7733674079 })
    createCoStudioNotice(TabInserter, "Hello users, as you can see there's a new model searcher tab and it searches right from the roblox creator store, if you're still using the legacy insert (which is basically insert by ID) please note that you can also insert right from the model searcher which is more simpler, also model searcher might be a LITTLE buggy due to its first release but we'll continue to improve it more.")
    local modelIdToInsert = ""
    TabInserter:CreateInput({
        name = "Model ID",
        placeholder = "Asset ID (e.g. 115182995329665)",
        numeric = true,
        clearOnFocus = false,
        callback = function(text) modelIdToInsert = text end,
    })

    TabInserter:CreateButton({
        name = "Insert Model",
        callback = function()
            local requestedId = modelIdToInsert
            if not tonumber(requestedId) then
                Window:Notify({title = "Failed", content = "Please enter a valid Asset ID."})
                return
            end
            Window:Notify({title = "Inserting", content = "Loading the model without freezing the UI..."})
            task.spawn(function()
                local ok, message = insertModelAsset(requestedId)
                Window:Notify({title = ok and "Success" or "Failed", content = message})
            end)
        end
    })

    TabInserter:CreateButton({
        name = "Open Model Store",
        callback = function()
            openModelStore(Window)
        end
    })

    -- TAB 2: TOOLS
    local TabTools = Window:CreateTab({ name = "Plugins", icon = 7734068321 })
    local GTools = TabTools:CreateGroup({ direction = "column" })
    GTools:CreateButton({ name = "F3X Building Tool", callback = loadF3X })
    GTools:CreateButton({
        name = "GamePlanner",
        description = "Quantum-powered game concepts, gameplay loops, progression, and update ideas.",
        callback = function()
            openGamePlanner()
        end
    })
    GTools:CreateButton({
        name = "Lighting Presets",
        description = "Search and apply 129 lighting packs (horror, cyberpunk, neon, warm, fantasy, space, cinematic, and more). Includes an AI custom-lighting input.",
        callback = function()
            openLightingPresets()
        end
    })
    GTools:CreateButton({
        name = "Advanced Parts Library",
        description = "Spawn 55+ parts: primitives, architecture, meshes, 18 materials, and special (spawn, seats, half pipe, flag pole).",
        callback = function()
            openPartsLibrary(Window)
        end
    })
    GTools:CreateButton({
        name = "Scanner",
        description = "Scan scripts and models for suspicious loaders, backdoors, remotes, and obfuscation.",
        callback = function()
            Window:Notify({title="Scanner", content="Scanning the game. Results will be logged to Output."})
            task.spawn(scanGameForThreats)
        end
    })
    GTools:CreateButton({
        name = "Quantum Copilot",
        description = "Toggle a small </> assistant for editing the selected part or model.",
        callback = function()
            createQuantumCopilot()
        end
    })
    GTools:CreateButton({
        name = "Model Ungrouper",
        callback = function()
            local ok, message = pcall(function()
                loadstring(game:HttpGet("https://rawscripts.net/raw/Studio-Lite-Model-Ungrouper-39922"))()
            end)
            Window:Notify({title = ok and "Model Ungrouper" or "Plugin Failed", content = ok and "Model Ungrouper executed." or tostring(message)})
        end
    })
    GTools:CreateButton({ 
        name = "Anchor Model",
        description = "Select a model from Workspace first.",
        callback = function()
            local ok, count, state = toggleSelectedParts("Anchored", "SL_Anchored")
            if not ok then
                Window:Notify({title="Notice", content=state})
                return
            end
            Window:Notify({title="Anchor Toggled", content=(state and "Anchored " or "Unanchored ") .. count .. " parts."})
        end 
    })
    GTools:CreateButton({ 
        name = "Collide Model",
        description = "Select a model from Workspace first.",
        callback = function()
            local ok, count, state = toggleSelectedParts("CanCollide", "SL_CanCollide")
            if not ok then
                Window:Notify({title="Notice", content=state})
                return
            end
            Window:Notify({title="Collision Toggled", content=(state and "Collided " or "Uncollided ") .. count .. " parts."})
        end 
    })

    -- TAB 3: PLUTO AI
    local TabAI = Window:CreateTab({ name = "Ask AI", icon = 7733911828 })
    TabAI:CreateSection({ name = "Quantum AI Engine" })
    TabAI:CreateButton({
        name = "Open Quantum AI",
        callback = function()
            openQuantumAI()
        end
    })

    -- TAB 4: SETTINGS
    local TabSettings = Window:CreateTab({ name = "Settings", icon = 7733964719 })
    local GSettings = TabSettings:CreateGroup({ direction = "column" })
    GSettings:CreateDropdown({
        name = "Visual Core",
        description = "Switch the HYAZ X VYZEN interface palette without restarting.",
        options = {"HYAZ X VYZEN", "HYAZ Midnight", "HYAZ Crimson", "HYAZ Ice"},
        value = { globalState.theme or "HYAZ X VYZEN" },
        callback = function(opts)
            local s = type(opts) == "table" and opts[1] or opts
            if not s then return end
            globalState.theme = s
            saveGlobalState()
            Window:ChangeTheme(s)
        end
    })

    -- TAB 5: ABOUT
    local TabAbout = Window:CreateTab({
        name = "About",
        -- Explicit thumbnail URI keeps the information icon visible in Gen2.
        icon = "rbxthumb://type=Asset&id=7733771369&w=150&h=150",
    })
    TabAbout:CreateSection({ name = "HYAZ X VYZEN • Studio Core" })
    local GAbout = TabAbout:CreateGroup({ direction = "column" })
    GAbout:CreateButton({ name = "HYAZ X VYZEN • Revolution Interface", description = "New visual shell, loading sequence, navigation system, and interaction layer.", callback = function() end })
    GAbout:CreateButton({ name = "Foundation: CoStudio V6 / Allvideo", callback = function() end })
    GAbout:CreateButton({ name = "Continuation contributors: Vince & Halo Team", callback = function() end })
    GAbout:CreateButton({ name = "Quantum systems: original CoStudio contributor", callback = function() end })

    Window:Notify({
        title = "HYAZ X VYZEN READY",
        content = "Studio Core is online. Existing CoStudio feature logic is running behind the new interface.",
        duration = 4,
    })
    
end

