        AudioTime.Text = "0:00 / 0:00"
        StorePageBtn.Text = "+  Insert"
    end

    local function setAudioSeekFromX(x)
        if not seekingAudio or PreviewSound.TimeLength <= 0 then return end
        local left = SeekTrack.AbsolutePosition.X
        local width = math.max(1, SeekTrack.AbsoluteSize.X)
        local ratio = math.clamp((x - left) / width, 0, 1)
        PreviewSound.TimePosition = PreviewSound.TimeLength * ratio
        updateAudioProgress()
    end

    SeekTrack.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            seekingAudio = true
            setAudioSeekFromX(input.Position.X)
        end
    end)
    SeekTrack.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then seekingAudio = false end
    end)
    UIS.InputChanged:Connect(function(input)
        if seekingAudio and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            setAudioSeekFromX(input.Position.X)
        end
    end)
    PreviewSound.Loaded:Connect(updateAudioProgress)
    PreviewSound.Ended:Connect(function()
        StorePageBtn.Text = "Play Audio"
