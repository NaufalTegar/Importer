local function isExplorerObject(o)
    return o:IsA("Model") or o:IsA("BasePart") or o:IsA("Folder")
end

local function refreshExplorer()
    clearChildren(exScroll)
    local filter = string.lower(exSearch.Text or "")

    local workspaceRow = button(exScroll, "▼ Workspace", 230)
    workspaceRow.TextXAlignment = Enum.TextXAlignment.Left

    local count = 0
    for _,o in ipairs(workspace:GetChildren()) do
        if isExplorerObject(o) then
            local n = string.lower(o.Name)
            if filter == "" or string.find(n, filter, 1, true) then
                count += 1
                local row = button(exScroll, "   "..o.Name, 230)
                row.TextXAlignment = Enum.TextXAlignment.Left
                if o:IsA("BasePart") then
                    row.MouseButton1Click:Connect(function()
                        setSelected(o)
                    end)
                end
            end
        end
        if count >= 100 then break end
    end
end

