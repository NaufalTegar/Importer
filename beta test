            local p = window._palette
            self._page.ScrollBarImageColor3 = p.accent
            self._nav.BackgroundColor3 = p.surface2
            self._nav.BackgroundTransparency = active and 0.18 or 1
            self._indicator.BackgroundTransparency = active and 0 or 1
            self._glyph.TextColor3 = active and p.accent or p.muted
            self._text.TextColor3 = active and p.text or p.muted
        end

        local function selectTab()
            if window._activeTab == tab then return end
            if window._activeTab then
                window._activeTab._page.Visible = false
                window._activeTab:_refresh(false)
            end
            window._activeTab = tab
            page.Visible = true
            tab:_refresh(true)
            headerTitle.Text = tab._name
            headerEyebrow.Text = "HYAZ X VYZEN / " .. string.upper(tab._name)
        end
        navButton.Activated:Connect(selectTab)
        navButton.MouseEnter:Connect(function()
            if window._activeTab ~= tab then
                TS:Create(navButton, TweenInfo.new(0.12), {BackgroundTransparency = 0.55}):Play()
            end
        end)
        navButton.MouseLeave:Connect(function()
            if window._activeTab ~= tab then
                TS:Create(navButton, TweenInfo.new(0.12), {BackgroundTransparency = 1}):Play()
            end
        end)
        table.insert(window._tabs, tab)
        if not window._activeTab then selectTab() else tab:_refresh(false) end
        return tab
    end

    return window
end

