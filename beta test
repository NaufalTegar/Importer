refreshProperties = function()
    clearChildren(propScroll)
    if not selected then
        local none = textLabel(propScroll, "Select a BasePart in the world.", 12, false)
        none.TextColor3 = T.dim
        none.Size = UDim2.new(1,0,0,34)
        return
    end

    makePropRow("Name", selected.Name, function(v)
        if v ~= "" then selected.Name = v; selectionPill.Text = selected:GetFullName() end
    end)

    makePropRow("Position", vec3ToString(selected.Position), function(v)
        local n = parseVec3(v)
        if n then selected.Position = n else notify("Format Position: x, y, z","warn") end
    end)

    local rx,ry,rz = selected.CFrame:ToOrientation()
    makePropRow("Rotation", vec3ToString(Vector3.new(math.deg(rx),math.deg(ry),math.deg(rz))), function(v)
        local n = parseVec3(v)
        if n then
            selected.CFrame = CFrame.new(selected.Position) * CFrame.Angles(math.rad(n.X),math.rad(n.Y),math.rad(n.Z))
        else
            notify("Format Rotation: x, y, z","warn")
        end
    end)

    makePropRow("Size", vec3ToString(selected.Size), function(v)
        local n = parseVec3(v)
        if n and n.X > 0 and n.Y > 0 and n.Z > 0 then selected.Size = n else notify("Size tidak valid","warn") end
    end)

    makePropRow("Transparency", tostring(selected.Transparency), function(v)
        local n = tonumber(v)
        if n then selected.Transparency = math.clamp(n,0,1) end
    end)

    makePropRow("Anchored", tostring(selected.Anchored), function(v)
        local b = string.lower(v) == "true" or v == "1" or string.lower(v) == "yes"
        selected.Anchored = b
    end)

    makePropRow("CanCollide", tostring(selected.CanCollide), function(v)
        local b = string.lower(v) == "true" or v == "1" or string.lower(v) == "yes"
        selected.CanCollide = b
    end)

    makePropRow("Material", selected.Material.Name, function(v)
        local ok,mat = pcall(function() return Enum.Material[v] end)
        if ok and mat then selected.Material = mat else notify("Material tidak ditemukan","warn") end
    end)
end
refreshProperties()

