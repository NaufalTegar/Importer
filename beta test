    defaultScreenGui:SetAttribute("CoStudioQuantumGenerated", true)
    local rootsWithScreen=roots
    rootsWithScreen.ScreenGui=defaultScreenGui
    local createdFolders={}
    local function resolveRoot(value)
        local key=tostring(value or "")
        if key=="StarterGui" or key=="StarterPlayerScripts" or key=="ServerScriptService" or key=="ReplicatedStorage" or key=="StarterPlayer" then return roots[key] or roots.StarterGui end
        return nil
    end
    for _,folderSpec in ipairs(plan.folders or {}) do
        local parent=createdFolders[tostring(folderSpec.parent or "")] or resolveRoot(folderSpec.parent) or resolveRoot(folderSpec.root) or roots.StarterGui
        local folderName=tostring(folderSpec.name or "QuantumFolder")
        local folder=parent:FindFirstChild(folderName)
        if not folder or not folder:IsA("Folder") then if folder then folder:Destroy() end; folder=Instance.new("Folder"); folder.Name=folderName; folder.Parent=parent end
        createdFolders[folderName]=folder
    end
    for _,remoteSpec in ipairs(plan.remotes or {}) do
        local className=tostring(remoteSpec.className or "RemoteEvent")
        local allowed={RemoteEvent=true,RemoteFunction=true,BindableEvent=true,BindableFunction=true}
        if allowed[className] then
            local parent=createdFolders[tostring(remoteSpec.parent or "")] or resolveRoot(remoteSpec.parent) or resolveRoot(remoteSpec.root) or roots.ReplicatedStorage
            local remoteName=tostring(remoteSpec.name or "QuantumRemote")
            local remote=parent:FindFirstChild(remoteName)
            if not remote or remote.ClassName~=className then if remote then remote:Destroy() end; remote=Instance.new(className); remote.Name=remoteName; remote.Parent=parent end
        end
    end
    local template=game:GetService("ReplicatedStorage"):FindFirstChild("StudioLiteFolder") and game.ReplicatedStorage.StudioLiteFolder:FindFirstChild("RigEditScriptFolder",true) and game.ReplicatedStorage.StudioLiteFolder.RigEditScriptFolder:FindFirstChild("DanceScript",true) and game.ReplicatedStorage.StudioLiteFolder.RigEditScriptFolder.DanceScript:FindFirstChild("SL_CodeTextBox")
    local inserted=0
    for _,file in ipairs(plan.files) do
        local className=(file.className=="Script" and "Script") or (file.className=="ModuleScript" and "ModuleScript") or "LocalScript"
        local parent=createdFolders[tostring(file.parent or "")] or resolveRoot(file.parent) or rootsWithScreen[tostring(file.target or "StarterGui")] or defaultScreenGui
        local scriptName=tostring(file.name or "QuantumGeneratedScript")
        local scriptObj=parent:FindFirstChild(scriptName)
        if not scriptObj or scriptObj.ClassName~=className then if scriptObj then scriptObj:Destroy() end; scriptObj=Instance.new(className); scriptObj.Name=scriptName; scriptObj.Parent=parent end
        local sourceText=safeString(file.source)
        sourceText=safeGsub(sourceText, "^```lua%s*", "")
        sourceText=safeGsub(sourceText, "^```luau%s*", "")
        sourceText=safeGsub(sourceText, "^```%s*", "")
        sourceText=safeGsub(sourceText, "%s*```$", "")
        local code=scriptObj:FindFirstChild("SL_CodeTextBox")
        if template then
            if not code then code=template:Clone(); code.Name="SL_CodeTextBox"; code.Parent=scriptObj end
            code.Text=sourceText
        else
            pcall(function() scriptObj.Source=sourceText end)
        end
        inserted+=1
    end
    return true,"Uploaded "..tostring(inserted).." Quantum source file(s) and "..tostring(#(plan.remotes or {})).." remote(s) to the existing Studio Lite hierarchy."
end

local function formatQuantumText(text)
    text=tostring(text or "")
    text=safeGsub(text, "####%s+([^\n]+)", '<font size="14"><b>%1</b></font>')
    text=safeGsub(text, "###%s+([^\n]+)", '<font size="16"><b>%1</b></font>')
    text=safeGsub(text, "##%s+([^\n]+)", '<font size="18"><b>%1</b></font>')
    text=safeGsub(text, "#%s+([^\n]+)", '<font size="21"><b>%1</b></font>')
    text=safeGsub(text, "%*%*(.-)%*%*", "<b>%1</b>")
    text=safeGsub(text, "%*(.-)%*", "<i>%1</i>")
    return text
end


