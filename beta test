local function getHttpRequests()
    local candidates = {}
    local function addCandidate(name, callback)
        if type(callback) == "function" then
            table.insert(candidates, {name = name, call = callback})
        end
    end

    local httpEnabled = false
    pcall(function() httpEnabled = HttpService.HttpEnabled == true end)
    if httpEnabled then
        addCandidate("Roblox HttpService", function(options)
            return HttpService:RequestAsync(options)
        end)
    end

    if syn and type(syn.request) == "function" then
        addCandidate("syn.request", syn.request)
    end
    if type(http_request) == "function" then
        addCandidate("http_request", http_request)
        addCandidate("http_request(url, options)", function(options)
            return http_request(options.Url, {
                Method = options.Method,
                Headers = options.Headers,
                Body = options.Body,
            })
        end)
    end
    if type(request) == "function" then
        addCandidate("request", request)
        addCandidate("request(url, options)", function(options)
            return request(options.Url, {
                Method = options.Method,
                Headers = options.Headers,
                Body = options.Body,
            })
        end)
    end
    if http and type(http.request) == "function" then
        addCandidate("http.request", http.request)
        addCandidate("http.request(url, options)", function(options)
            return http.request(options.Url, {
                method = options.Method,
                headers = options.Headers,
                body = options.Body,
            })
        end)
    end
    if fluxus and type(fluxus.request) == "function" then
        addCandidate("fluxus.request", fluxus.request)
    end

    -- Keep HttpService as a final fallback even when HttpEnabled was not
    -- readable; RequestAsync will return its own useful error if unavailable.
    if HttpService.RequestAsync then
        addCandidate("Roblox HttpService fallback", function(options)
            return HttpService:RequestAsync(options)
        end)
    end
    return candidates
end

local function callHttpCandidate(candidate, options, timeoutSeconds)
    local done, callOk, callResult = false, false, nil
    local requestThread = task.spawn(function()
        callOk, callResult = pcall(candidate.call, options)
        done = true
    end)
    local started = os.clock()
    while not done and os.clock() - started < (timeoutSeconds or 30) do
        task.wait()
    end
    if not done then
        pcall(function() task.cancel(requestThread) end)
        return false, "timed out"
    end
    return callOk and callResult ~= nil, callOk and callResult or callResult
end

local function requestJson(url, method, body, timeoutSeconds)
    local candidates = getHttpRequests()
    if #candidates == 0 then return nil, "no HTTP request function available" end
    local options = {
        Url = url,
        Method = method or "GET",
        Headers = {
            ["Accept"] = "application/json",
            ["Content-Type"] = "application/json",
        },
        Body = body,
    }
    local lowerOptions = {
        url = options.Url,
        method = options.Method,
        headers = options.Headers,
        body = options.Body,
    }
    local lastError = "unknown HTTP error"
    for _, candidate in ipairs(candidates) do
        local ok, result = callHttpCandidate(candidate, options, timeoutSeconds)
        if ok then
            local status = type(result) == "table" and tonumber(result.StatusCode or result.statusCode or result.status_code) or 0
            local raw = type(result) == "table" and (result.Body or result.body or result.ResponseBody or result.responseBody or result.response_body) or result
            if status >= 400 then
                lastError = candidate.name .. " HTTP " .. tostring(status) .. ": " .. tostring(raw or "")
            elseif raw and raw ~= "" then
                local decodeOk, decoded = pcall(function()
                    return type(raw) == "table" and raw or HttpService:JSONDecode(raw)
                end)
                if decodeOk and type(decoded) == "table" then return decoded end
                lastError = candidate.name .. ": invalid JSON response"
            else
                lastError = candidate.name .. ": empty response"
            end
        else
            lastError = candidate.name .. ": " .. tostring(result)
        end
        local lowerOk, lowerResult = callHttpCandidate(candidate, lowerOptions, timeoutSeconds)
        if lowerOk then
            local status = type(lowerResult) == "table" and tonumber(lowerResult.StatusCode or lowerResult.statusCode or lowerResult.status_code) or 0
            local raw = type(lowerResult) == "table" and (lowerResult.Body or lowerResult.body or lowerResult.ResponseBody or lowerResult.responseBody or lowerResult.response_body) or lowerResult
            if status < 400 and raw and raw ~= "" then
                local decodeOk, decoded = pcall(function()
                    return type(raw) == "table" and raw or HttpService:JSONDecode(raw)
                end)
                if decodeOk and type(decoded) == "table" then return decoded end
            end
            lastError = candidate.name .. ": invalid/failed lowercase response"
        else
            lastError = candidate.name .. ": " .. tostring(lowerResult)
        end
    end
    return nil, lastError
end

