-- responsive
local function refreshLayout()
    local cam = workspace.CurrentCamera
    if not cam then return end

    local w = cam.ViewportSize.X
    if w < 820 then
        explorer.Size = UDim2.new(0, 180, 1, -116)
        props.Size = UDim2.new(0, 190, 1, -116)
        viewport.Position = UDim2.fromOffset(188, 108)
        viewport.Size = UDim2.new(1, -386, 1, -116)
        tabHolder.Visible = false
        beta.Visible = false
    else
        explorer.Size = UDim2.new(0, 250, 1, -116)
        props.Size = UDim2.new(0, 270, 1, -116)
        viewport.Position = UDim2.fromOffset(266, 108)
        viewport.Size = UDim2.new(1, -552, 1, -116)
        tabHolder.Visible = true
        beta.Visible = true
    end
end

if workspace.CurrentCamera then
    workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(refreshLayout)
end

