        duration = math.clamp(tonumber(duration) or 0.07, 0.03, 0.18)
        task.spawn(function()
            pcall(function()
                local inputType = Enum.UserInputType.Gamepad1
                if not HapticService:IsVibrationSupported(inputType) then return end
                if HapticService:IsMotorSupported(inputType, Enum.VibrationMotor.Small) then
                    HapticService:SetMotor(inputType, Enum.VibrationMotor.Small, strength)
                end
                if HapticService:IsMotorSupported(inputType, Enum.VibrationMotor.Large) then
                    HapticService:SetMotor(inputType, Enum.VibrationMotor.Large, strength * 0.35)
                end
                task.wait(duration)
                if HapticService:IsMotorSupported(inputType, Enum.VibrationMotor.Small) then
                    HapticService:SetMotor(inputType, Enum.VibrationMotor.Small, 0)
                end
                if HapticService:IsMotorSupported(inputType, Enum.VibrationMotor.Large) then
