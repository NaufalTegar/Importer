    local function renderAssets(assets, reset)
        renderSerial = renderSerial + 1
        local thisRender = renderSerial
        if reset then clearResults() end
        LoadMoreBtn.Visible = false
        local startIndex = reset and 1 or (#currentResults - #assets + 1)
        if not reset then startIndex = #currentResults - #assets + 1 end
        local cursor = startIndex
        local function renderBatch()
            if thisRender ~= renderSerial then return end
            local batchEnd = math.min(cursor + 4, #currentResults)
            while cursor <= batchEnd do
                makeResultCard(currentResults[cursor], cursor)
                cursor = cursor + 1
            end
            if cursor <= #currentResults then
                task.defer(renderBatch)
            else
                LoadMoreBtn.Active = nextPageCursor ~= nil
                LoadMoreBtn.Visible = nextPageCursor ~= nil
            end
        end
        task.defer(renderBatch)
    end

    local function buildDetailUrl(ids)
        return "https://apis.roblox.com/toolbox-service/v1/items/details?assetIds=" .. table.concat(ids, ",")
    end

    local function fetchStorePage(query, cursor, isHome, append)
        local encoded = query == "" and "" or HttpService:UrlEncode(query)
        local searchUrl = "https://apis.roblox.com/toolbox-service/v1/marketplace/" .. tostring(selectedAssetType.id) .. "?limit=30&pageNumber=0&keyword=" .. encoded
        if cursor and cursor ~= "" then searchUrl = searchUrl .. "&cursor=" .. HttpService:UrlEncode(cursor) end
        local searchData, searchError = requestJson(searchUrl, "GET", nil, 20)
        if not searchData then return nil, searchError end
        local ids = {}
        for _, item in ipairs(searchData.data or {}) do
            if item.id then table.insert(ids, tostring(item.id)) end
        end
        if #ids == 0 then return {assets = {}, nextCursor = searchData.nextPageCursor} end
        local detailData, detailError = requestJson(buildDetailUrl(ids), "GET", nil, 20)
        if not detailData then return nil, detailError end
        local results = {}
        for _, entry in ipairs(detailData.data or {}) do
            local asset = entry.asset or entry
            if asset and asset.id then
                asset.creatorName = asset.creatorName or (entry.creator and entry.creator.name)
                table.insert(results, asset)
            end
        end
        return {assets = results, nextCursor = searchData.nextPageCursor}
    end

