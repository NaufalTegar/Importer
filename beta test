doExport.MouseButton1Click:Connect(function()
    local payload = {
        format = "HYAZ_PROJECT_JSON",
        version = VERSION,
        generatedAt = os.time(),
        objects = collectExportObjects()
    }
    ioBox.Text = HttpService:JSONEncode(payload)
    bridgeEvents.ExportRequested:Fire(payload)
    notify("Export JSON siap disalin","ok")
end)

doImport.MouseButton1Click:Connect(function()
    if ioBox.Text == "" then return notify("Tempel HYAZ JSON terlebih dahulu","warn") end
    local ok,data = pcall(function() return HttpService:JSONDecode(ioBox.Text) end)
    if not ok or type(data) ~= "table" or type(data.objects) ~= "table" then
        return notify("JSON tidak valid","warn")
    end

    local folder = Instance.new("Folder")
    folder.Name = "HYAZ_Imported_"..os.time()
    folder.Parent = workspace

    local count = 0
    for _,item in ipairs(data.objects) do
        local p = decodePart(item)
        if p then
            p.Parent = folder
            count += 1
        end
        if count >= 500 then break end
    end
    bridgeEvents.ImportRequested:Fire(data, folder)
    refreshExplorer()
    notify("Import selesai: "..count.." part","ok")
end)

toolButtons["Import"].MouseButton1Click:Connect(function()
    modal.Visible = true
    modalTitle.Text = "IMPORT • HYAZ JSON"
    bridgeEvents.ProjectAction:Fire("OpenImport")
end)

toolButtons["Export"].MouseButton1Click:Connect(function()
    modal.Visible = true
    modalTitle.Text = "EXPORT • HYAZ JSON"
    bridgeEvents.ProjectAction:Fire("OpenExport")
end)

-- =========================================================
-- World click/tap selection
-- =========================================================
mouse.Button1Down:Connect(function()
    if not gui.Enabled then return end
    local target = mouse.Target
    if target and target:IsA("BasePart") then
        -- avoid selecting player's own character
        if player.Character and target:IsDescendantOf(player.Character) then return end
        setSelected(target)
    end
end)

-- =========================================================
-- Responsive layout
-- =========================================================
local function applyResponsive()
    local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280,720)
    local mobile = viewport.X < 820

    if mobile then
        explorer.Size = UDim2.new(0,190,1,-114)
        props.Size = UDim2.new(0,210,1,-114)
        centerCard.Position = UDim2.fromOffset(206,106)
        centerCard.Size = UDim2.new(1,-424,1,-114)
        toolbar.CanvasPosition = Vector2.zero
        versionLabel.Visible = false
        projectName.Visible = false
        tabs.Visible = false
    else
        explorer.Size = UDim2.new(0,250,1,-114)
        props.Size = UDim2.new(0,270,1,-114)
        centerCard.Position = UDim2.fromOffset(266,106)
        centerCard.Size = UDim2.new(1,-552,1,-114)
        versionLabel.Visible = true
        projectName.Visible = true
        tabs.Visible = true
    end
end

if workspace.CurrentCamera then
    workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(applyResponsive)
end
applyResponsive()

-- =========================================================
-- Keyboard shortcuts
-- =========================================================
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if UserInputService:GetFocusedTextBox() then return end

    if input.KeyCode == Enum.KeyCode.One then setTool("Select") end
    if input.KeyCode == Enum.KeyCode.Two then setTool("Move") end
    if input.KeyCode == Enum.KeyCode.Three then setTool("Scale") end
    if input.KeyCode == Enum.KeyCode.Four then setTool("Rotate") end

    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) and input.KeyCode == Enum.KeyCode.D then
        duplicateSelected()
    elseif input.KeyCode == Enum.KeyCode.Delete or input.KeyCode == Enum.KeyCode.Backspace then
        deleteSelected()
    end
end)

