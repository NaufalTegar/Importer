    local fixingChatCanvas = false
    local function clampChatCanvas()
        if fixingChatCanvas then return end
        local maxY = math.max(0, ChatScroll.AbsoluteCanvasSize.Y - ChatScroll.AbsoluteSize.Y)
        local clampedY = math.clamp(ChatScroll.CanvasPosition.Y, 0, maxY)
        if clampedY ~= ChatScroll.CanvasPosition.Y then
            fixingChatCanvas = true
            ChatScroll.CanvasPosition = Vector2.new(0, clampedY)
            fixingChatCanvas = false
        end
    end

    local function updateChatScrolling()
        local contentHeight = ChatScroll.AbsoluteCanvasSize.Y
        local viewHeight = ChatScroll.AbsoluteSize.Y
        -- Scrolling only becomes available when the actual content overflows;
        -- the old message-count gate made short chats feel locked.
        local allowScroll = contentHeight > viewHeight + 4
        ChatScroll.ScrollingEnabled = allowScroll
        if not allowScroll then
            ChatScroll.CanvasPosition = Vector2.new(0, 0)
        else
            clampChatCanvas()
        end
        return allowScroll
    end

