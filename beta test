--[[
    HYAZ STUDIO LITE UI REPLACER
    Beta v0.0.02

    Intended for Roblox experiences / Studio Lite forks you control.

    What changed from v0.0.01:
    - Prints diagnostics immediately.
    - Actively removes/disables known old Studio Lite ScreenGuis.
    - Watches PlayerGui so late-loading old UI is removed too.
    - Creates HYAZ UI only after cleanup.
    - Does NOT use executor-only APIs, exploit hooks, getgc/debug hooks,
      CoreGui injection, or security bypasses.

    IMPORTANT:
    Add the actual ScreenGui names from your own Studio Lite copy to TARGET_GUI_NAMES.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

print("[HYAZ] UI Replacer v0.0.02 starting...")

local player = Players.LocalPlayer
if not player then
    warn("[HYAZ] LocalPlayer not found. This must run on the client.")
    return
end

local playerGui = player:WaitForChild("PlayerGui", 15)
if not playerGui then
    warn("[HYAZ] PlayerGui not found.")
    return
end

print("[HYAZ] PlayerGui found:", playerGui:GetFullName())

local OUR_GUI_NAME = "HYAZ_STUDIO_LITE"

-- Put exact ScreenGui names from the Studio Lite copy you control here.
local TARGET_GUI_NAMES = {
    "StudioLite",
    "Studio Lite",
    "StudioLiteUI",
    "StudioLiteGui",
    "StudioGUI",
    "MainGUI",
}

local targetLookup = {}
for _, n in ipairs(TARGET_GUI_NAMES) do
    targetLookup[string.lower(n)] = true
end

local function isOurGui(obj)
    return obj.Name == OUR_GUI_NAME
end

local function isTargetGui(obj)
    if not obj:IsA("ScreenGui") then
        return false
    end
    if isOurGui(obj) then
        return false
    end

    -- Exact names only, to avoid deleting unrelated UI.
    if targetLookup[string.lower(obj.Name)] then
        return true
    end

    -- Optional safe marker for your own fork:
    -- set Attribute "HYAZ_ReplaceUI" = true on the old ScreenGui.
    if obj:GetAttribute("HYAZ_ReplaceUI") == true then
        return true
    end

    return false
end

local removed = 0

local function removeOldGui(obj)
    if not obj or not obj.Parent then
        return
    end

    if isTargetGui(obj) then
        removed += 1
        print("[HYAZ] Removing old UI:", obj:GetFullName())

        -- Disable first so it disappears immediately.
        pcall(function()
            obj.Enabled = false
        end)

        task.defer(function()
            if obj and obj.Parent then
                obj:Destroy()
            end
        end)
    end
end

-- Remove an earlier HYAZ copy.
local oldHyaz = playerGui:FindFirstChild(OUR_GUI_NAME)
if oldHyaz then
    print("[HYAZ] Removing previous HYAZ UI.")
    oldHyaz:Destroy()
end

-- Initial cleanup.
for _, obj in ipairs(playerGui:GetDescendants()) do
    removeOldGui(obj)
end

-- Watch for old UI that loads after this script.
local descendantConn
descendantConn = playerGui.DescendantAdded:Connect(function(obj)
    if obj:IsA("ScreenGui") then
        task.defer(function()
            removeOldGui(obj)
        end)
    end
end)

print("[HYAZ] Initial cleanup complete. Removed:", removed)

