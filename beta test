                local raw = type(result) == "table" and (result.Body or result.body or result.ResponseBody or result.responseBody) or result
                local good, data = pcall(function()
                    return type(raw) == "table" and raw or HttpService:JSONDecode(raw)
                end)
                if good and data and data.choices and data.choices[1] and data.choices[1].message then
