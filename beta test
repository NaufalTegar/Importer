    local function sendToQuantum(msg)
        if isGenerating or not msg or msg == "" then return end
        isGenerating = true
        cancelGeneration = false
        
        SendBtn.Visible = false
        StopBtn.Visible = true
        
        addMessageToUI(msg, true)
        table.insert(chatHistory, {role="user", content=msg})
        while #chatHistory > 14 do table.remove(chatHistory, 1) end
        showThinking()

        if not currentSessionId then
            currentSessionId = tostring(os.time())
            local title = msg:sub(1, 15)
            if #msg > 15 then title = title .. "..." end
            saveQuantumSession(currentSessionId, title, chatHistory)
            refreshSessionsList()
        else
            local title = "Session"
            for _, s in ipairs(quantumSessions) do if s.id == currentSessionId then title = s.title break end end
            saveQuantumSession(currentSessionId, title, chatHistory)
        end

        local storeContext = getQuantumStoreContext(msg)
        local selectedModel = QuantumGui:GetAttribute("QuantumModel") or "Flash"
        if selectedModel ~= "Flash" then selectedModel = "Flash" end
        local usingFlash = true
        local sysPrompt = "You are Quantum, a private Roblox Lua coding assistant for Roblox Studio Lite. When asked what AI you are, respond: \"Quantum, your private coding assistant\".\n"
        .. "You ONLY write Roblox Lua code when asked for code. You help with scripting, debugging, and game design in Roblox.\n"
        .. "Use markdown: **bold**, *italic*, # headers, ```lua code blocks.\n"
        .. "Keep responses helpful and concise. Running in Roblox Studio Lite."
        .. (storeContext ~= "" and ("\n\n" .. storeContext) or "")
        
        local messages = {{role="system", content=sysPrompt}}
        for _, m in ipairs(chatHistory) do table.insert(messages, m) end
        local body = {
            model = usingFlash and "google/gemma-4-26b-a4b-it:free" or "z-ai/glm-5.2",
            messages = messages,
            temperature = 1,
            top_p = usingFlash and 0.95 or 1,
            max_tokens = 8192,
            stream = not usingFlash,
        }
        if usingFlash then
            body.provider = {
                order = {"Google AI Studio"},
                allow_fallbacks = true,
            }
        else
            body.seed = 42
        end

        local encodeOk, bodyJson = pcall(function()
            return HttpService:JSONEncode(body)
        end)
        if not encodeOk then
            addMessageToUI("*Could not encode the message for Quantum.*", false)
            resetGenUI()
            return
        end

        local apiKey = usingFlash and OPENROUTER_API_KEY or NVIDIA_API_KEY
        local requestCandidates = getHttpRequests()
        if #requestCandidates == 0 then
            addMessageToUI("*No HTTP request function is available in this executor.*", false)
            resetGenUI()
            return
        end

        aiTask = task.spawn(function()
            local workerOk, workerError = xpcall(function()
                local requestUrl = usingFlash and "https://openrouter.ai/api/v1/chat/completions" or "https://integrate.api.nvidia.com/v1/chat/completions"
                local requestOptions = {
                    Url = requestUrl,
                    Method = "POST",
                    Headers = {
                        ["Accept"] = "application/json",
                        ["Content-Type"] = "application/json",
                        ["Authorization"] = "Bearer " .. apiKey,
                        ["HTTP-Referer"] = "https://openrouter.ai",
                        ["X-Title"] = "CoStudio Quantum AI",
                    },
                    Body = bodyJson,
                }
                local lowerOptions = {
                    url = requestUrl,
                    method = "POST",
                    headers = requestOptions.Headers,
                    body = bodyJson,
                }

                local ok, result = false, nil
                local lastError = "unknown request error"
                for _, candidate in ipairs(requestCandidates) do
                    local firstOk, firstResult = callHttpCandidate(candidate, requestOptions, usingFlash and 60 or 120)
                    if firstOk and firstResult ~= nil then
                        ok, result = true, firstResult
                        break
                    end
                    lastError = candidate.name .. ": " .. tostring(firstResult)

                    local secondOk, secondResult = callHttpCandidate(candidate, lowerOptions, usingFlash and 60 or 120)
                    if secondOk and secondResult ~= nil then
                        ok, result = true, secondResult
                        break
                    end
                    lastError = candidate.name .. ": " .. tostring(secondResult)
                end

                if cancelGeneration then return end
                if not ok then error(lastError) end

                local respBody = nil
                local statusCode = 0
                if type(result) == "table" then
                    respBody = result.Body or result.body or result.ResponseBody or result.responseBody or result.response_body
                    statusCode = tonumber(result.StatusCode or result.statusCode or result.status_code) or 0
                    if result.Success == false and statusCode < 400 then statusCode = 400 end
                elseif type(result) == "string" then
                    respBody = result
                end

                if statusCode >= 400 then
                    local statusText = "HTTP " .. tostring(statusCode)
                    if type(respBody) == "string" and respBody ~= "" then
                        local decodedOk, decoded = pcall(function() return HttpService:JSONDecode(respBody) end)
                        if decodedOk and type(decoded) == "table" and type(decoded.error) == "table" then
                            statusText = tostring(decoded.error.message or decoded.error.code or statusText)
                        end
                    end
                    error(statusText)
                end

                if not respBody or respBody == "" then error("empty response") end

                local reply = ""
                if not usingFlash and type(respBody) == "string" and respBody:find("data:", 1, true) then
                    local contentParts = {}
                    for line in respBody:gmatch("[^\r\n]+") do
                        local dataLine = line:match("^%s*data:%s*(.*)$")
                        if dataLine and dataLine ~= "[DONE]" then
                            local chunkOk, chunk = pcall(function() return HttpService:JSONDecode(dataLine) end)
                            if chunkOk and type(chunk) == "table" then
                                local chunkChoice = chunk.choices and chunk.choices[1]
                                local delta = chunkChoice and chunkChoice.delta
                                if type(delta) == "table" and type(delta.content) == "string" then
                                    table.insert(contentParts, delta.content)
                                end
                                if chunk.error then
                                    local streamError = chunk.error
                                    error(tostring(type(streamError) == "table" and (streamError.message or streamError.code) or streamError))
                                end
                            end
                        end
                    end
                    reply = table.concat(contentParts)
                else
                    local parsed
                    if type(respBody) == "table" then
                        parsed = respBody
                    else
                        local decodeOk, decoded = pcall(function() return HttpService:JSONDecode(respBody) end)
                        if not decodeOk then error("invalid JSON response") end
                        parsed = decoded
                    end
                    if type(parsed) ~= "table" then error("invalid response body") end
                    if parsed.error then
                        local apiError = parsed.error
                        local errorText = type(apiError) == "table" and (apiError.message or apiError.code) or apiError
                        error(tostring(errorText or "unknown API error"))
                    end
                    local choice = parsed.choices and parsed.choices[1]
                    local responseMessage = choice and choice.message
                    if type(responseMessage) ~= "table" then error("response did not contain a message") end
                    reply = responseMessage.content or responseMessage.reasoning or responseMessage.reasoning_content or ""
                    if type(reply) ~= "string" then reply = tostring(reply) end
                end
                if reply == "" then error("empty reply") end

                table.insert(chatHistory, {role = "assistant", content = reply})
                addMessageToUI(reply, false)

                local title = "Session"
                for _, session in ipairs(quantumSessions) do
                    if session.id == currentSessionId then title = session.title break end
                end
                saveQuantumSession(currentSessionId, title, chatHistory)
            end, function(err)
                return tostring(err)
            end)

            if not workerOk and not cancelGeneration then
                addMessageToUI("*Quantum request failed: " .. tostring(workerError) .. "*", false)
            end
            if not cancelGeneration then
                resetGenUI()
            end
            aiTask = nil
        end)
        local thisTask = aiTask
        task.delay(usingFlash and 60 or 150, function()
            if isGenerating and aiTask == thisTask then
                cancelGeneration = true
                pcall(function() task.cancel(thisTask) end)
                addMessageToUI("*Quantum timed out while waiting for the provider. Try again or switch models.*", false)
                resetGenUI()
                aiTask = nil
            end
        end)
    end

