    local categoryColors = {
        Primitives   = Color3.fromRGB(20, 60, 110),
        Architecture = Color3.fromRGB(20, 100, 70),
        Meshes       = Color3.fromRGB(110, 60, 30),
        Materials    = Color3.fromRGB(90, 20, 110),
        Special      = Color3.fromRGB(110, 80, 20),
    }

    local function setStatus(text, color)
        -- (No status label in this compact UI; uses Notify for feedback)
    end

    local function notify(text, ok)
        if not notifyWindow then return end
        pcall(function()
            notifyWindow:Notify({
                title = ok and "Inserted" or "Failed",
                content = text,
                duration = 2,
            })
        end)
    end

    local function insertPart(entry)
        if not entry then return end
        local errMsg
        local ok = pcall(function()
            local parts = nil  -- list of parts to spawn

            -- 1. Inline build function (used by Primitives + Smooth meshes)
            if entry.build and type(entry.build) == "function" then
                parts = { entry.build() }
            end

            -- 2. Look up in global builders table (used by Architecture + Meshes + Special)
            if not parts and entry.key and PARTS_BUILDERS[entry.key] then
                local result = PARTS_BUILDERS[entry.key]()
                if type(result) == "table" and result[1] then
                    parts = result
                else
                    parts = { result }
                end
            end

            -- 3. Material variant (Wood Block, Metal Block, etc.)
            if not parts and entry.material then
                parts = { buildMaterialBlock(entry.material, entry.emissive == true) }
            end

            -- 4. Asset-based (Head Mesh, Gear Mesh, etc.)
            if not parts and entry.source == "asset" and entry.assetId then
                local objects = game:GetObjects("rbxassetid://" .. tostring(entry.assetId))
                if objects and #objects > 0 then
                    parts = { objects[1] }
                end
            end

            if not parts or #parts == 0 then
                errMsg = "No part produced for " .. tostring(entry.label)
                return
            end

            -- Filter to actual BaseParts (skip non-part returns).
            local valid = {}
            for _, p in ipairs(parts) do
                if p and p:IsA("BasePart") then
                    table.insert(valid, p)
                end
            end
            if #valid == 0 then
                errMsg = "Builder returned no BasePart"
                return
            end

            spawnPartsAtFocus(valid, entry)
        end)
        if ok then
            notify("Inserted " .. entry.label, true)
        else
            notify((errMsg or "Could not insert") .. " " .. entry.label, false)
        end
    end

    local function renderGrid()
        for _, child in ipairs(grid:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        local q = search.Text:lower()
        local count = 0
        for i, entry in ipairs(PARTS_CATALOG) do
            if q == "" or entry.label:lower():find(q, 1, true) then
                count = count + 1
                local b = Instance.new("TextButton", grid)
                b.Text = entry.label
                b.FontFace = Font.fromEnum(Enum.Font.GothamBold)
                b.TextSize = 11
                b.TextColor3 = Color3.fromRGB(230, 240, 255)
                b.BackgroundColor3 = categoryColors[entry.cat] or Color3.fromRGB(20, 30, 45)
                b.BorderSizePixel = 0
                b.AutoButtonColor = false
                Instance.new("UICorner", b).CornerRadius = UDim.new(0, 7)
                local bs = Instance.new("UIStroke", b)
                bs.Color = Color3.fromRGB(0, 80, 160); bs.Thickness = 0.8
                b.Activated:Connect(function() insertPart(entry) end)
            end
        end
    end

    search:GetPropertyChangedSignal("Text"):Connect(renderGrid)
    renderGrid()
end

