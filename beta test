    local function toggleSavedModel(asset)
        if not isModelAsset(asset) then return false end
        local id = tonumber(asset.id or asset.AssetId)
        for index, saved in ipairs(savedModels) do
            if tonumber(saved.id or saved.AssetId) == id then
                table.remove(savedModels, index)
                saveSavedModels()
                return false
            end
        end
        local copy = {}
        for key, value in pairs(asset) do copy[key] = value end
        copy.savedAt = os.date("!%Y-%m-%d %H:%M UTC")
        table.insert(savedModels, 1, copy)
        while #savedModels > 100 do table.remove(savedModels) end
        saveSavedModels()
        return true
    end

