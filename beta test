local function insertPart()
    local p = Instance.new("Part")
    p.Name = "Part"
    p.Size = Vector3.new(4,1,4)
    p.Anchored = true
    p.Position = workspace.CurrentCamera and (workspace.CurrentCamera.CFrame.Position + workspace.CurrentCamera.CFrame.LookVector * 12) or Vector3.new(0,5,0)
    p.Parent = workspace
    setSelected(p)
    bridgeEvents.InsertRequested:Fire("Part", p)
    notify("Part dibuat","ok")
end

local function duplicateSelected()
    if not selected then return notify("Tidak ada objek terpilih","warn") end
    local c = selected:Clone()
    c.Parent = selected.Parent
    c.CFrame = selected.CFrame * CFrame.new(2,0,2)
    setSelected(c)
    bridgeEvents.DuplicateRequested:Fire(c)
    notify("Objek diduplikasi","ok")
end

local function deleteSelected()
    if not selected then return notify("Tidak ada objek terpilih","warn") end
    local oldSel = selected
    setSelected(nil)
    bridgeEvents.DeleteRequested:Fire(oldSel)
    oldSel:Destroy()
    notify("Objek dihapus","ok")
end

local function toggleAnchor()
    if not selected then return notify("Tidak ada objek terpilih","warn") end
    selected.Anchored = not selected.Anchored
    refreshProperties()
    notify("Anchored = "..tostring(selected.Anchored),"ok")
end

toolButtons["Insert Part"].MouseButton1Click:Connect(insertPart)
toolButtons["Duplicate"].MouseButton1Click:Connect(duplicateSelected)
