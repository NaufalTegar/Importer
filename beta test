-- Auto-anchor and auto-collide, mirroring the SL_Anchored / SL_CanCollide
-- scheme that insertModelAsset uses. We save the originals to attributes so
-- the user can later restore them if they want.
local function applyAutoAnchorAndCollide(part)
    if not part or not part:IsA("BasePart") then return end
    pcall(function()
        if part:GetAttribute("SL_Anchored") == nil then
            part:SetAttribute("SL_Anchored", part.Anchored)
        end
        part.Anchored = true
    end)
    pcall(function()
        if part:GetAttribute("SL_CanCollide") == nil then
            part:SetAttribute("SL_CanCollide", part.CanCollide)
        end
        part.CanCollide = true
    end)
    pcall(function()
        if part:GetAttribute("SL_AssemblyAngularVelocity") == nil then
            local v = Vector3.new(0, 0, 0)
            pcall(function() v = part.AssemblyAngularVelocity end)
            part:SetAttribute("SL_AssemblyAngularVelocity", v)
        end
    end)
end

-- Insert one or more parts at the fly camera focus. Single parts are
-- parented directly to workspace (no Model wrapper). Multi-part composites
-- (ring, stairs, arch, half pipe, flag pole, etc.) are wrapped in a Model
-- so they move / select as one unit. Every part is anchored and collidable
-- (with originals backed up to SL_ attributes) before parenting.
local function spawnPartsAtFocus(parts, entry)
    if type(parts) ~= "table" or #parts == 0 then return nil end
    if #parts == 1 and not parts[1]:IsA("BasePart") then return nil end

    local focus = workspace:FindFirstChild("FlyCameraFocus")
    local cf = focus and focus.CFrame or CFrame.new(0, 5, 0)

    -- 1. Apply anchor + collide + save originals BEFORE parenting.
    for _, p in ipairs(parts) do
        if p and p:IsA("BasePart") then applyAutoAnchorAndCollide(p) end
    end

    -- 2. Single part: parent directly to workspace, no Model wrapper.
    if #parts == 1 then
        local p = parts[1]
        p.CFrame = cf
        p.Anchored = true
        p.CanCollide = true
        p.Parent = workspace
        -- If the part has a meaningful name, keep it; otherwise name it
        -- after the catalog entry for easier selection.
        if entry and entry.label and (not p.Name or p.Name == "Part") then
            p.Name = entry.label
        end
        return p
    end

    -- 3. Multi-part composite: wrap in a Model and place at the focus.
    --    Lay the parts out side-by-side so they don't overlap, then MoveTo
    --    centres the whole model at the focus point.
    local model = Instance.new("Model")
    model.Name = (entry and entry.label) or "CoStudioComposite"
    model.Parent = workspace

    local totalWidth = 0
    for _, p in ipairs(parts) do totalWidth = totalWidth + p.Size.X + 1 end
    totalWidth = totalWidth - 1
    local cursor = -totalWidth / 2
    for _, p in ipairs(parts) do
        if p and p:IsA("BasePart") then
            p.CFrame = CFrame.new(cf.Position + Vector3.new(cursor, 0, 0))
            p.Parent = model
            cursor = cursor + p.Size.X + 1
        end
    end
    -- Use the first part as the PrimaryPart so Model:MoveTo works.
    pcall(function() model.PrimaryPart = parts[1] end)
    pcall(function() model:MoveTo(cf.Position) end)
    return model
end

local function openPartsLibrary(notifyWindow)
    local existing = CoreGui:FindFirstChild("CoStudioPartsLibrary")
    if existing then
        if existing:GetAttribute("CoStudioPartsLibBuild") == "v1" then
            existing.Enabled = true
            return
        end
        existing:Destroy()
    end

    local gui = Instance.new("ScreenGui")
    gui.Name = "CoStudioPartsLibrary"
    gui:SetAttribute("CoStudioPartsLibBuild", "v1")
    gui.ResetOnSpawn = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.Parent = CoreGui

    local main = Instance.new("Frame", gui)
    main.Size = UDim2.fromOffset(560, 400)
    main.AnchorPoint = Vector2.new(0.5, 0.5)
    main.Position = UDim2.fromScale(0.5, 0.5)
    main.BackgroundColor3 = Color3.fromRGB(8, 18, 38)
    main.BorderSizePixel = 0
    main.ClipsDescendants = true
    Instance.new("UICorner", main).CornerRadius = UDim.new(0, 12)
    local ms = Instance.new("UIStroke", main); ms.Color = Color3.fromRGB(0, 110, 220); ms.Thickness = 1.5

    local top = Instance.new("Frame", main)
    top.Size = UDim2.new(1, 0, 0, 44)
    top.BackgroundTransparency = 1
    local title = Instance.new("TextLabel", top)
    title.Text = "Advanced Parts Library"
    title.FontFace = Font.fromEnum(Enum.Font.GothamBold)
    title.TextSize = 17
    title.TextColor3 = Color3.fromRGB(230, 240, 255)
    title.BackgroundTransparency = 1
    title.Size = UDim2.new(1, -55, 1, 0)
    title.Position = UDim2.new(0, 14, 0, 0)
    title.TextXAlignment = Enum.TextXAlignment.Left
    local close = Instance.new("TextButton", top)
    close.Text = "X"
    close.FontFace = Font.fromEnum(Enum.Font.GothamBold)
    close.TextSize = 15
    close.TextColor3 = Color3.fromRGB(160, 190, 230)
    close.BackgroundTransparency = 1
    close.Size = UDim2.fromOffset(40, 44)
    close.Position = UDim2.new(1, -40, 0, 0)
    close.Activated:Connect(function() gui.Enabled = false end)

    -- Touchscreen / mouse drag support: drag the title bar to move the window.
    local dragTarget = main
    local dragInput, dragStart, startPos
    top.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
            dragStart = Vector2.new(input.Position.X, input.Position.Y)
            startPos = dragTarget.Position
        end
    end)
    top.InputEnded:Connect(function(input)
        if input == dragInput then dragInput = nil end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragInput and (input == dragInput or input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStart
            dragTarget.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    local search = Instance.new("TextBox", main)
    search.Text = ""
    search.PlaceholderText = "Search 55+ parts..."
    search.ClearTextOnFocus = false
    search.FontFace = Font.fromEnum(Enum.Font.Gotham)
    search.TextSize = 13
    search.TextColor3 = Color3.fromRGB(230, 240, 255)
    search.PlaceholderColor3 = Color3.fromRGB(120, 160, 200)
