    end

    local function updateAudioProgress()
        local length = PreviewSound.TimeLength or 0
        local position = PreviewSound.TimePosition or 0
        local ratio = length > 0 and math.clamp(position / length, 0, 1) or 0
        SeekFill.Size = UDim2.new(ratio, 0, 1, 0)
        AudioTime.Text = length > 0 and (formatAudioTime(position) .. " / " .. formatAudioTime(length)) or "Loading audio..."
    end

    stopPreviewAudio = function()
        pcall(function() PreviewSound:Stop() end)
        PreviewSound.SoundId = ""
        PreviewSound.TimePosition = 0
