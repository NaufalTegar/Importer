        customBtn.Active = false
        customBtn.Text = "…"
        setStatus("Quantum is designing a custom lighting for \"" .. description .. "\"...", Color3.fromRGB(150, 200, 255))

        local systemPrompt = "You design custom Roblox Studio Lite lighting configs from a short user description. Return strict JSON only, no markdown, no commentary. Schema: {\"name\":string,\"brightness\":number 0..4,\"clockTime\":number 0..24,\"ambient\":[r,g,b] 0..255,\"outdoorAmbient\":[r,g,b] 0..255,\"fogColor\":[r,g,b] 0..255,\"fogStart\":number 0..1000,\"fogEnd\":number 1000..30000,\"exposure\":number -1..1,\"diffuse\":number 0..1,\"specular\":number 0..1,\"colorShiftTop\":[r,g,b] 0..255,\"tint\":[r,g,b] 0..255,\"contrast\":number -0.5..0.5,\"saturation\":number -1..1,\"bloom\":boolean,\"bloomIntensity\":number 0..2,\"bloomSize\":number 8..48,\"atmosphereDensity\":number 0..1,\"atmosphereHaze\":number 0..2.5,\"atmosphereColor\":[r,g,b] 0..255,\"atmosphereDecay\":[r,g,b] 0..255}. Pick values that match the description's mood. Higher exposure + more bloom for vibrant, lower + cooler colors for moody, dense atmosphere for foggy/rainy, sparse for clear sky. No explanations, only the JSON object."

        local body = {
