import { useEffect, useMemo, useState } from "react";
import {
  Archive,
  Check,
  ChevronDown,
  CircleHelp,
  Download,
  FileCode2,
  FolderSearch,
  Minus,
  Package,
  PanelLeftClose,
  PanelLeftOpen,
  RefreshCw,
  Search,
  Settings2,
  ShieldCheck,
  X,
} from "lucide-react";

type Asset = {
  name: string;
  kind: "Scene Pack" | "UI Kit" | "Material Set";
  size: string;
  updated: string;
  color: string;
};

const sampleAssets: Asset[] = [
  { name: "Ruang Kerja Senja", kind: "Scene Pack", size: "18.4 MB", updated: "baru saja", color: "#78e08f" },
  { name: "Papan Navigasi", kind: "UI Kit", size: "6.2 MB", updated: "2 mnt lalu", color: "#b6e66d" },
  { name: "Material Batu Kali", kind: "Material Set", size: "12.8 MB", updated: "kemarin", color: "#4fbd83" },
  { name: "Kios Pasar Pagi", kind: "Scene Pack", size: "24.1 MB", updated: "kemarin", color: "#a5d86a" },
  { name: "Label Koleksi", kind: "UI Kit", size: "3.7 MB", updated: "3 hari lalu", color: "#6ed2a1" },
];

function Dot({ color = "#8ae89a" }: { color?: string }) {
  return <span className="h-1.5 w-1.5 rounded-full" style={{ backgroundColor: color, boxShadow: `0 0 8px ${color}` }} />;
}

export function WorkspaceHome() {
  const [booting, setBooting] = useState(true);
  const [minimized, setMinimized] = useState(false);
  const [closed, setClosed] = useState(false);
  const [open, setOpen] = useState(true);
  const [query, setQuery] = useState("");
  const [filter, setFilter] = useState<"Semua" | Asset["kind"]>("Semua");
  const [assets, setAssets] = useState<Asset[]>([]);
  const [notice, setNotice] = useState("");
  const [selected, setSelected] = useState<string | null>(null);
  const [imported, setImported] = useState<string[]>([]);

  useEffect(() => {
    const timer = window.setTimeout(() => setBooting(false), 900);
    return () => window.clearTimeout(timer);
  }, []);

  const toast = (message: string) => {
    setNotice(message);
    window.setTimeout(() => setNotice(""), 2300);
  };

  const scanAssets = () => {
    setBooting(true);
    window.setTimeout(() => {
      setAssets(sampleAssets);
      setBooting(false);
      toast("Pemindaian selesai Â· 5 asset ditemukan");
    }, 850);
  };

  const visibleAssets = useMemo(() => assets.filter((asset) => {
    const matchesFilter = filter === "Semua" || asset.kind === filter;
    return matchesFilter && asset.name.toLowerCase().includes(query.toLowerCase());
  }), [assets, filter, query]);

  const importAsset = (name: string) => {
    setImported((current) => current.includes(name) ? current : [...current, name]);
    toast(`${name} ditandai siap digunakan`);
  };

  if (closed) {
    return (
      <main className="min-h-screen bg-[#07110d] p-5 text-[#d3eed7]" style={{ fontFamily: "'Space Mono', 'SFMono-Regular', Consolas, monospace" }}>
        <button onClick={() => { setClosed(false); setOpen(true); }} className="group mx-auto mt-[38vh] flex items-center gap-3 rounded-lg border border-[#245137] bg-[#0c1b14] px-4 py-3 text-[11px] text-[#8ade97] shadow-[0_0_28px_rgba(66,220,110,.08)] transition hover:border-[#70e58c]"><PanelLeftOpen size={15} /> Buka NOVA Asset Console <span className="text-[#527f5e]">[Enter]</span></button>
      </main>
    );
  }

  return (
    <main className="relative min-h-screen overflow-hidden bg-[#07110d] text-[#c6e6cb]" style={{ fontFamily: "'Space Mono', 'SFMono-Regular', Consolas, monospace" }}>
      <div className="pointer-events-none absolute inset-0 opacity-30" style={{ backgroundImage: "linear-gradient(rgba(90,190,104,.06) 1px, transparent 1px), linear-gradient(90deg, rgba(90,190,104,.045) 1px, transparent 1px)", backgroundSize: "32px 32px" }} />
      <div className="pointer-events-none absolute left-1/2 top-[-180px] h-[430px] w-[650px] -translate-x-1/2 rounded-full bg-[#2b9b58]/10 blur-[110px]" />
      <div className={`relative mx-auto mt-10 w-[calc(100%-28px)] max-w-[720px] transition-all duration-300 sm:mt-[95px] ${minimized ? "max-w-[330px]" : ""}`}>
        <div className={`${open ? "" : "hidden"} overflow-hidden rounded-xl border border-[#285b38] bg-[#0b1912]/95 shadow-[0_0_0_1px_rgba(130,242,139,.04),0_22px_70px_rgba(0,0,0,.42),0_0_55px_rgba(43,155,88,.11)]`}>
          <header className="flex h-11 items-center justify-between border-b border-[#1c3d28] bg-[#0f2116] px-3.5">
            <div className="flex min-w-0 items-center gap-2.5"><span className="grid h-6 w-6 shrink-0 place-items-center rounded bg-[#173a22] text-[#9aee9d]"><Package size={14} /></span><span className="truncate text-[11px] font-bold tracking-[.08em] text-[#d5f4d6]">NOVA <span className="text-[#78d986]">ASSET CONSOLE</span></span><span className="hidden rounded border border-[#235235] px-1.5 py-0.5 text-[8px] text-[#568f60] sm:inline">LOCAL</span></div>
            <div className="flex items-center gap-1 text-[#60866a]"><button aria-label="Kecilkan panel" onClick={() => setMinimized(!minimized)} className="rounded p-1.5 hover:bg-[#173a22] hover:text-[#a7eeac]"><Minus size={14} /></button><button aria-label="Tutup panel" onClick={() => setClosed(true)} className="rounded p-1.5 hover:bg-[#3a2020] hover:text-[#ed9a9a]"><X size={14} /></button></div>
          </header>

          {!minimized && <div className="p-4 sm:p-5">
            {booting ? (
              <div className="flex h-[310px] flex-col items-center justify-center">
                <div className="mb-5 grid h-14 w-14 place-items-center rounded-2xl border border-[#347448] bg-[#102a18] text-[#8de999] shadow-[0_0_28px_rgba(88,223,113,.17)]"><RefreshCw size={25} className="animate-spin" /></div>
                <p className="text-[12px] font-bold tracking-[.1em] text-[#b6eaba]">MEMULAI NOVA</p>
                <p className="mt-2 text-[10px] text-[#527c5c]">menyiapkan ruang asset lokal<span className="animate-pulse">_</span></p>
                <div className="mt-7 h-1 w-48 overflow-hidden rounded-full bg-[#173622]"><div className="h-full w-2/3 rounded-full bg-[#71d981] shadow-[0_0_10px_#71d981]" /></div>
              </div>
            ) : (
              <>
                <div className="mb-4 flex items-start justify-between gap-3"><div><p className="mb-1 text-[9px] uppercase tracking-[.18em] text-[#5e9668]">Workspace / Asset Library</p><h1 className="text-[17px] font-bold tracking-[-.04em] text-[#e1f4df]">Pindai asset pilihanmu</h1><p className="mt-1 text-[10px] leading-relaxed text-[#638a6a]">Temukan dan rapikan koleksi kerja dalam satu ruang.</p></div><button onClick={() => toast("Pengaturan tersimpan")} className="rounded-lg border border-[#214a2c] p-2 text-[#67996e] hover:border-[#66cf7b] hover:text-[#a2f1a6]"><Settings2 size={15} /></button></div>
                <div className="mb-4 grid gap-2 sm:grid-cols-[1fr_auto]"><button onClick={scanAssets} className="flex h-10 items-center justify-center gap-2 rounded-lg bg-[#78dd88] px-4 text-[11px] font-bold text-[#092010] shadow-[0_0_20px_rgba(103,220,123,.13)] transition hover:bg-[#9aeca0]"><FolderSearch size={15} /> Pindai asset lokal</button><button onClick={() => { setAssets([]); setQuery(""); setSelected(null); toast("Daftar dikosongkan"); }} className="flex h-10 items-center justify-center gap-2 rounded-lg border border-[#28573a] px-3 text-[10px] text-[#75ac7c] hover:bg-[#11291a]"><Archive size={14} /> Bersihkan</button></div>
                <div className="relative mb-3"><Search size={14} className="absolute left-3 top-1/2 -translate-y-1/2 text-[#4e7e59]" /><input value={query} onChange={(event) => setQuery(event.target.value)} placeholder="Cari nama asset..." className="h-9 w-full rounded-lg border border-[#214a2c] bg-[#08130d] pl-9 pr-3 text-[10px] text-[#c6e6cb] outline-none placeholder:text-[#42694d] focus:border-[#6cce7c] focus:ring-1 focus:ring-[#6cce7c]/20" /></div>
                <div className="mb-3 flex items-center gap-1.5 overflow-x-auto pb-1">{(["Semua", "Scene Pack", "UI Kit", "Material Set"] as const).map((item) => <button key={item} onClick={() => setFilter(item)} className={`whitespace-nowrap rounded-md px-2.5 py-1.5 text-[9px] transition ${filter === item ? "bg-[#224b2c] text-[#9bea9b]" : "text-[#5c8b64] hover:bg-[#122b19]"}`}>{item}</button>)}</div>
                <div className="min-h-[245px] rounded-lg border border-[#1b4127] bg-[#08130d]">
                  <div className="flex items-center justify-between border-b border-[#1b3522] px-3 py-2 text-[9px] text-[#4f7e59]"><span>{visibleAssets.length} HASIL TERSEDIA</span><span className="flex items-center gap-1.5"><Dot /> TERHUBUNG</span></div>
                  {visibleAssets.length === 0 ? <div className="flex h-[200px] flex-col items-center justify-center px-5 text-center"><div className="mb-3 grid h-10 w-10 place-items-center rounded-lg border border-dashed border-[#295936] text-[#4a8057]"><FileCode2 size={18} /></div><p className="text-[11px] font-bold text-[#9ecba1]">{assets.length === 0 ? "Belum ada hasil pemindaian" : "Asset tidak ditemukan"}</p><p className="mt-1 max-w-[260px] text-[9px] leading-relaxed text-[#4e7958]">{assets.length === 0 ? "Pindai koleksi lokal untuk melihat asset yang siap dirapikan." : "Coba kata kunci atau kategori lain."}</p></div> : <div className="max-h-[252px] overflow-auto">{visibleAssets.map((asset) => { const isImported = imported.includes(asset.name); return <button key={asset.name} onClick={() => setSelected(asset.name)} className={`flex w-full items-center gap-3 border-b border-[#142d1c] px-3 py-3 text-left transition hover:bg-[#10251a] ${selected === asset.name ? "bg-[#112c1b]" : ""}`}><span className="grid h-8 w-8 shrink-0 place-items-center rounded-md border border-[#285a36] bg-[#102319]" style={{ color: asset.color }}><Package size={15} /></span><span className="min-w-0 flex-1"><span className="block truncate text-[10px] font-bold text-[#b9dfbc]">{asset.name}</span><span className="mt-1 block text-[9px] text-[#547d5b]">{asset.kind} <span className="px-1 text-[#355d40]">Â·</span> {asset.size} <span className="px-1 text-[#355d40]">Â·</span> {asset.updated}</span></span>{isImported ? <span className="flex items-center gap-1 text-[8px] text-[#82df8e]"><Check size={12} /> SIAP</span> : <span className="text-[9px] text-[#4e7e59]">PILIH <ChevronDown size={12} className="-rotate-90 inline" /></span>}</button>; })}</div>}
                </div>
                <div className="mt-3 flex flex-col-reverse items-stretch justify-between gap-2 sm:flex-row sm:items-center"><div className="flex items-center gap-2 text-[9px] text-[#557d5e]"><ShieldCheck size={13} className="text-[#77d786]" /> Ruang kerja aman Â· sesi lokal</div><button disabled={!selected} onClick={() => selected && importAsset(selected)} className="flex h-8 items-center justify-center gap-1.5 rounded-md border border-[#387444] px-3 text-[9px] font-bold text-[#91e696] transition hover:bg-[#173d21] disabled:cursor-not-allowed disabled:opacity-35"><Download size={13} /> Tandai siap digunakan</button></div>
              </>
            )}
          </div>}
          <footer className="flex items-center justify-between border-t border-[#1c3d28] bg-[#09150e] px-3.5 py-2 text-[8px] text-[#4d7656]"><span>NOVA CORE 2.4.1</span><span className="flex items-center gap-2"><Dot /> SISTEM SIAP</span><button onClick={() => toast("Panduan dibuka")} className="flex items-center gap-1 hover:text-[#8fe497]"><CircleHelp size={12} /> BANTUAN</button></footer>
        </div>
        <button onClick={() => setOpen(!open)} className="absolute -bottom-11 left-1/2 flex -translate-x-1/2 items-center gap-2 rounded-b-lg border border-t-0 border-[#285b38] bg-[#0d2014] px-3 py-2 text-[9px] text-[#79c981] hover:text-[#b0f2b0]">{open ? <PanelLeftClose size={13} /> : <PanelLeftOpen size={13} />} {open ? "SEMBUNYIKAN PANEL" : "BUKA PANEL"}</button>
      </div>
      {open && notice && <div className="fixed bottom-5 left-1/2 z-20 flex -translate-x-1/2 items-center gap-2 rounded-lg border border-[#347448] bg-[#10291a] px-3 py-2.5 text-[9px] text-[#a8efad] shadow-[0_0_24px_rgba(77,218,102,.16)]"><Check size={13} className="text-[#7ce689]" /> {notice}</div>}
    </main>
  );
}
