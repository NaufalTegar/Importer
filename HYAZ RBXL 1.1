local function scanFiles()
    clearList()
    status.Text = "Scanning RBXL..."
    local files = collectRBXL()
    if #files == 0 then
        status.Text = "Tidak ada .rbxl di folder Delta/workspace"
        return
    end
    for _, path in ipairs(files) do addFileRow(path) end
    status.Text = string.format("Ready • %d RBXL ditemukan di filesystem Delta", #files)
end

