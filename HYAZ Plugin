local function brushPaint(pos)
    if not pos then return end
    local t=os.clock()
    if t-_TB.lastSpecialBrushTime < 0.055 then return end
    _TB.lastSpecialBrushTime=t
    local T=Workspace:FindFirstChildOfClass("Terrain")
    if not T then return end
    if not terrainOnlyMaterials[_TB.currentMaterial] then return end
    local matE=materialEnum[_TB.currentMaterial]
    if not matE then return end

    -- TRUE PAINT: preserve terrain shape/occupancy and replace only material voxels.
    -- The 4-stud voxel grid prevents accidental terrain growth while painting.
    local radius=math.max(2, math.floor(math.max(_TB.width,_TB.depth)*0.5))
    local half=Vector3.new(radius, math.max(2,_TB.height*0.5), radius)
    local minV=pos-half
    local maxV=pos+half
    local function snap(v) return math.floor(v/4+0.5)*4 end
    minV=Vector3.new(snap(minV.X),snap(minV.Y),snap(minV.Z))
    maxV=Vector3.new(snap(maxV.X),snap(maxV.Y),snap(maxV.Z))
    local region=Region3.new(minV,maxV):ExpandToGrid(4)
    local ok,mats,occ=pcall(function() return T:ReadVoxels(region,4) end)
    if not ok or not mats or not occ then return end
    local changed=false
    for x=1,#mats do
        for y=1,#mats[x] do
            for z=1,#mats[x][y] do
                if (occ[x] and occ[x][y] and occ[x][y][z] or 0) > 0 then
                    if mats[x][y][z] ~= matE then
                        mats[x][y][z]=matE
                        changed=true
                    end
                end
            end
        end
    end
    if changed then
        pcall(function() T:WriteVoxels(region,4,mats,occ) end)
        pcall(function() applyMaterialColor(T,_TB.currentMaterial,matE) end)
    end
end

