local function insertObjects(objects, isRbxl, sourceMap)
    local count = 0
    for _, obj in ipairs(objects) do
        pcall(function()
            local target = (isRbxl and (SVC_MAP[obj.ClassName] or SVC_MAP[obj.Name])) or workspace
            if target == workspace and obj:IsA("Service") then target = ReplicatedStorage end

            if isRbxl and target ~= workspace then
                for _, ch in ipairs(obj:GetChildren()) do
                    pcall(function() 
                        ch.Parent = target; 
                        injectAllScripts(ch, sourceMap); 
                        ApplyStudioLiteProperties(ch); 
                        LoadAssetsToSLServer(ch); 
                        count = count + 1 
                    end)
                    task.wait(0.01)
                end
            else
                obj.Parent = target; 
                injectAllScripts(obj, sourceMap); 
                ApplyStudioLiteProperties(obj); 
                LoadAssetsToSLServer(obj); 
                count = count + 1
            end
        end)
    end
    return count
end

local function safeReadFile(p) if not readfile then return nil end; local ok, d = pcall(readfile, p); return ok and d or nil end

local function loadFile(fileInfo)
    local isRbxl = fileInfo.ftype == "RBXL"
    local data = safeReadFile(fileInfo.path)
    if not data or #data == 0 then return false, "readfile gagal" end

    -- RBXL BETA ENGINE: decode the binary place directly instead of passing
    -- the raw .rbxl bytes to game:GetObjects().
    if isRbxl then
        local ok, parsedOrErr, err = pcall(parseRBXLBinary, data)
        if not ok then return false, "RBXL parser crash: " .. tostring(parsedOrErr) end
        if not parsedOrErr then return false, tostring(err or "RBXL parser gagal") end
        local parsed = parsedOrErr
        local folderOk, folderOrErr = pcall(function()
            return createRBXLInstances(parsed, (fileInfo.name or "RBXL"):gsub("%.rbxl$", ""))
        end)
        if not folderOk or not folderOrErr then
            return false, "RBXL instance builder gagal: " .. tostring(folderOrErr)
        end
        local folder = folderOrErr
        folder.Parent = workspace
        local count = #folder:GetDescendants()
        return true, string.format("RBXL BETA: %d object(s) imported", count)
    end

    local sourceMap = {}
    local ok, sources = pcall(parseRBXMForSources, data)
    if ok and sources then sourceMap = sources end

    if getcustomasset then
        local ok1, aid = pcall(getcustomasset, fileInfo.path)
        if ok1 and aid then
            local ok2, objs = pcall(function() return game:GetObjects(aid) end)
            if ok2 and objs and #objs > 0 then return true, insertObjects(objs, false, sourceMap) .. " object(s) loaded" end
        end
    end

    local ok3, o3 = pcall(function() return game:GetObjects("rbxasset://" .. fileInfo.path) end)
    if ok3 and o3 and #o3 > 0 then return true, insertObjects(o3, false, sourceMap) .. " object(s) loaded" end

    return false, "Semua metode load gagal"
end

