local function autoSaveDraft()
	local chunks=generateScriptChunks()
	if not chunks then return end
	safeMakeFolder(DELTA_WORKSPACE);safeMakeFolder(HASIL_FOLDER)
	safeWriteFile(AUTOSAVE_PATH,chunks[1].content)
end

