-- âš¡ V16 NATURAL: applyTerrainForPart (ganti yang lama)
-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
local function applyTerrainForPart(part, matName)
    local T = Workspace:FindFirstChild("Terrain"); if not T then return 0 end
    if not terrainOnlyMaterials[matName] then return 0 end
    local matE = materialEnum[matName]; if not matE then return 0 end
    local center = part.Position
    local sz = part.Size
    local wSize = math.clamp(sz.X, 6, 40)
    local dSize = math.clamp(sz.Z, 6, 40)
    local hSize = math.clamp(sz.Y, 4, 40)
    local seed = makePartSeed(center.X, center.Y, center.Z)
    local strength = _TBnaturalSeed + (seed % 3)
    local density  = _TBnaturalDensity + (seed % 2)
    local filled = 0
    pcall(function()
        filled = bakeNaturalBlock(T, center, Vector3.new(wSize, hSize, dSize), matE, seed, strength, density)
        applyMaterialColor(T, matName, matE)
    end)
    return filled
end

