local function refreshFileList()
	for _,c in ipairs(UI.fileListScroll:GetChildren()) do
		if not c:IsA("UIListLayout") then c:Destroy() end
	end
	local files=safeListFiles(HASIL_FOLDER)
	local count=0
	for _,fp in ipairs(files) do
		local name=fp:match("([^/\\]+)$") or fp
		if name:match("%.txt$") and not name:match("_autosave") then
			count=count+1
			local row=Instance.new("TextButton")
			row.Size=UDim2.new(1,-6,0,22);row.BackgroundColor3=Color3.fromRGB(30,30,40)
			row.BorderSizePixel=0;row.Text="ðŸ“„ "..name;row.Font=Enum.Font.Gotham;row.TextSize=10
			row.TextColor3=Color3.fromRGB(200,220,255);row.TextXAlignment=Enum.TextXAlignment.Left
			row.ZIndex=11;row.Parent=UI.fileListScroll
			Instance.new("UICorner",row).CornerRadius=UDim.new(0,4)
			row.MouseButton1Click:Connect(function()
				local content=safeReadFile(fp)
				if content then pcall(function() setclipboard(content) end)
					row.Text="âœ… Di-copy! â€” "..name
					task.wait(2);row.Text="ðŸ“„ "..name
				end
			end)
		end
	end
	if count==0 then
		local empty=Instance.new("TextLabel")
		empty.Size=UDim2.new(1,-6,0,22);empty.BackgroundTransparency=1
		empty.Text="(belum ada file)";empty.Font=Enum.Font.Gotham;empty.TextSize=10
		empty.TextColor3=Color3.fromRGB(140,140,140);empty.ZIndex=11;empty.Parent=UI.fileListScroll
	end
end
