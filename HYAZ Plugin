	btn.BorderSizePixel=0;btn.AutoButtonColor=false;btn.ZIndex=10;btn.Parent=parent
	Instance.new("UICorner",btn).CornerRadius=UDim.new(0,3)
	local oc=c
	btn.MouseEnter:Connect(function() btn.BackgroundColor3=Color3.fromRGB(
		math.min(oc.R*255+18,255),math.min(oc.G*255+18,255),math.min(oc.B*255+18,255)) end)
	btn.MouseLeave:Connect(function() btn.BackgroundColor3=oc end)
	return btn
end
