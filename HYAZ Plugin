local function mkBtn(parent,name,pos,text,sizeX,sizeY,color)
	local btn=Instance.new("TextButton")
	btn.Name=name;btn.Size=UDim2.new(0,sizeX or 80,0,sizeY or 24);btn.Position=pos;btn.Text=text
	local c=color or Color3.fromRGB(72,72,72)
