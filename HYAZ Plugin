-- MODULE 03: TERRAIN EDITOR
-- Only the Terrain engine is initialized here, after click.
-- Paint changes existing voxel materials instead of filling new terrain.
-- =========================================================
local terrainReady = false
local terrainPanel = nil
local terrainMode = "ADD"
local terrainMaterial = Enum.Material.Ground
local brushRadius = 8
local brushStrength = 1
local brushTouching = false
local lastPaintCell = nil

local terrainMaterials = {
    {"GRASS",Enum.Material.Grass},
    {"GROUND",Enum.Material.Ground},
    {"SAND",Enum.Material.Sand},
    {"ROCK",Enum.Material.Rock},
    {"MUD",Enum.Material.Mud},
    {"SNOW",Enum.Material.Snow},
    {"WATER",Enum.Material.Water}
}

local function voxelPaint(center)
    local terrain = Workspace:FindFirstChildOfClass("Terrain")
    if not terrain then return false end

    local resolution = 4
    local r = math.max(4, math.floor(brushRadius/4)*4)
    local min = Vector3.new(center.X-r,center.Y-r,center.Z-r)
    local max = Vector3.new(center.X+r,center.Y+r,center.Z+r)
    local region = Region3.new(min,max):ExpandToGrid(resolution)

    local ok, materials, occupancy = pcall(function()
        return terrain:ReadVoxels(region,resolution)
    end)
    if not ok then return false end

    local size = region.Size
    local nx = math.max(1,math.floor(size.X/resolution))
    local ny = math.max(1,math.floor(size.Y/resolution))
    local nz = math.max(1,math.floor(size.Z/resolution))

    local origin = region.CFrame.Position - size/2 + Vector3.new(resolution/2,resolution/2,resolution/2)

    for x=1,nx do
        for y=1,ny do
            for z=1,nz do
                local p = origin + Vector3.new((x-1)*resolution,(y-1)*resolution,(z-1)*resolution)
                local d = (p-center).Magnitude
                if d <= r then
                    -- Paint only voxels that already contain terrain.
                    if occupancy[x] and occupancy[x][y] and occupancy[x][y][z] and occupancy[x][y][z] > 0.05 then
                        materials[x][y][z] = terrainMaterial
                    end
                end
            end
        end
    end

    local writeOK = pcall(function()
        terrain:WriteVoxels(region,resolution,materials,occupancy)
    end)
    return writeOK
end

local function terrainAdd(center, remove)
    local terrain = Workspace:FindFirstChildOfClass("Terrain")
    if not terrain then return end
    local material = terrainMaterial
    local size = Vector3.new(brushRadius*2,brushRadius*2,brushRadius*2)
    pcall(function()
        if remove then
            terrain:FillBall(center,brushRadius,Enum.Material.Air)
        else
            terrain:FillBall(center,brushRadius,material)
        end
    end)
end

local function terrainHit(screenPos)
    local camera = Workspace.CurrentCamera
    if not camera then return nil end
    local ray = camera:ScreenPointToRay(screenPos.X,screenPos.Y)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    if player.Character then params.FilterDescendantsInstances = {player.Character} end
    local result = Workspace:Raycast(ray.Origin,ray.Direction*1500,params)
    return result and result.Position or nil
end

local function terrainApply(pos)
    if not terrainReady then return end
    local cell = Vector3.new(
        math.floor(pos.X/4+0.5),
        math.floor(pos.Y/4+0.5),
        math.floor(pos.Z/4+0.5)
    )
    if lastPaintCell == cell then return end
    lastPaintCell = cell

    if terrainMode == "PAINT" then
        voxelPaint(pos)
    elseif terrainMode == "REMOVE" then
        terrainAdd(pos,true)
    else
        terrainAdd(pos,false)
    end
end

