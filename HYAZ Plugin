-- Loading animation state
task.spawn(function()
    local stages = {
        {"MOUNTING UI CORE", 0.18},
        {"MAPPING ASSET CHANNELS", 0.38},
        {"CALIBRATING SCANNER", 0.60},
        {"SYNCING WORKSPACE", 0.80},
        {"FINALIZING NEXUS", 0.94},
        {"NEXUS READY", 1.00},
    }

    for _, data in ipairs(stages) do
        if not loadingActive or not LoadingScreen.Parent then
            return
        end

        Stage.Text = data[1]
        local target = data[2]
        local startValue = Progress.Size.X.Scale
        local duration = 0.28

        for step = 1, 14 do
            if not loadingActive or not LoadingScreen.Parent then
                return
            end

            local alpha = step / 14
            -- SmoothStep easing
            local eased = alpha * alpha * (3 - 2 * alpha)
            local value = startValue + (target - startValue) * eased

            Progress.Size = UDim2.new(value, 0, 1, 0)
            Percent.Text = string.format("%02d%%", math.floor(value * 100 + 0.5))
            task.wait(duration / 14)
        end

        Progress.Size = UDim2.new(target, 0, 1, 0)
        Percent.Text = string.format("%02d%%", math.floor(target * 100 + 0.5))
        task.wait(0.08)
    end

    RevealFinished = true
end)

