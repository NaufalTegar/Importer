-- Minimized state is declared before the drag closure so the drag logic can
-- correctly switch between normal-window and mini-bar behavior.
local minimized = false

-- Normal window dragging. In minimized mode, only the thin bar itself is draggable.
do
    local drag,ds,sp
    local function beginDrag(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            drag=true; ds=input.Position; sp=Main.Position
        end
    end
    TitleBar.InputBegan:Connect(function(input)
        if minimized then
            if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
                -- Restore button handles its own click; the rest of the bar is draggable.
                local x = input.Position.X
                local barRight = TitleBar.AbsolutePosition.X + TitleBar.AbsoluteSize.X
                if x < barRight - 40 then beginDrag(input) end
            end
        else
            beginDrag(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if drag and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then
            local d=input.Position-ds
            Main.Position=UDim2.new(sp.X.Scale,sp.X.Offset+d.X,sp.Y.Scale,sp.Y.Offset+d.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then drag=false end
    end)
end

