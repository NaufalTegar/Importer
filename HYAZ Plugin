-- âš¡ V16 NATURAL: seed & noise (tempel sebelum applyTerrainForPart)
-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
local _TBnaturalSeed = _TB.naturalStrength or 4
local _TBnaturalDensity = _TB.naturalDensity or 3

local function hash2d(cx, cz)
    local h = (cx * 374761393 + cz * 668265263)
    h = (h ~ (h >> 13)) * 1274126177
    h = h ~ (h >> 16)
    return math.abs(h % 100000)
end

local function makePartSeed(px, py, pz)
    local base = hash2d(math.floor(px/4), math.floor(pz/4))
    return (base + math.floor(py * 3.7) + math.random(0, 400)) % 100000
end

local function noise1(n)
    n = (n << 13) ~ n
    n = (n * (n * n * 15731 + 789221) + 1376312589)
    return math.abs(math.sin(n))
end

local function naturalHeightOffset(cx, cz, seed, strength, density)
    local s = density or 3
    local amp = (strength or 4) * 2
    local h = 0
    for oct = 0, 2 do
        local f  = s + oct
        local nx = (cx / f) + seed % 97
        local nz = (cz / f) + (seed % 89)
        h = h + math.sin(nx * 2.3 + seed % 13) * math.sin(nz * 1.7 + seed % 7) * (amp / (oct + 1))
    end
    h = h + (noise1(cx * 13 + seed) - 0.5) * (amp * 0.4)
    return h
end

local function bakeNaturalBlock(T, center, partSize, matE, seed, strength, density)
    local filled = 0
    local g = 4
    local wHalf = partSize.X / 2
    local dHalf = partSize.Z / 2
    local hBase = partSize.Y / 2
    for wx = -wHalf, wHalf, g do
        for wz = -dHalf, dHalf, g do
            local cellSeed = seed + hash2d(math.floor(wx), math.floor(wz)) % 500
            local holeN = noise1(math.floor((wx + wz) * 3.7) + cellSeed)
            local isHole = holeN < 0.16  -- 16% jadi lubang
            local relief = naturalHeightOffset(wx, wz, cellSeed, strength, density)
            local topY  = relief
            local baseY = -hBase * 0.8
            if not isHole then
                for ty = baseY, topY, g do
                    local wxg = center.X + wx
                    local wzg = center.Z + wz
                    local wy  = center.Y + ty
                    T:FillBlock(CFrame.new(wxg, wy, wzg), Vector3.new(g, g, g), matE)
                    filled = filled + 1
                end
            else
                T:FillBlock(CFrame.new(center.X + wx, center.Y - hBase * 0.8, center.Z + wz), Vector3.new(g, g, g), matE)
                filled = filled + 1
            end
        end
        task.wait()
    end
    return filled
end
local function applyTerrainForPart(part, matName)
	local T=Workspace:FindFirstChild("Terrain"); if not T then return end
	if not terrainOnlyMaterials[matName] then return end
	local matE=materialEnum[matName]; if not matE then return end
	pcall(function()
		local sz=part.Size
		local shapeStr=part:IsA("WedgePart") and "Baji" or
			(part.Shape==Enum.PartType.Ball and "Bola" or
			(part.Shape==Enum.PartType.Cylinder and "Silinder" or "Balok"))
		local accSize,accRadius=getAccurateSize(shapeStr,sz.X,sz.Y,sz.Z)
		if part.Shape==Enum.PartType.Ball then T:FillBall(part.Position,accRadius,matE)
		elseif part.Shape==Enum.PartType.Cylinder then T:FillCylinder(part.CFrame*CFrame.Angles(0,0,math.rad(90)),sz.Y,accRadius,matE)
		else T:FillBlock(part.CFrame,accSize,matE) end
		applyMaterialColor(T,matName,matE)
	end)
end

