--==============================================================
-- SAFE FILESYSTEM
--==============================================================

local function normalizePath(p)
    p = tostring(p or ""):gsub("\\", "/")
    p = p:gsub("/+", "/")
    return p
end

local function safeListFiles(path)
    if type(listfiles) ~= "function" then
        return nil
    end

    local ok, result = pcall(listfiles, normalizePath(path))
    if not ok or type(result) ~= "table" then
        return nil
    end

    return result
end

local function safeIsFolder(path)
    if type(isfolder) ~= "function" then
        return nil
    end

    local ok, result = pcall(isfolder, normalizePath(path))
    if ok then
        return result == true
    end

    return nil
end

local function safeReadFile(path)
    if type(readfile) ~= "function" then
        return nil
    end

    local ok, result = pcall(readfile, normalizePath(path))
    return ok and result or nil
end

local function getFileName(path)
    path = normalizePath(path)
    return path:match("([^/]+)$") or path
end

local function getFileType(name)
    name = tostring(name or ""):lower()

    if name:match("%.rbxm$") or name:match("%.rbxmx$") then
        return "RBXM"
    end

    return nil
end

local function looksFolder(path)
    local name = getFileName(path)
    return not name:match("%.[%w_%-]+$")
end

--==============================================================
-- ROBUST DELTA WORKSPACE SCANNER
--==============================================================

local function scanWorkspace()
    local results = {}
    local seenFiles = {}
    local seenFolders = {}
    local openedRoots = {}
    local rootStats = {}

    local function addFile(path, root)
        path = normalizePath(path)

        if seenFiles[path] then
            return
        end

        local name = getFileName(path)
        local ftype = getFileType(name)

        if not ftype then
            return
        end

        seenFiles[path] = true

        results[#results + 1] = {
            name = name,
            path = path,
            ftype = ftype,
            status = "idle",
            assetId = "",
            selected = false
        }

        rootStats[root] = (rootStats[root] or 0) + 1
    end

    local function walk(folder, depth, root)
        folder = normalizePath(folder)

        if depth > 8 or seenFolders[folder] then
            return
        end

        seenFolders[folder] = true

        local list = safeListFiles(folder)
        if type(list) ~= "table" then
            return
        end

        for _, rawEntry in ipairs(list) do
            local entry = normalizePath(rawEntry)
            local name = getFileName(entry)

            if getFileType(name) then
                addFile(entry, root)
            else
                local folderResult = safeIsFolder(entry)

                if folderResult == true then
                    walk(entry, depth + 1, root)
                elseif folderResult == nil and looksFolder(entry) then
                    -- Fallback for executors without isfolder().
                    walk(entry, depth + 1, root)
                end
            end
        end
    end

    local rootSeen = {}

    for _, root in ipairs(SCAN_PATHS) do
        root = normalizePath(root)

        if not rootSeen[root] then
            rootSeen[root] = true

            local list = safeListFiles(root)

            if type(list) == "table" then
                openedRoots[#openedRoots + 1] = root
                rootStats[root] = 0
                walk(root, 0, root)
            end
        end
    end

    table.sort(results, function(a, b)
        return a.name:lower() < b.name:lower()
    end)

    return results, openedRoots, rootStats
end

--==============================================================
-- HTTP
--==============================================================

local function executorRequest(options)
    local funcs = {
        function()
            if syn and syn.request then return syn.request(options) end
        end,
        function()
            if request then return request(options) end
        end,
        function()
            if http_request then return http_request(options) end
        end,
        function()
            if fluxus and fluxus.request then return fluxus.request(options) end
        end
    }

    for _, fn in ipairs(funcs) do
        local ok, result = pcall(fn)
        if ok and type(result) == "table" then
            return result
        end
    end

    return nil, "Executor HTTP request API tidak tersedia."
end

local function makeBoundary()
    return "----HYAZRBXM" .. tostring(math.random(100000, 999999)) .. tostring(os.clock()):gsub("%.", "")
end

local function multipartBody(boundary, requestJson, fileName, fileData)
    local CRLF = "\r\n"
    local parts = {}

    parts[#parts + 1] = "--" .. boundary .. CRLF
    parts[#parts + 1] = 'Content-Disposition: form-data; name="request"' .. CRLF
    parts[#parts + 1] = "Content-Type: application/json" .. CRLF .. CRLF
    parts[#parts + 1] = requestJson .. CRLF

    parts[#parts + 1] = "--" .. boundary .. CRLF
    parts[#parts + 1] = 'Content-Disposition: form-data; name="fileContent"; filename="' .. fileName .. '"' .. CRLF
    parts[#parts + 1] = "Content-Type: application/octet-stream" .. CRLF .. CRLF
    parts[#parts + 1] = fileData
    parts[#parts + 1] = CRLF
    parts[#parts + 1] = "--" .. boundary .. "--" .. CRLF

    return table.concat(parts)
end

local function decodeResponse(body)
    if type(body) ~= "string" or body == "" then
        return nil, "Response kosong."
    end

    local ok, data = pcall(function()
        return HttpService:JSONDecode(body)
    end)

    if not ok then
        return nil, "Response bukan JSON: " .. tostring(body):sub(1, 300)
    end

    return data
end

local function uploadRequest(apiKey, creatorId, creatorType, assetType, fileName, fileData)
    local displayName = fileName:gsub("%.rbxm$", ""):gsub("%.rbxmx$", "")

    local payload = {
        assetType = assetType,
        displayName = displayName,
        description = "Uploaded via HYAZ RBXM > ASSET ID",
        creationContext = {
            creator = creatorType == "Group"
                and { groupId = creatorId }
                or { userId = creatorId }
        }
    }

    local boundary = makeBoundary()
    local body = multipartBody(
        boundary,
        HttpService:JSONEncode(payload),
        fileName,
        fileData
    )

    local response, err = executorRequest({
        Url = API_URL,
        Method = "POST",
        Headers = {
            ["x-api-key"] = apiKey,
            ["Content-Type"] = "multipart/form-data; boundary=" .. boundary,
            ["User-Agent"] = "HYAZ-RBXM-ASSET-ID"
        },
        Body = body
    })

    if not response then
        return nil, err or "HTTP request gagal."
    end

    local status = tonumber(response.StatusCode or response.Status or 0) or 0
    local data, jsonErr = decodeResponse(response.Body)

    if not data then
        return nil, jsonErr
    end

    if status < 200 or status >= 300 then
        return nil, tostring(data.message or data.error or ("HTTP " .. status))
    end

    if not data.path then
        return nil, "Open Cloud tidak mengembalikan operation path."
    end

    return data
end

local function pollOperation(path, apiKey, logFn)
    for attempt = 1, 20 do
        local response, err = executorRequest({
            Url = "https://apis.roblox.com/assets/v1/" .. tostring(path),
            Method = "GET",
            Headers = {
                ["x-api-key"] = apiKey,
                ["User-Agent"] = "HYAZ-RBXM-ASSET-ID"
            }
        })

        if not response then
            return nil, err or "Polling request gagal."
        end

        local data, jsonErr = decodeResponse(response.Body)
        if not data then
            return nil, jsonErr
        end

        if data.done then
            if data.response and data.response.assetId then
                return tostring(data.response.assetId)
            end

            if data.error then
                return nil, tostring(data.error.message or data.error.code or "Operation error")
            end

            return nil, "Operation selesai tetapi Asset ID tidak ditemukan."
        end

        if logFn then
            logFn("Menunggu operation... " .. attempt .. "/20")
        end

        task.wait(1.5)
    end

    return nil, "Timeout menunggu proses upload."
end

