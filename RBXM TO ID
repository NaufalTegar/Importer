        log("ERROR: listfiles() tidak tersedia di executor.")
        log("Tanpa listfiles(), script tidak dapat membaca workspace.")
        FileCount.Text = "listfiles() tidak tersedia"
        ScanBtn.Text = "🔄  SCAN"
        return
    end

    task.spawn(function()
        local ok, found, openedPaths, rootStats = pcall(scanWorkspace)

        if not ok then
            entries = {}
            FileCount.Text = "Scanner error"
            log("ERROR scanner: " .. tostring(found))
            ScanBtn.Text = "🔄  SCAN"
            return
        end

        entries = type(found) == "table" and found or {}

        for _, entry in ipairs(entries) do
            entry.selected = false
        end

        FileCount.Text = string.format("%d file .rbxm/.rbxmx ditemukan", #entries)
        updateSelectedBox()

        if type(openedPaths) == "table" and #openedPaths > 0 then
            log("Root filesystem terbaca: " .. tostring(#openedPaths))

            -- Show which roots actually produced RBXM files.
            local shown = 0
            for root, count in pairs(rootStats or {}) do
                if count > 0 and shown < 3 then
                    log("FOUND " .. tostring(count) .. " file: " .. root)
                    shown += 1
                end
            end
        else
            log("ERROR: tidak ada root filesystem yang bisa dibaca.")
            log("Pastikan listfiles() tersedia di Delta.")
        end

        if #entries > 0 then
            log("Scan OK: " .. #entries .. " file ditemukan.")
            log("Tekan PILIH 1 FILE.")
        else
            log("0 RBXM ditemukan dari semua root.")
            log("Scanner sekarang mencoba /storage/emulated/0 + /sdcard.")
        end

        ScanBtn.Text = "🔄  SCAN"
    end)
end)

--==============================================================
-- UPLOAD ONE SELECTED FILE ONLY
--==============================================================

local function uploadOne(entry)
    entry.status = "pending"
    updateSelectedBox()

    local apiKey = KeyBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
    local creatorId = CreatorBox.Text:gsub("^%s+", ""):gsub("%s+$", "")

    local data = safeReadFile(entry.path)
    if not data or #data == 0 then
        entry.status = "ERR"
        updateSelectedBox()
        log(entry.name .. ": readfile gagal.")
        return false
    end

    log("Uploading 1 file: " .. entry.name)

    local op, err = uploadRequest(
        apiKey,
        creatorId,
        creatorType,
        assetType,
        entry.name,
        data
    )

    if not op then
        entry.status = "ERR"
        updateSelectedBox()
        log(entry.name .. ": " .. tostring(err))
        return false
    end

    local assetId, pollErr = pollOperation(op.path, apiKey, log)

    if not assetId then
        entry.status = "ERR"
        updateSelectedBox()
        log(entry.name .. ": " .. tostring(pollErr))
        return false
    end

    entry.status = "OK"
    entry.assetId = assetId
    updateSelectedBox()
    log(entry.name .. ": OK -> " .. assetId)

    return true
end

UploadBtn.MouseButton1Click:Connect(function()
    if busy then return end

    local apiKey = KeyBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
    local creatorId = CreatorBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
    local entry = selectedEntry()

    if apiKey == "" then
        log("ERROR: Isi API Key terlebih dahulu.")
        return
    end

    if creatorId == "" or not creatorId:match("^%d+$") then
        log("ERROR: Creator ID harus berupa angka.")
        return
    end

    if not entry then
        log("ERROR: Pilih satu file terlebih dahulu.")
        return
    end

    busy = true
    UploadBtn.Text = "UPLOADING 1 FILE..."
    UploadBtn.BackgroundColor3 = Theme.pending

    task.spawn(function()
        local ok = uploadOne(entry)

        busy = false
        UploadBtn.Text = "UPLOAD FILE TERPILIH"
        UploadBtn.BackgroundColor3 = Theme.panel2

        if ok then
            log("Upload selesai: " .. entry.name)
        else
            log("Upload gagal: " .. entry.name)
        end
    end)
end)

