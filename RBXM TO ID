--==============================================================
-- UPLOAD ONE SELECTED FILE ONLY
--==============================================================

local function uploadOne(entry)
    entry.status = "pending"
    updateSelectedBox()

    local apiKey = KeyBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
    local creatorId = CreatorBox.Text:gsub("^%s+", ""):gsub("%s+$", "")

    local data = safeReadFile(entry.path)
    if not data or #data == 0 then
        entry.status = "ERR"
        updateSelectedBox()
        log(entry.name .. ": readfile gagal.")
        return false
    end

    log("Uploading 1 file: " .. entry.name)

    local op, err = uploadRequest(
        apiKey,
        creatorId,
        creatorType,
        assetType,
        entry.name,
        data
    )

    if not op then
        entry.status = "ERR"
        updateSelectedBox()
        log(entry.name .. ": " .. tostring(err))
        return false
    end

    local assetId, pollErr = pollOperation(op.path, apiKey, log)

    if not assetId then
        entry.status = "ERR"
        updateSelectedBox()
        log(entry.name .. ": " .. tostring(pollErr))
        return false
    end

    entry.status = "OK"
    entry.assetId = assetId
    updateSelectedBox()
    log(entry.name .. ": OK -> " .. assetId)

    return true
end

UploadBtn.MouseButton1Click:Connect(function()
    if busy then return end

    local apiKey = KeyBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
    local creatorId = CreatorBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
    local entry = selectedEntry()

    if apiKey == "" then
        log("ERROR: Isi API Key terlebih dahulu.")
        return
    end

    if creatorId == "" or not creatorId:match("^%d+$") then
        log("ERROR: Creator ID harus berupa angka.")
        return
    end

    if not entry then
        log("ERROR: Pilih satu file terlebih dahulu.")
        return
    end

    busy = true
    UploadBtn.Text = "UPLOADING 1 FILE..."
    UploadBtn.BackgroundColor3 = Theme.pending

    task.spawn(function()
        local ok = uploadOne(entry)

        busy = false
        UploadBtn.Text = "UPLOAD FILE TERPILIH"
        UploadBtn.BackgroundColor3 = Theme.panel2

        if ok then
            log("Upload selesai: " .. entry.name)
        else
            log("Upload gagal: " .. entry.name)
        end
    end)
end)

