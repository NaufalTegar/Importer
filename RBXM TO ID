-- Delta Android filesystem roots.
-- These are based on the working filesystem scanner used by the
-- supplied HYAZ importer, including Android's actual shared-storage paths.
local SCAN_PATHS = {
    "/storage/emulated/0/Delta/workspace",
    "/storage/emulated/0/Android/Delta/workspace",
    "/sdcard/Delta/workspace",
    "/sdcard/Android/Delta/workspace",

    "emulator/android/delta/workspace",
    "emulator/Android/Delta/workspace",
    "emulator/android/Delta/workspace",
    "Emulator/Android/Delta/workspace",

    "Delta/workspace",
