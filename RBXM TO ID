-- Safe executor bootstrap.
-- Do not call game:IsLoaded()/game.Loaded before the UI exists: some
-- mobile executor environments expose these differently during injection.

local function svc(name)
    local ok, result = pcall(function()
        return game:GetService(name)
    end)
    if ok then
        return result
    end
    return nil
end

