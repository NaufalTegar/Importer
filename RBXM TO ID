    error("HYAZ: Players service is unavailable in this executor.")
end

local LocalPlayer = Players.LocalPlayer
if not LocalPlayer then
    error("HYAZ: LocalPlayer is unavailable. Execute after joining the game.")
end

local GuiParent = nil
