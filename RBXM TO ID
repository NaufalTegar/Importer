local function uploadOne(entry)
    entry.status = "pending"
    renderFiles()

    local apiKey = KeyBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
    local creatorId = CreatorBox.Text:gsub("^%s+", ""):gsub("%s+$", "")

    local data = safeReadFile(entry.path)
    if not data or #data == 0 then
        entry.status = "ERR"
        renderFiles()
        log(entry.name .. ": readfile gagal.")
        return false
    end

    log("Uploading: " .. entry.name)

    local op, err = uploadRequest(
        apiKey,
        creatorId,
        creatorType,
        assetType,
        entry.name,
        data
    )

    if not op then
        entry.status = "ERR"
        renderFiles()
        log(entry.name .. ": " .. tostring(err))
        return false
    end

    local assetId, pollErr = pollOperation(op.path, apiKey, log)

    if not assetId then
        entry.status = "ERR"
        renderFiles()
        log(entry.name .. ": " .. tostring(pollErr))
        return false
    end

    entry.status = "OK"
    entry.assetId = assetId
    renderFiles()
    log(entry.name .. ": OK -> " .. assetId)

    return true
end

UploadBtn.MouseButton1Click:Connect(function()
    if busy then return end

    local apiKey = KeyBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
    local creatorId = CreatorBox.Text:gsub("^%s+", ""):gsub("%s+$", "")

    if apiKey == "" then
        log("ERROR: Isi API Key terlebih dahulu.")
        return
    end

    if creatorId == "" or not creatorId:match("^%d+$") then
        log("ERROR: Creator ID harus berupa angka.")
        return
    end

    if #entries == 0 then
        log("ERROR: Scan workspace terlebih dahulu.")
        return
    end

    busy = true
    UploadBtn.Text = "UPLOADING..."
    UploadBtn.BackgroundColor3 = Theme.pending

    task.spawn(function()
        local success = 0
        local failed = 0

        for _, entry in ipairs(entries) do
            if entry.status ~= "OK" then
                if uploadOne(entry) then
                    success += 1
                else
                    failed += 1
                end
                task.wait(0.2)
            end
        end

        busy = false
        UploadBtn.Text = "UPLOAD ALL"
        UploadBtn.BackgroundColor3 = Theme.panel2

        log(string.format("Selesai. OK: %d | ERR: %d", success, failed))
    end)
end)

