    else
        SelectedBox.Text = "✓  " .. entry.name
        SelectedBox.TextColor3 = Theme.text
    end
end

local function closePicker()
    PickerOverlay.Visible = false
end

local function chooseEntry(entry)
    for _, e in ipairs(entries) do
        e.selected = false
    end

    entry.selected = true
    updateSelectedBox()
    closePicker()
    log("Dipilih: " .. entry.name)
end

local function renderPicker()
    for _, child in ipairs(PickerList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    PickerEmpty.Visible = #entries == 0

    for _, entry in ipairs(entries) do
        local button = new("TextButton", {
            BackgroundColor3 = entry.selected and Color3.fromRGB(48, 42, 30) or Theme.panel2,
            Size = UDim2.new(1, 0, 0, 40),
            Text = "  " .. entry.name,
            Font = Enum.Font.Code,
            TextColor3 = entry.selected and Theme.accent or Theme.text,
            TextSize = 10,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            AutoButtonColor = false,
            ZIndex = 53
        }, PickerList)

        new("UICorner", {CornerRadius = UDim.new(0, 6)}, button)

        button.MouseButton1Click:Connect(function()
            chooseEntry(entry)
        end)
    end

    task.defer(function()
        PickerList.CanvasSize = UDim2.fromOffset(0, PickerLayout.AbsoluteContentSize.Y + 12)
    end)
end

PickBtn.MouseButton1Click:Connect(function()
    if busy then return end

    if #entries == 0 then
        log("Belum ada file. Tekan SCAN terlebih dahulu.")
        return
    end

    renderPicker()
    PickerOverlay.Visible = true
end)

