    local ok, playerGui = pcall(function()
        return LocalPlayer:FindFirstChildOfClass("PlayerGui")
    end)

    if ok and playerGui then
        GuiParent = playerGui
    else
        GuiParent = LocalPlayer:WaitForChild("PlayerGui", 10)
    end
end

