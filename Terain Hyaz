--==============================================================
-- FUNGSI TERRAIN
--==============================================================

local CELL_SIZE = 4 -- ukuran voxel terrain (4 stud)

-- Konversi posisi world ke cell coordinate
local function worldToCell(pos)
	return Vector3.new(
		math.floor(pos.X / CELL_SIZE),
		math.floor(pos.Y / CELL_SIZE),
		math.floor(pos.Z / CELL_SIZE)
	)
end

-- Konversi cell coordinate ke posisi world
local function cellToWorld(cell)
	return Vector3.new(
		cell.X * CELL_SIZE + CELL_SIZE / 2,
		cell.Y * CELL_SIZE + CELL_SIZE / 2,
		cell.Z * CELL_SIZE + CELL_SIZE / 2
	)
end

-- Dapatkan part yang dipilih
local function getSelectedParts()
	local selected = Selection:Get()
	local parts = {}
	for _, obj in ipairs(selected) do
		if obj:IsA("BasePart") then
			table.insert(parts, obj)
		end
	end
	return parts
end

-- Lukis terrain pada satu cell
local function paintCell(cellPos, material)
	local worldPos = cellToWorld(cellPos)

	if TOOL_MODE == "Eraser" and ERASER_ENABLED then
		-- Hapus terrain
		local matHere = Terrain:GetMaterial(worldPos)
		if matHere ~= Enum.Material.Air then
			Terrain:SetMaterial(worldPos, Enum.Material.Air)
			Terrain:SetCell(worldPos, Enum.CellMaterial.Empty, Enum.Material.Air)
		end
	else
		-- Lukis terrain
		local matEnum = Enum.Material[material] or Enum.Material.Grass
		Terrain:SetMaterial(worldPos, matEnum)
		Terrain:SetCell(worldPos, Enum.CellMaterial.Solid, matEnum)
	end
end

-- Konversi Part ke Terrain
local function convertPartsToTerrain(parts)
	if #parts == 0 then
		statusLabel.Text = "❌ Tidak ada part dipilih!"
		task.wait(2)
		statusLabel.Text = "✅ Pilih Part di Workspace"
		return
	end

	statusLabel.Text = "⏳ Mengkonversi..."

	local terrainData = {}

	-- Kumpulkan semua cell yang akan di-paint
	local cells = {}

	for _, part in ipairs(parts) do
		local cf = part.CFrame
		local size = part.Size
		local material = part.Material.Name

		table.insert(terrainData, {
			Position = cf.Position,
			Size = size,
			Material = material
		})

		-- Hitung bounding box dalam cell coordinates
		local minWorld = cf.Position - size / 2
		local maxWorld = cf.Position + size / 2

		local minCell = worldToCell(minWorld)
		local maxCell = worldToCell(maxWorld)

		for x = minCell.X, maxCell.X do
			for y = minCell.Y, maxCell.Y do
				for z = minCell.Z, maxCell.Z do
					local cellPos = Vector3.new(x, y, z)
					cells[cellPos] = true
				end
			end
		end

		-- Tandai part agar bisa dihapus
		part:SetAttribute("TerrainConverted", true)
	end

	-- Lukis semua cell
	local count = 0
	for cellPos in pairs(cells) do
		paintCell(cellPos, SELECTED_MATERIAL)
		count += 1
	end

	-- Buat server script yang akan membangun ulang terrain saat server start
	local serverScript = Instance.new("Script")
	serverScript.Name = "TerrainBuilder_Generated"
	serverScript.Source = [[
-- Generated by Terrain Editor Pro
local Terrain = workspace:WaitForChild("Terrain")

local function build()
	-- Muat ulang dari tempat kita simpan (di ReplicatedStorage)
	local data = script:FindFirstChild("TerrainData")
	if data then
		local terrainData = require(data)
		for _, cell in ipairs(terrainData) do
			Terrain:SetMaterial(cell.Position, cell.Material)
			Terrain:SetCell(cell.Position, Enum.CellMaterial.Solid, cell.Material)
		end
		print("✅ Terrain dibangun ulang dari " .. #terrainData .. " cell")
	end
end

build()
]]

	serverScript.Parent = ReplicatedStorage

	-- Simpan data cell ke ModuleScript
	local dataModule = Instance.new("ModuleScript")
	dataModule.Name = "TerrainData"
	dataModule.Source = "return " .. require(script.Parent:FindFirstChild("_TerrainBuilder").TerrainData) -- skip

	-- Simpan data cell ke atribut
	local serializedData = {}
	for cellStr in pairs(cells) do
		local cellPos = Vector3.new()
		-- parse string dari key
		local px, py, pz = string.match(cellStr, "(%d+) (%d+) (%d+)")
		if px and py and pz then
			table.insert(serializedData, {
