local allCards = {}
local loadedCount = 0
local failedCount = 0
local scanSerial = 0

local function updateFooter(message, color)
    FooterText.Text = message
    FooterText.TextColor3 = color or Theme.muted
end

local function clearList()
    for _, child in ipairs(List:GetChildren()) do
        if child:IsA("Frame") and child ~= Empty then child:Destroy() end
    end
    table.clear(allCards)
    Empty.Visible = true
end

local function refreshFilter()
    local q = string.lower(Search.Text or "")
    local visible = 0
    for _, entry in ipairs(allCards) do
        local name = string.lower(entry.name)
        local path = string.lower(entry.path)
        local show = q == "" or string.find(name,q,1,true) or string.find(path,q,1,true)
        entry.card.Visible = show
        if show then visible += 1 end
    end
    Empty.Visible = (#allCards == 0) or (visible == 0)
    if #allCards == 0 then
        EmptyLabel.Text = "No files detected yet.\nPress SCAN RBXL to search."
    elseif visible == 0 then
        EmptyLabel.Text = "No matching files.\nTry another search."
    end
end

local function addFileRow(path)
    local row = Instance.new("Frame")
    row.Name = "FileCard"
    row.Size = UDim2.new(1,-6,0,64)
    row.BackgroundColor3 = Theme.panel
    row.BorderSizePixel = 0
    row.Parent = List
    round(row,10)
    stroke(row,Theme.border,1,0.35)

    local typeBadge = Instance.new("Frame")
    typeBadge.Size = UDim2.fromOffset(44,24)
    typeBadge.Position = UDim2.fromOffset(9,20)
    typeBadge.BackgroundColor3 = Color3.fromRGB(31,52,82)
    typeBadge.BorderSizePixel = 0
    typeBadge.Parent = row
    round(typeBadge,7)
    local typeText = makeLabel(typeBadge,"RBXL",UDim2.fromScale(1,1),UDim2.fromOffset(0,0),Enum.Font.GothamBold,7,Color3.fromRGB(205,220,245))
    typeText.TextXAlignment = Enum.TextXAlignment.Center

    local name = path:match("([^/\\]+)$") or path
    local title = makeLabel(row,name,UDim2.new(1,-145,0,22),UDim2.fromOffset(62,7),Enum.Font.GothamBold,9,Theme.text)
    title.TextTruncate = Enum.TextTruncate.AtEnd
    local sub = makeLabel(row,path,UDim2.new(1,-145,0,18),UDim2.fromOffset(62,31),Enum.Font.Gotham,7,Theme.muted)
    sub.TextTruncate = Enum.TextTruncate.AtEnd

    local Import = Instance.new("TextButton")
    Import.Size = UDim2.fromOffset(72,32)
    Import.Position = UDim2.new(1,-82,0.5,-16)
    Import.BackgroundColor3 = Theme.blue
    Import.BorderSizePixel = 0
    Import.Text = "IMPORT"
    Import.TextColor3 = Color3.fromRGB(230,238,255)
    Import.Font = Enum.Font.GothamBold
    Import.TextSize = 8
    Import.Parent = row
    round(Import,8)

    Import.Activated:Connect(function()
        Import.Active = false
        Import.Text = "LOADING"
        StatusText.Text = "LOAD"
        StatusText.TextColor3 = Theme.accentSoft
        task.spawn(function()
            local callOk, importOk, msg = pcall(importRBXL, path)
            if callOk and importOk then
                loadedCount += 1
                Import.Text = "DONE"
                Import.BackgroundColor3 = Color3.fromRGB(38,104,70)
                StatusText.Text = "READY"
                StatusText.TextColor3 = Theme.success
                updateFooter(string.format("Ready • Files: %d • Loaded: %d • Failed: %d",#allCards,loadedCount,failedCount),Theme.success)
            else
                failedCount += 1
                Import.Text = "FAIL"
                Import.BackgroundColor3 = Color3.fromRGB(105,35,45)
                StatusText.Text = "ERROR"
                StatusText.TextColor3 = Theme.danger
                updateFooter("Error • "..tostring(msg or importOk),Theme.danger)
            end
            task.wait(1.2)
            if Import.Parent then
                Import.Text = "IMPORT"
                Import.BackgroundColor3 = Theme.blue
                Import.Active = true
            end
        end)
    end)

    Empty.Visible = false
    table.insert(allCards,{card=row,name=name,path=path})
end

local function scanFiles()
    scanSerial += 1
    local myScan = scanSerial
    clearList()
    Search.Text = ""
    Scan.Text = "SCANNING..."
    Scan.Active = false
    StatusText.Text = "SCAN"
    StatusText.TextColor3 = Theme.accentSoft
    updateFooter("Scanning Delta/workspace for .rbxl...",Theme.accentSoft)

    task.spawn(function()
        local ok, files = pcall(collectRBXL)
        if myScan ~= scanSerial then return end
        if not ok or type(files) ~= "table" then
            Scan.Text = "SCAN RBXL"
            Scan.Active = true
            StatusText.Text = "ERROR"
            StatusText.TextColor3 = Theme.danger
            updateFooter("Scan gagal: "..tostring(files),Theme.danger)
            return
        end
        for _, path in ipairs(files) do
            addFileRow(path)
        end
        Scan.Text = "SCAN RBXL"
        Scan.Active = true
        StatusText.Text = "READY"
        StatusText.TextColor3 = Theme.success
        if #files == 0 then
            updateFooter("Ready • Tidak ada .rbxl di Delta/workspace",Theme.muted)
        else
            updateFooter(string.format("Ready • Files: %d • Loaded: %d • Failed: %d",#files,loadedCount,failedCount),Theme.muted)
        end
        refreshFilter()
    end)
end

Search:GetPropertyChangedSignal("Text"):Connect(refreshFilter)
Scan.Activated:Connect(scanFiles)

-- First scan automatically, same behavior as the original importer.
scanFiles()

