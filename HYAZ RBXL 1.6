-- RBXM FILE PARSER (LZ4 + Binary Format)
--                                                                        
local function Buffer(str, allowOverflows)
    local Stream = { Offset = 0, Source = str, Length = string.len(str), AllowOverflows = (allowOverflows == nil and true) or allowOverflows }
    function Stream:read(len, shift)
        len = len or 1; shift = (shift == nil and true) or shift
        local dat = string.sub(self.Source, self.Offset + 1, self.Offset + len)
        if shift then self:seek(len) end
        return dat
    end
    function Stream:seek(len) self.Offset = math.clamp(self.Offset + len, 0, self.Length) end
    function Stream:readNumber(fmt, shift)
        fmt = fmt or "I1"; local chunk = self:read(string.packsize(fmt), shift); return string.unpack(fmt, chunk)
    end
    function Stream:append(s) self.Source = self.Source .. s; self.Length = #self.Source end
    function Stream:toEnd() self.Offset = self.Length end
    return Stream
end

local function transformInt(x) return (x % 2 == 0) and (x / 2) or (-(x + 1) / 2) end
local function rbxF32(x) x = bit32.rrotate(x, 1); return string.unpack(">f", string.pack(">I4", x)) end

local basicTypes = {}
function basicTypes.String(buffer) return buffer:read(buffer:readNumber("<I4")) end
function basicTypes.Int32(buffer) return transformInt(buffer:readNumber(">I4")) end
function basicTypes.Int64(buffer) return transformInt(buffer:readNumber(">I8")) end
function basicTypes.Float32(buffer) return rbxF32(buffer:readNumber(">I4")) end
function basicTypes.Float64(buffer) return buffer:readNumber("<d") end

function basicTypes.InterleaveArrayWithSize(buffer, count, sizeof)
    if count < 0 then return Buffer("", false) end
    local stream = buffer:read(count * sizeof); local out = table.create(count)
    for i = 1, count do
        local chunk = table.create(sizeof)
        for s = 0, sizeof - 1 do
            local bitPos = i + (count * s); chunk[s+1] = string.sub(stream, bitPos, bitPos)
        end
        out[i] = table.concat(chunk)
    end
    return Buffer(table.concat(out), false)
end

function basicTypes.unsignedIntArray(buffer, count)
    if count < 1 then return {} end
    local o = table.create(count); local strings = basicTypes.InterleaveArrayWithSize(buffer, count, 4)
    for i = 1, count do o[i] = strings:readNumber("<I4") end
    return o
end

function basicTypes.Int32Array(buffer, count)
    if count < 1 then return {} end
    local o = table.create(count); local strings = basicTypes.InterleaveArrayWithSize(buffer, count, 4)
    for i = 1, count do o[i] = basicTypes.Int32(strings) end
    return o
end

function basicTypes.Int64Array(buffer, count)
    if count < 1 then return {} end
    local o = table.create(count); local strings = basicTypes.InterleaveArrayWithSize(buffer, count, 8)
    for i = 1, count do o[i] = basicTypes.Int64(strings) end
    return o
end

function basicTypes.RbxF32Array(buffer, count)
    if count < 1 then return {} end
    local o = table.create(count); local strings = basicTypes.InterleaveArrayWithSize(buffer, count, 4)
    for i = 1, count do o[i] = basicTypes.Float32(strings) end
    return o
end

function basicTypes.RefArray(buffer, count)
    if count < 1 then return {} end
    local o = table.create(count); local refs = basicTypes.Int32Array(buffer, count); local last = 0
    for i = 1, count do local ref = last + refs[i]; o[i] = ref; last = ref end
    return o
end

local function lz4(lz4data)
    local inputStream = Buffer(lz4data)
    local compressedLen = string.unpack("<I4", inputStream:read(4))
    local decompressedLen = string.unpack("<I4", inputStream:read(4))
    local reserved = string.unpack("<I4", inputStream:read(4))
    if reserved ~= 0 then error("not lz4") end
    if compressedLen == 0 then return inputStream:read(decompressedLen) end
    local outputStream = Buffer("")
    repeat
        local token = string.byte(inputStream:read())
        local litLen = bit32.rshift(token, 4)
        local matLen = bit32.band(token, 15) + 4
        if litLen >= 15 then
            repeat local nextByte = string.byte(inputStream:read()); litLen = litLen + nextByte until nextByte ~= 0xFF
        end
        local literal = inputStream:read(litLen); outputStream:append(literal); outputStream:toEnd()
        if outputStream.Length < decompressedLen then
            local offset = string.unpack("<I2", inputStream:read(2))
            if matLen >= 19 then
                repeat local nextByte = string.byte(inputStream:read()); matLen = matLen + nextByte until nextByte ~= 0xFF
            end
            outputStream:seek(-offset)
            local pos = outputStream.Offset; local match = outputStream:read(matLen)
            local unreadBytes = outputStream.LastUnreadBytes or 0
            local extra
            if unreadBytes then
                repeat
                    outputStream.Offset = pos; extra = outputStream:read(unreadBytes)
                    unreadBytes = outputStream.LastUnreadBytes or 0; match = match .. extra
                until unreadBytes <= 0
            end
            outputStream:append(match); outputStream:toEnd()
        end
    until outputStream.Length >= decompressedLen
    return outputStream.Source
end

local function b64encode(str)
    local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local out = {}
    for i = 1, #str, 3 do
        local b0, b1, b2 = string.byte(str, i, i+2)
        local b = bit32.lshift(b0, 16) + bit32.lshift(b1 or 0, 8) + (b2 or 0)
        table.insert(out, chars:sub(bit32.extract(b, 18, 6)+1, bit32.extract(b, 18, 6)+1))
        table.insert(out, chars:sub(bit32.extract(b, 12, 6)+1, bit32.extract(b, 12, 6)+1))
        table.insert(out, b1 and chars:sub(bit32.extract(b, 6, 6)+1, bit32.extract(b, 6, 6)+1) or "=")
        table.insert(out, b2 and chars:sub(bit32.band(b, 63)+1, bit32.band(b, 63)+1) or "=")
    end
    return table.concat(out)
end

local function _bytesToString(v)
    if type(v) == "string" then return v end
    local ok, out = pcall(function()
        if type(buffer) == "table" and type(buffer.tostring) == "function" then
            return buffer.tostring(v)
        end
        return nil
    end)
    if ok and type(out) == "string" then return out end
    local ok2, out2 = pcall(function()
        if type(buffer) == "table" and type(buffer.len) == "function" and type(buffer.readu8) == "function" then
            local n = buffer.len(v)
            local parts = table.create(math.ceil(n / 4096))
            local k = 0
            for i = 0, n - 1, 4096 do
                local e = math.min(n - 1, i + 4095)
                local chars = table.create(e - i + 1)
                for j = i, e do chars[j - i + 1] = string.char(buffer.readu8(v, j)) end
                k += 1
                parts[k] = table.concat(chars)
            end
            return table.concat(parts)
        end
        return nil
    end)
    if ok2 and type(out2) == "string" then return out2 end
    return nil
end

local function _zstdViaEncodingService(data)
    local ok, result = pcall(function()
        local EncodingService = game:GetService("EncodingService")
        local CompressionAlgorithm = Enum.CompressionAlgorithm
        if type(buffer) ~= "table" or type(buffer.fromstring) ~= "function" then error("buffer API unavailable") end
        if not CompressionAlgorithm or not CompressionAlgorithm.Zstd then error("Zstd enum unavailable") end
        local compressed = buffer.fromstring(data)
        local decoded = EncodingService:DecompressBuffer(compressed, CompressionAlgorithm.Zstd)
        local text = _bytesToString(decoded)
        if not text then error("failed to convert decompressed buffer") end
        return text
    end)
    return ok and result or nil
end

local function _zstdViaJSON(data)
    local zbase64 = b64encode(data)
    local ok, result = pcall(function()
        local x = HttpService:JSONDecode('{"m":null,"t":"buffer","zbase64":"' .. zbase64 .. '"}')
        local text = _bytesToString(x)
        if not text then error("JSONDecode returned a buffer but this runtime has no buffer->string bridge") end
        return text
    end)
    return ok and result or nil
end

local function zstd(stream)
    local out = _zstdViaEncodingService(stream)
    if out then return out end
    out = _zstdViaJSON(stream)
    if out then return out end
    error("ZSTD decompressor tidak tersedia/compatible di environment ini")
end

local function _readVector3(buffer, count)
    local xs = basicTypes.RbxF32Array(buffer, count)
    local ys = basicTypes.RbxF32Array(buffer, count)
    local zs = basicTypes.RbxF32Array(buffer, count)
    local out = table.create(count)
    for i = 1, count do out[i] = Vector3.new(xs[i], ys[i], zs[i]) end
    return out
end

local function _readColor3(buffer, count)
    local rs = basicTypes.RbxF32Array(buffer, count)
    local gs = basicTypes.RbxF32Array(buffer, count)
    local bs = basicTypes.RbxF32Array(buffer, count)
    local out = table.create(count)
    for i = 1, count do out[i] = Color3.new(rs[i], gs[i], bs[i]) end
    return out
end

local function _readVector2(buffer, count)
    local xs = basicTypes.RbxF32Array(buffer, count)
    local ys = basicTypes.RbxF32Array(buffer, count)
    local out = table.create(count)
    for i = 1, count do out[i] = Vector2.new(xs[i], ys[i]) end
    return out
end

local function _readCFrames(buffer, count)
    local ids = table.create(count)
    local rot = table.create(count)
    for i = 1, count do
        local id = string.byte(buffer:read())
        ids[i] = id
        if id == 0 then
            local m = table.create(9)
            for j = 1, 9 do m[j] = buffer:readNumber("<f") end
            rot[i] = m
        end
    end
    local pos = _readVector3(buffer, count)
    -- RBXL rotation IDs are exact matrices. Do not reconstruct them with
    -- CFrame.Angles(), because Roblox's matrix order is part of the format.
    local function M(a,b,c,d,e,f,g,h,i)
        return CFrame.new(0,0,0,a,b,c,d,e,f,g,h,i)
    end
    local special = {
        [0x02]=M(1,0,0,0,1,0,0,0,1),
        [0x03]=M(1,0,0,0,0,-1,0,1,0),
        [0x05]=M(1,0,0,0,-1,0,0,0,-1),
        [0x06]=M(1,0,0,0,0,1,0,-1,0),
        [0x07]=M(0,1,0,1,0,0,0,0,-1),
        [0x09]=M(0,0,1,1,0,0,0,1,0),
        [0x0A]=M(0,-1,0,1,0,0,0,0,1),
        [0x0C]=M(0,0,-1,1,0,0,0,-1,0),
        [0x0D]=M(0,1,0,0,0,1,1,0,0),
        [0x0E]=M(0,0,-1,0,1,0,1,0,0),
        [0x10]=M(0,-1,0,0,0,-1,1,0,0),
        [0x11]=M(0,0,1,0,-1,0,1,0,0),
        [0x14]=M(-1,0,0,0,1,0,0,0,-1),
        [0x15]=M(-1,0,0,0,0,1,0,1,0),
        [0x17]=M(-1,0,0,0,-1,0,0,0,1),
        [0x18]=M(-1,0,0,0,0,-1,0,-1,0),
        [0x19]=M(0,1,0,-1,0,0,0,0,1),
        [0x1B]=M(0,0,-1,-1,0,0,0,1,0),
        [0x1C]=M(0,-1,0,-1,0,0,0,0,-1),
        [0x1E]=M(0,0,1,-1,0,0,0,-1,0),
        [0x1F]=M(0,1,0,0,0,-1,-1,0,0),
        [0x20]=M(0,0,1,0,1,0,-1,0,0),
        [0x22]=M(0,-1,0,0,0,1,-1,0,0),
        [0x23]=M(0,0,-1,0,-1,0,-1,0,0),
    }
    local out = table.create(count)
    for i = 1, count do
        local p = pos[i]
        if ids[i] ~= 0 then out[i] = CFrame.new(p) * (special[ids[i]] or CFrame.new())
        else
            local m = rot[i]
            out[i] = CFrame.new(p.X,p.Y,p.Z,m[1],m[2],m[3],m[4],m[5],m[6],m[7],m[8],m[9])
        end
    end
    return out
end

local function _readUDim(buffer)
    local scale = basicTypes.Float32(buffer)
    local offset = basicTypes.Int32(buffer)
    return UDim.new(scale, offset)
end

local function _readUDim2(buffer, count)
    local xs = table.create(count)
    local xo = table.create(count)
    local ys = table.create(count)
    local yo = table.create(count)

    for i = 1, count do xs[i] = basicTypes.Float32(buffer) end
    for i = 1, count do xo[i] = basicTypes.Int32(buffer) end
    for i = 1, count do ys[i] = basicTypes.Float32(buffer) end
    for i = 1, count do yo[i] = basicTypes.Int32(buffer) end

    local out = table.create(count)
    for i = 1, count do
        out[i] = UDim2.new(xs[i], xo[i], ys[i], yo[i])
    end
    return out
end

local function _readRectArray(buffer, count)
    local minv = _readVector2(buffer, count)
    local maxv = _readVector2(buffer, count)
    local out = table.create(count)
    for i = 1, count do
        out[i] = Rect.new(minv[i], maxv[i])
    end
    return out
end

local function _readFaces(buffer, count)
    local out = table.create(count)
    for i = 1, count do
        out[i] = {
            Right = string.byte(buffer:read()) ~= 0,
            Top = string.byte(buffer:read()) ~= 0,
            Back = string.byte(buffer:read()) ~= 0,
            Left = string.byte(buffer:read()) ~= 0,
            Bottom = string.byte(buffer:read()) ~= 0,
            Front = string.byte(buffer:read()) ~= 0,
        }
    end
    return out
end

local function _readAxes(buffer, count)
    local out = table.create(count)
    for i = 1, count do
        out[i] = {
            X = string.byte(buffer:read()) ~= 0,
            Y = string.byte(buffer:read()) ~= 0,
            Z = string.byte(buffer:read()) ~= 0,
        }
    end
    return out
end

local function _readBrickColor(buffer, count)
    local ids = basicTypes.unsignedIntArray(buffer, count)
    local out = table.create(count)
    for i = 1, count do
        local ok, value = pcall(BrickColor.new, ids[i])
        out[i] = ok and value or nil
    end
    return out
end

local function _readEnumArray(buffer, count)
    -- Binary enum values are stored as interleaved unsigned integers.
    return basicTypes.unsignedIntArray(buffer, count)
end

local function _readPhysicalProperties(buffer, count)
    local out = table.create(count)
    for i = 1, count do
        local custom = string.byte(buffer:read()) ~= 0
        if custom then
            out[i] = {
                CustomPhysicalProperties = true,
                Density = buffer:readNumber("<f"),
                Friction = buffer:readNumber("<f"),
                Elasticity = buffer:readNumber("<f"),
                FrictionWeight = buffer:readNumber("<f"),
                ElasticityWeight = buffer:readNumber("<f"),
            }
        else
            out[i] = nil
        end
    end
    return out
end

local function _readColor3uint8(buffer, count)
    local r = table.create(count)
    local g = table.create(count)
    local b = table.create(count)
    for i = 1, count do r[i] = string.byte(buffer:read()) end
    for i = 1, count do g[i] = string.byte(buffer:read()) end
    for i = 1, count do b[i] = string.byte(buffer:read()) end

    local out = table.create(count)
    for i = 1, count do out[i] = Color3.fromRGB(r[i], g[i], b[i]) end
    return out
end

local function _readSecurityCapabilities(buffer, count)
    return basicTypes.unsignedIntArray(buffer, count)
end

local function _decodePropertyArray(buffer, typeID, count, sharedStrings)
    -- Roblox binary property type IDs. Keep unknown types non-fatal so one
    -- unsupported property cannot destroy the entire place import.
    if typeID == 0x01 then
        local a = table.create(count)
        for i = 1, count do a[i] = basicTypes.String(buffer) end
        return a

    elseif typeID == 0x02 then
        local a = table.create(count)
        for i = 1, count do a[i] = string.byte(buffer:read()) ~= 0 end
        return a

    elseif typeID == 0x03 then
        return basicTypes.Int32Array(buffer, count)

    elseif typeID == 0x04 then
        return basicTypes.RbxF32Array(buffer, count)

    elseif typeID == 0x05 then
        local a = table.create(count)
        for i = 1, count do a[i] = basicTypes.Float64(buffer) end
        return a

    elseif typeID == 0x06 then
        return _readUDim(buffer, count)

    elseif typeID == 0x07 then
        return _readUDim2(buffer, count)

    elseif typeID == 0x08 then
        local a = table.create(count)
        for i = 1, count do a[i] = Ray.new(
            Vector3.new(
                buffer:readNumber("<f"),
                buffer:readNumber("<f"),
                buffer:readNumber("<f")
            ),
            Vector3.new(
                buffer:readNumber("<f"),
                buffer:readNumber("<f"),
                buffer:readNumber("<f")
            )
        ) end
        return a

    elseif typeID == 0x09 then
        return _readFaces(buffer, count)

    elseif typeID == 0x0A then
        return _readAxes(buffer, count)

    elseif typeID == 0x0B then
        return _readBrickColor(buffer, count)

    elseif typeID == 0x0C then
        return _readColor3(buffer, count)

    elseif typeID == 0x0D then
        return _readVector2(buffer, count)

    elseif typeID == 0x0E then
        return _readVector3(buffer, count)

    elseif typeID == 0x0F then
        return _readVector2(buffer, count)

    elseif typeID == 0x10 then
        return _readCFrames(buffer, count)

    elseif typeID == 0x11 then
        return _readEnumArray(buffer, count)

    elseif typeID == 0x12 then
        return basicTypes.unsignedIntArray(buffer, count)

    elseif typeID == 0x13 then
        return basicTypes.RefArray(buffer, count)

    elseif typeID == 0x14 then
        local a = table.create(count)
        for i = 1, count do
            a[i] = Vector3int16.new(
                buffer:readNumber("<i2"),
                buffer:readNumber("<i2"),
                buffer:readNumber("<i2")
            )
        end
        return a

    elseif typeID == 0x15 then
        return _readPhysicalProperties(buffer, count)

    elseif typeID == 0x16 then
        return basicTypes.StringArray and basicTypes.StringArray(buffer, count) or
            (function()
                local a = table.create(count)
                for i = 1, count do a[i] = basicTypes.String(buffer) end
                return a
            end)()

    elseif typeID == 0x17 then
        local a = table.create(count)
        for i = 1, count do
            a[i] = NumberRange.new(buffer:readNumber("<f"), buffer:readNumber("<f"))
        end
        return a

    elseif typeID == 0x18 then
        return _readRectArray(buffer, count)

    elseif typeID == 0x19 then
        return _readPhysicalProperties(buffer, count)

    elseif typeID == 0x1A then
        return _readColor3uint8(buffer, count)

    elseif typeID == 0x1B then
        return basicTypes.Int64Array(buffer, count)

    elseif typeID == 0x1C then
        local idx = basicTypes.unsignedIntArray(buffer, count)
        local a = table.create(count)
        for i = 1, count do
            a[i] = sharedStrings and sharedStrings[idx[i]] or nil
        end
        return a

    elseif typeID == 0x1D then
        -- Reserved/engine-specific payload. Do not pretend this is Source.
        -- Preserve the raw bytes only when the surrounding property can be
        -- represented safely; otherwise leave it undecoded.
        return nil

    elseif typeID == 0x1E then
        return _readSecurityCapabilities(buffer, count)

    elseif typeID == 0x1F then
        local a = table.create(count)
        for i = 1, count do
            a[i] = {
                Index = buffer:readNumber("<I4"),
                Time = buffer:readNumber("<I4"),
                Random = buffer:readNumber("<I8"),
            }
        end
        return a

    elseif typeID == 0x20 then
        local a = table.create(count)
        for i = 1, count do
            a[i] = {
                Family = basicTypes.String(buffer),
                Weight = buffer:readNumber("<I2"),
                Style = string.byte(buffer:read()),
                CachedFaceId = basicTypes.String(buffer),
            }
        end
        return a
    end

    return nil
end

local function parseRBXLBinary(data)
    local r = Buffer(data, false)
    if r:read(14) ~= "<roblox!" .. string.char(137,255,13,10,26,10) then return nil, "RBXL header tidak valid" end
    local version=r:readNumber("<I2"); if version~=0 then return nil,"RBXL version tidak didukung: "..tostring(version) end
    local classCount=r:readNumber("<I4"); local instCount=r:readNumber("<I4"); r:read(8)
    local chunks={META={},SSTR={},INST={},PROP={},PRNT={},SIGN={},["END\0"]={}}
    while r.Offset < r.Length do
        local sig=r:read(4); local compressed=r:readNumber("<I4"); local decompressed=r:readNumber("<I4"); r:read(4)
        if sig=="END\0" then chunks[sig][#chunks[sig]+1]={Data=r:read(decompressed)}; break end
        local payload
        if compressed==0 then payload=r:read(decompressed) else
            local raw=r:read(compressed); local magic=string.sub(raw,1,4)
            if magic==string.char(40,181,47,253) then payload=zstd(raw) else payload=lz4(string.pack("<I4I4I4", compressed, decompressed, 0) .. raw) end
            if #payload ~= decompressed then warn("[Hyaz RBXL] chunk "..sig.." length mismatch: "..#payload.." / "..decompressed) end
        end
        if not chunks[sig] then return nil,"RBXL chunk tidak dikenal: "..sig end
        chunks[sig][#chunks[sig]+1]={Data=payload}
    end
    local shared={}
    for _,ch in ipairs(chunks.SSTR) do local b=Buffer(ch.Data,false); local ver=b:readNumber("<I4"); local n=b:readNumber("<I4"); for i=1,n do
            local hash = b:read(16)
            local value = basicTypes.String(b)
            shared[i] = value
        end end
    local classes={}; local nodes={}; local serviceRefs={}
    for _,ch in ipairs(chunks.INST) do
        local b=Buffer(ch.Data,false); local cid=b:readNumber("<I4"); local cname=basicTypes.String(b); local format=string.byte(b:read()); local n=b:readNumber("<I4"); local refs=basicTypes.RefArray(b,n)
        classes[cid]={Name=cname,Count=n,Refs=refs,IsService=(format==1)}
        local marks={}; if format==1 then for i=1,n do marks[i]=string.byte(b:read())~=0 end end
        for i,ref in ipairs(refs) do nodes[ref]={Ref=ref,ClassId=cid,ClassName=cname,IsService=(format==1),Properties={},Children={},Service=marks[i] or false} end
        if format==1 then for i,ref in ipairs(refs) do serviceRefs[ref]=true end end
    end
    for _,ch in ipairs(chunks.PROP) do
        local b=Buffer(ch.Data,false); local cid=b:readNumber("<I4"); local cls=classes[cid]; if not cls then return nil,"PROP class id tidak ditemukan: "..cid end
        local pname=basicTypes.String(b); local typeID=string.byte(b:read())
        local vals=_decodePropertyArray(b,typeID,cls.Count,shared)
        if vals then
            for i,ref in ipairs(cls.Refs) do
                if nodes[ref] then
                    nodes[ref].Properties[pname]=vals[i]
                    -- Common binary-name aliases used by Roblox objects.
                    if pname == "size" then nodes[ref].Properties.Size = vals[i] end
                    if pname == "shape" then nodes[ref].Properties.Shape = vals[i] end
                    if pname == "Color3uint8" then nodes[ref].Properties.Color3uint8 = vals[i] end
                    if pname == "Source" then nodes[ref].Properties.Source = vals[i] end
                    if pname == "ContentText" then nodes[ref].Properties.ContentText = vals[i] end
                end
            end
        end
    end
    local childToParent={}
    for _,ch in ipairs(chunks.PRNT) do local b=Buffer(ch.Data,false); local ver=string.byte(b:read()); if ver~=0 then return nil,"PRNT version tidak didukung" end; local n=b:readNumber("<I4"); local children=basicTypes.RefArray(b,n); local parents=basicTypes.RefArray(b,n); for i=1,n do childToParent[children[i]]=parents[i] end end
    local roots={}
    for ref,node in pairs(nodes) do
        local p=childToParent[ref]
        if p and p~=-1 and nodes[p] then table.insert(nodes[p].Children,node) else table.insert(roots,node) end
    end
    return {Header={ClassCount=classCount,InstanceCount=instCount},Nodes=nodes,Roots=roots,Services=serviceRefs,SharedStrings=shared}, nil
end

local function createRBXLInstances(parsed, sourceName)
    local folder = Instance.new("Folder")
    folder.Name = (sourceName or "RBXL") .. " [RBXL BETA]"
    local made = {}
    local createdCount = 0
    local failedCount = 0
    local failedClasses = {}

    -- Studio Lite does not expose every DataModel service. These are only
    -- organizational folders inside the import container, never real services.
    -- Keep the names aligned with Studio Lite's compact explorer.
    local SERVICE_GROUPS = {
        Workspace = "WS",
        ReplicatedFirst = "RF",
        ReplicatedStorage = "RS",
        Players = "Player",
        Lighting = "Lighting",
        StarterPlayer = "SP",
        StarterGui = "SG",
        StarterPack = "SPack",
        Teams = "Teams",
        ServerScriptService = "SSS",
        ServerStorage = "SS",
    }

    local groups = {}
    local function getGroup(name)
        if groups[name] then return groups[name] end
        local g = Instance.new("Folder")
        g.Name = name
        g.Parent = folder
        groups[name] = g
        return g
    end

    local function safeSet(obj, property, value)
        if value == nil then return false end
        return pcall(function() obj[property] = value end)
    end

    local function applyEnum(obj, property, enumType, value)
        if value == nil then return end
        pcall(function() obj[property] = enumType:FromValue(value) end)
    end

    local function applyProps(obj, props)
        -- Keep the property aliases that were fixed in the working RBXL build.
        safeSet(obj, "Name", props.Name)

        if obj:IsA("BasePart") then
            safeSet(obj, "Anchored", props.Anchored)
            safeSet(obj, "CanCollide", props.CanCollide)
            safeSet(obj, "CanQuery", props.CanQuery)
            safeSet(obj, "CanTouch", props.CanTouch)
            safeSet(obj, "CastShadow", props.CastShadow)
            safeSet(obj, "Massless", props.Massless)
            safeSet(obj, "Locked", props.Locked)
            safeSet(obj, "Size", props.Size or props.size)
            safeSet(obj, "CFrame", props.CFrame)
            safeSet(obj, "Color", props.Color or props.Color3uint8)
            safeSet(obj, "Transparency", props.Transparency)
            safeSet(obj, "Reflectance", props.Reflectance)
            safeSet(obj, "CollisionGroup", props.CollisionGroup)
            safeSet(obj, "MaterialVariant", props.MaterialVariant or props.MaterialVariantSerialized)
            applyEnum(obj, "Material", Enum.Material, props.Material)
            applyEnum(obj, "Shape", Enum.PartType, props.shape)
            for _, side in ipairs({"Top","Bottom","Left","Right","Front","Back"}) do
                applyEnum(obj, side.."Surface", Enum.SurfaceType, props[side.."Surface"])
                applyEnum(obj, side.."SurfaceInput", Enum.InputType, props[side.."SurfaceInput"])
            end
            safeSet(obj, "Velocity", props.Velocity)
            safeSet(obj, "RotVelocity", props.RotVelocity)
        end

        if obj:IsA("MeshPart") then
            safeSet(obj, "MeshId", props.MeshId)
            safeSet(obj, "TextureID", props.TextureID)
        end

        if obj:IsA("Sound") then
            safeSet(obj, "SoundId", props.SoundId)
            safeSet(obj, "Volume", props.Volume)
            safeSet(obj, "PlaybackSpeed", props.PlaybackSpeed)
            safeSet(obj, "Looped", props.Looped)
            safeSet(obj, "Playing", props.Playing)
            safeSet(obj, "TimePosition", props.TimePosition)
            applyEnum(obj, "RollOffMode", Enum.RollOffMode, props.RollOffMode)
        end

        if obj:IsA("Animation") then
            safeSet(obj, "AnimationId", props.AnimationId)
        end

        if obj:IsA("Tool") then
            safeSet(obj, "TextureId", props.TextureId)
            safeSet(obj, "ToolTip", props.ToolTip)
            safeSet(obj, "CanBeDropped", props.CanBeDropped)
            safeSet(obj, "Enabled", props.Enabled)
            safeSet(obj, "RequiresHandle", props.RequiresHandle)
        end

        -- Source is a ProtectedString in Roblox, encoded through RBXL's
        -- string-like TypeID 0x01. Studio Lite may expose the Script object but
        -- reject direct Source writes, so V1.3 uses several safe fallbacks.
        if obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
            local source = props.Source or props.ContentText
            if type(source) == "string" then
                source = source:gsub("\0+$", "")

                -- Studio-Lite compatibility: keep SoundService under the
                -- imported WS group and rewrite common runtime service paths.
                local function compatSource(src)
                    src = src:gsub("game:GetService%s*%(%s*[\"']SoundService[\"']%s*%)", "workspace.WS.SoundService")
                    src = src:gsub("game%.SoundService", "workspace.WS.SoundService")
                    return src
                end
                source = compatSource(source)

                _G.Hyaz_RAW_SOURCES[obj] = source

                local written = false
                local ok = pcall(function() obj.Source = source end)
                written = ok and tostring(obj.Source or "") == source

                -- Common executor/runtime fallback for protected properties.
                if not written and type(setscriptable) == "function" then
                    pcall(function() setscriptable(obj, "Source", true) end)
                    local ok2 = pcall(function() obj.Source = source end)
                    if ok2 then written = true end
                end

                -- Studio/Studio-Lite ScriptEditorService fallback when exposed.
                if not written then
                    pcall(function()
                        local ScriptEditorService = game:GetService("ScriptEditorService")
                        if ScriptEditorService and ScriptEditorService.UpdateSourceAsync then
                            ScriptEditorService:UpdateSourceAsync(obj, function()
                                return source
                            end)
                            written = true
                        end
                    end)
                end

                -- Studio Lite's script UI uses a CodeTextBox companion. This
                -- keeps the decoded source visible even when Source is locked.
                pcall(function()
                    local slFolder = ReplicatedStorage:FindFirstChild("StudioLiteFolder")
                    local serverFuncs = slFolder and slFolder:FindFirstChild("ServerFunctions")
                    if not serverFuncs then return end

                    local existing = obj:FindFirstChild("SL_CodeTextBox")
                    if existing and existing:IsA("TextBox") then
                        existing.Text = source
                        return
                    end

                    local map = {
                        Script = "InsertScriptScript",
                        LocalScript = "InsertLocalScriptLocalScript",
                        ModuleScript = "InsertModuleScriptModuleScript",
                    }
                    local assetName = map[obj.ClassName]
                    if not assetName then return end

                    serverFuncs:InvokeServer("LoadAssetToPlayerGui", assetName)
                    local guiF = LocalPlayer:WaitForChild("PlayerGui"):WaitForChild(assetName, 3)
                    if not guiF then return end

                    for _, child in ipairs(guiF:GetChildren()) do
                        local clone = child:Clone()
                        clone.Parent = obj
                    end
                    pcall(function()
                        serverFuncs:InvokeServer("ClearAssetFromPlayerGui", assetName)
                    end)

                    local tb = obj:FindFirstChild("SL_CodeTextBox")
                    if tb and tb:IsA("TextBox") then
                        tb.Text = source
                    end
                end)
            end
        end

        -- GUI layout: these must retain their UDim/UDim2 components instead
        -- of being approximated as Vector2 values.
        if obj:IsA("GuiObject") then
            safeSet(obj, "Position", props.Position)
            safeSet(obj, "Size", props.Size)
            safeSet(obj, "AnchorPoint", props.AnchorPoint)
            safeSet(obj, "Rotation", props.Rotation)
            safeSet(obj, "Visible", props.Visible)
            safeSet(obj, "ZIndex", props.ZIndex)
            safeSet(obj, "LayoutOrder", props.LayoutOrder)
            safeSet(obj, "AutomaticSize", props.AutomaticSize)
        end

        if obj:IsA("ScrollingFrame") then
            safeSet(obj, "CanvasSize", props.CanvasSize)
            safeSet(obj, "CanvasPosition", props.CanvasPosition)
            safeSet(obj, "ScrollBarThickness", props.ScrollBarThickness)
            safeSet(obj, "ScrollingDirection", props.ScrollingDirection)
            safeSet(obj, "ElasticBehavior", props.ElasticBehavior)
        end

        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            safeSet(obj, "Text", props.Text)
            safeSet(obj, "TextSize", props.TextSize)
            safeSet(obj, "TextScaled", props.TextScaled)
            safeSet(obj, "TextWrapped", props.TextWrapped)
            safeSet(obj, "TextColor3", props.TextColor3)
            safeSet(obj, "TextTransparency", props.TextTransparency)
            safeSet(obj, "TextXAlignment", props.TextXAlignment)
            safeSet(obj, "TextYAlignment", props.TextYAlignment)
            safeSet(obj, "Font", props.Font)
        end

        if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
            safeSet(obj, "Image", props.Image)
            safeSet(obj, "ImageColor3", props.ImageColor3)
            safeSet(obj, "ImageTransparency", props.ImageTransparency)
            safeSet(obj, "ScaleType", props.ScaleType)
        end

        safeSet(obj, "Archivable", props.Archivable)
        safeSet(obj, "Enabled", props.Enabled)
        safeSet(obj, "Visible", props.Visible)
        safeSet(obj, "Text", props.Text)
        safeSet(obj, "Image", props.Image)
        safeSet(obj, "Texture", props.Texture)
        safeSet(obj, "Value", props.Value)
    end

    local function makeNode(node)
        -- Service instances themselves cannot be recreated in Studio Lite.
        if node.IsService or node.Service then
            return nil
        end

        local ok, obj = pcall(Instance.new, node.ClassName)
        if not ok or not obj then
            failedCount += 1
            failedClasses[node.ClassName] = (failedClasses[node.ClassName] or 0) + 1
            return nil
        end

        createdCount += 1
        made[node.Ref] = obj
        applyProps(obj, node.Properties)

        -- IMPORTANT: use the same recursive construction order as the
        -- previously working V1.7 build. Grouping happens only at the roots.
        for _, child in ipairs(node.Children) do
            local c = makeNode(child)
            if c then
                c.Parent = obj
            end
        end

        return obj
    end

    -- Root service grouping. We never move individual descendants out of
    -- their original hierarchy; only the top-level service container changes.
    for _, root in ipairs(parsed.Roots) do
        if root.IsService or root.Service then
            local key = SERVICE_GROUPS[root.ClassName]

            if root.ClassName == "StarterPlayer" then
                key = "SP"
            end

            if root.ClassName == "SoundService" then
                -- Studio Lite has no native SoundService. Keep a compatible
                -- container inside the imported Workspace group.
                local ws = getGroup("WS")
                local soundService = ws:FindFirstChild("SoundService")
                if not soundService then
                    soundService = Instance.new("Folder")
                    soundService.Name = "SoundService"
                    soundService.Parent = ws
                end
                for _, child in ipairs(root.Children) do
                    local obj = makeNode(child)
                    if obj then obj.Parent = soundService end
                end
            elseif key then
                local group = getGroup(key)
                for _, child in ipairs(root.Children) do
                    local obj = makeNode(child)
                    if obj then obj.Parent = group end
                end
            else
                -- Unknown/unavailable service: preserve it instead of silently
                -- discarding its contents.
                local group = getGroup(root.ClassName)
                for _, child in ipairs(root.Children) do
                    local obj = makeNode(child)
                    if obj then obj.Parent = group end
                end
            end
        else
            -- Non-service root belongs to the imported Workspace group.
            local obj = makeNode(root)
            if obj then
                obj.Parent = getGroup("WS")
            end
        end
    end

    -- Keep the compact Studio Lite structure: SPS/SCS stay under SP when the
    -- imported file contains StarterPlayerScripts/StarterCharacterScripts.
    local sp = groups.SP
    if sp then
        local sps = sp:FindFirstChild("StarterPlayerScripts")
        if sps then sps.Name = "SPS" end
        local scs = sp:FindFirstChild("StarterCharacterScripts")
        if scs then scs.Name = "SCS" end
    end

    local failedList = {}
    for className, count in pairs(failedClasses) do
        table.insert(failedList, className .. " x" .. count)
    end
    table.sort(failedList)

    return folder, made, {
        Created = createdCount,
        Failed = failedCount,
        FailedClasses = failedList,
    }
end


-- ============================================================
-- FILE SYSTEM
-- ============================================================
local function safeReadFile(path)
    if type(readfile) ~= "function" then return nil, "readfile tidak tersedia" end
    local ok, data = pcall(readfile, path)
    if not ok or type(data) ~= "string" or #data == 0 then
        return nil, "readfile gagal"
    end
    return data
end

local function isRBXL(path)
    return type(path) == "string" and path:lower():match("%.rbxl$") ~= nil
end

local function collectRBXL()
    local result, seen = {}, {}

    -- Delta/executor file roots. We intentionally scan the filesystem,
    -- not Roblox Workspace, because RBXL files are external files.
    local roots = {
        "/sdcard/Delta/workspace",
        "/sdcard/Android/Delta/workspace",
        "/storage/emulated/0/Delta/workspace",
        "/storage/emulated/0/Android/Delta/workspace",
        "Delta/workspace",
        "delta/workspace",
        "Android/Delta/workspace",
        "workspace",
        "Workspace",
        ".",
        "",
    }

    local function normalize(p)
        return tostring(p):gsub("\\", "/")
    end

    local function add(path)
        path = normalize(path)
        if #result >= CONFIG.MaxFiles or seen[path] then return end
        if isRBXL(path) then
            seen[path] = true
            result[#result + 1] = path
        end
    end

    local function walk(path, depth)
        if #result >= CONFIG.MaxFiles or depth > 8 then return end
        if type(listfiles) ~= "function" then return end

        local ok, entries = pcall(listfiles, path)
        if not ok or type(entries) ~= "table" then return end

        for _, entry in ipairs(entries) do
            if #result >= CONFIG.MaxFiles then break end

            local p = normalize(entry)
            if isRBXL(p) then
                add(p)
            elseif type(isfolder) == "function" then
                local fok, folder = pcall(isfolder, p)
                if fok and folder then
                    walk(p, depth + 1)
                end
            end
        end
    end

    -- Avoid repeatedly walking the same physical root.
    local rootSeen = {}
    for _, root in ipairs(roots) do
        root = normalize(root)
        if not rootSeen[root] then
            rootSeen[root] = true
            walk(root, 0)
        end
    end

    return result
end

-- ============================================================
-- IMPORT
-- ============================================================
local function importRBXL(path)
    local data, readErr = safeReadFile(path)
    if not data then return false, readErr end

    local ok, parsed, err = pcall(parseRBXLBinary, data)
    if not ok then
        return false, "Parser crash: " .. tostring(parsed)
    end
    if not parsed then
        return false, tostring(err or "RBXL parser gagal")
    end

    local sourceName = path:match("([^/\\]+)$") or "RBXL"
    sourceName = sourceName:gsub("%.rbxl$", "")

    local buildOK, folder, made, stats = pcall(function()
        return createRBXLInstances(parsed, sourceName)
    end)
    if not buildOK or not folder then
        return false, "Instance builder gagal: " .. tostring(folder)
    end

    folder.Parent = workspace
    local count = #folder:GetDescendants()

    local sourceCount = 0
    for _, obj in ipairs(folder:GetDescendants()) do
        if obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
            if _G.Hyaz_RAW_SOURCES[obj] and #_G.Hyaz_RAW_SOURCES[obj] > 0 then
                sourceCount += 1
            end
        end
    end

    local detail = string.format(
        "%d object(s) dibuat | %d/%d instance | %d class | %d script source",
        count, stats and stats.Created or count, parsed.Header.InstanceCount, parsed.Header.ClassCount, sourceCount
    )

    if stats and stats.Failed > 0 then
        detail = detail .. " | gagal: " .. stats.Failed
        if stats.FailedClasses and #stats.FailedClasses > 0 then
            detail = detail .. " [" .. table.concat(stats.FailedClasses, ", ") .. "]"
        end
    end

    return true, detail
end

