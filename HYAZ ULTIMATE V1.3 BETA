UIScale.Parent = UI

local function updateUIScale()
    local camera = workspace.CurrentCamera
    if not camera then return end

    local vp = camera.ViewportSize
    local sx = vp.X / 440
    local sy = vp.Y / 520

    -- Keep the desktop size at 1.0 while preventing the window from
    -- becoming larger than the available mobile viewport.
    UIScale.Scale = math.clamp(math.min(sx, sy), 0.78, 1)
end

