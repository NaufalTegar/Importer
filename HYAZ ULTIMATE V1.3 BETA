local function setSpawnerPreset(longMode)
    if longMode then
        currentSize = Vector3.new(5, 0.699, 15)
        LongBtn.BackgroundColor3 = Theme.accentDark
        LongBtn.TextColor3 = Theme.text
        SquareBtn.BackgroundColor3 = Theme.panel2
        SquareBtn.TextColor3 = Theme.muted
    else
        currentSize = Vector3.new(5, 0.699, 6)
        SquareBtn.BackgroundColor3 = Theme.accentDark
        SquareBtn.TextColor3 = Theme.text
        LongBtn.BackgroundColor3 = Theme.panel2
        LongBtn.TextColor3 = Theme.muted
    end
end

LongBtn.MouseButton1Click:Connect(function()
    setSpawnerPreset(true)
end)

SquareBtn.MouseButton1Click:Connect(function()
    setSpawnerPreset(false)
end)

local isTargeting = false

local function spawnAtPosition(targetCFrame)
    local newPart = Instance.new("Part")
    newPart.Name = "SpecialMeshPart"
    newPart.Size = currentSize
    newPart.Material = Enum.Material.SmoothPlastic
    newPart.TopSurface = Enum.SurfaceType.Smooth
    newPart.BottomSurface = Enum.SurfaceType.Smooth
    newPart.CFrame = targetCFrame * CFrame.new(0, currentSize.Y / 2, 0)
    newPart.Anchored = true
    newPart.CanCollide = true

    local specialMesh = Instance.new("SpecialMesh")
    specialMesh.MeshType = Enum.MeshType.Brick
    specialMesh.Scale = currentSize

    local rawTexId = TextureBox.Text:gsub("%D", "")
    if rawTexId ~= "" then
        specialMesh.TextureId = "rbxassetid://" .. rawTexId
    end

    specialMesh.Parent = newPart
    newPart.Parent = Workspace
end

SpawnBtn.MouseButton1Click:Connect(function()
    if not HYAZSpawner.isWhitelisted() then
        SpawnStatus.Text = "●  ACCESS DENIED"
        SpawnStatus.TextColor3 = Color3.fromRGB(255, 70, 80)
        return
    end

    isTargeting = true
    SpawnStatus.Text = "●  CLICK WORLD TO PLACE"
    SpawnStatus.TextColor3 = Color3.fromRGB(255, 180, 70)
    SpawnBtn.BackgroundColor3 = Color3.fromRGB(125, 55, 18)
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not isTargeting or gameProcessed then
        return
    end

    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        local camera = Workspace.CurrentCamera
        if not camera then
            return
        end

        local unitRay = camera:ScreenPointToRay(input.Position.X, input.Position.Y)
        local raycastParams = RaycastParams.new()

        if LocalPlayer.Character then
            raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
            raycastParams.FilterType = Enum.RaycastFilterType.Exclude
        end

        local result = Workspace:Raycast(
            unitRay.Origin,
            unitRay.Direction * 1000,
            raycastParams
        )

        if result then
            spawnAtPosition(CFrame.new(result.Position))
            isTargeting = false
            SpawnStatus.Text = "●  PART SPAWNED"
            SpawnStatus.TextColor3 = Theme.accent
            SpawnBtn.BackgroundColor3 = Theme.accentDark

            task.delay(2, function()
                if SpawnStatus and SpawnStatus.Parent and not isTargeting then
                    SpawnStatus.Text = "●  READY"
                end
            end)
        end
    end
end)

-- Navigation: importer remains the original module; spawner overlays the right panel.
local function selectModule(moduleId)
    local importerActive = moduleId == 1

    SpawnerPanel.Visible = not importerActive
    SearchBar.Visible = importerActive
    Scroll.Visible = importerActive
    EmptyFrame.Visible = importerActive and EmptyFrame.Visible

    RBXMButton.BackgroundColor3 = importerActive and Color3.fromRGB(92, 17, 28) or Theme.panel2
    SpawnButton.BackgroundColor3 = importerActive and Theme.panel2 or Color3.fromRGB(92, 17, 28)

    RBXMClick.AutoButtonColor = false
    SpawnClick.AutoButtonColor = false

    StatusText.Text = importerActive and "READY" or "SPAWNER"
end

RBXMClick.MouseButton1Click:Connect(function()
    selectModule(1)
end)

SpawnClick.MouseButton1Click:Connect(function()
    selectModule(2)
end)

-- Keep the importer selected on startup.
selectModule(1)
