-- --------------------------------------------------------------------------
-- Layering fix
-- Roblox ZIndexBehavior = Sibling means child GuiObjects do NOT inherit the
-- ZIndex of their parent.  Main uses ZIndex 10, so content children at the
-- default ZIndex 1 were being rendered BEHIND the black Main background.
-- Keep every visible child above Main while preserving the header/notification
-- layers and give interactive controls a small additional priority.
-- --------------------------------------------------------------------------
local function normalizeLayer(obj, baseZ)
    if not obj or not obj:IsA("GuiObject") then return end

    local target = baseZ or 13
    if obj:IsA("TextButton") or obj:IsA("ImageButton") then
        target = math.max(target, 15)
    elseif obj:IsA("TextBox") then
        target = math.max(target, 14)
    end

    if obj.ZIndex < target then
        obj.ZIndex = target
    end
end

local function normalizeTree(root, baseZ)
    for _, obj in ipairs(root:GetDescendants()) do
        normalizeLayer(obj, baseZ)
    end
end

-- Normalize the existing main-window layers.
normalizeTree(Main, 13)
normalizeTree(TitleBar, 20)
normalizeTree(Sidebar, 13)
normalizeTree(Content, 13)

-- New file cards and module controls are created later, so keep future
-- descendants correctly layered as well.
Content.DescendantAdded:Connect(function(obj)
    task.defer(function()
        normalizeLayer(obj, 13)
    end)
end)
Sidebar.DescendantAdded:Connect(function(obj)
    task.defer(function()
        normalizeLayer(obj, 13)
    end)
end)

