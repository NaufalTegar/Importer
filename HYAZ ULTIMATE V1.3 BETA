-- Normalize every loader result into an array of Instances.
-- Some environments return a single Instance from LoadLocalAsset, while
-- GetObjects normally returns an array.
local function normalizeLoadedObjects(value)
    if typeof(value) == "Instance" then
        return { value }
    end
    if type(value) == "table" then
        local out = {}
        for _, item in ipairs(value) do
            if typeof(item) == "Instance" then
                table.insert(out, item)
            end
        end
        return out
    end
    return {}
end

-- ================================================================
-- HYAZ ULTIMATE V1.3 BETA // RBXL BINARY DECODER
-- Experimental: decodes Roblox Binary Place/Model chunks when the
-- runtime exposes a ZSTD/LZ4 decompression primitive.
--
-- RBXL is a chunked binary format: META/SSTR/INST/PROP/PRNT/END.
-- Compressed chunks use ZSTD or LZ4. This beta deliberately refuses
-- to guess/execute arbitrary bytecode from the file.
-- ================================================================

local RBXL_BETA = {
    enabled = true,
    version = "1.3-BETA",
    maxInstances = 20000,
}

local function rbxl_u8(s, p)
    return string.byte(s, p), p + 1
end

local function rbxl_u32le(s, p)
    local a,b,c,d = string.byte(s, p, p+3)
    if not a then return nil, p end
    return a + b*256 + c*65536 + d*16777216, p + 4
end

local function rbxl_i32le(s, p)
    local n, np = rbxl_u32le(s, p)
    if not n then return nil, np end
    if n >= 2147483648 then n = n - 4294967296 end
    return n, np
end

local function rbxl_u32be(s, p)
    local a,b,c,d = string.byte(s, p, p+3)
    if not a then return nil, p end
    return a*16777216 + b*65536 + c*256 + d, p + 4
end

local function rbxl_string(s, p)
    local n, np = rbxl_u32le(s, p)
    if not n or np + n - 1 > #s then return nil, p end
    return s:sub(np, np+n-1), np+n
end

local function rbxl_unzigzag(n)
    if n % 2 == 0 then return n / 2 end
    return -(n + 1) / 2
end

-- Referents and many numeric arrays use Roblox's transformed /
-- interleaved representation. This helper decodes a single transformed
-- big-endian int32 after de-interleaving has already been performed.
local function rbxl_read_transformed_i32_be(s, p)
    local u, np = rbxl_u32be(s, p)
    if not u then return nil, np end
    return rbxl_unzigzag(u), np
end

local function rbxl_try_decompress(body, expected)
    local magic = body:sub(1,4)
    local candidates = {}

    -- Different runtimes expose different names/signatures. We only call
    -- functions that actually exist; each attempt is isolated with pcall.
    if magic == string.char(0x28,0xB5,0x2F,0xFD) then
        if type(zstd_decompress) == "function" then
            table.insert(candidates, function() return zstd_decompress(body, expected) end)
            table.insert(candidates, function() return zstd_decompress(body) end)
        end
        if zstd and type(zstd.decompress) == "function" then
            table.insert(candidates, function() return zstd.decompress(body, expected) end)
            table.insert(candidates, function() return zstd.decompress(body) end)
        end
        if crypt and crypt.zstd and type(crypt.zstd.decompress) == "function" then
            table.insert(candidates, function() return crypt.zstd.decompress(body) end)
        end
        if syn and syn.crypt and syn.crypt.zstd and type(syn.crypt.zstd.decompress) == "function" then
            table.insert(candidates, function() return syn.crypt.zstd.decompress(body) end)
        end
    else
        if type(lz4_decompress) == "function" then
            table.insert(candidates, function() return lz4_decompress(body, expected) end)
            table.insert(candidates, function() return lz4_decompress(body) end)
        end
        if lz4 and type(lz4.decompress) == "function" then
            table.insert(candidates, function() return lz4.decompress(body, expected) end)
            table.insert(candidates, function() return lz4.decompress(body) end)
        end
        if crypt and crypt.lz4 and type(crypt.lz4.decompress) == "function" then
            table.insert(candidates, function() return crypt.lz4.decompress(body) end)
        end
    end

    for _, fn in ipairs(candidates) do
        local ok, out = pcall(fn)
        if ok and type(out) == "string" and #out == expected then
            return out, nil
        end
    end

    return nil, magic == string.char(0x28,0xB5,0x2F,0xFD)
        and "ZSTD decompressor tidak tersedia di environment"
        or "LZ4 decompressor tidak tersedia di environment"
end

local function rbxl_decode_chunks(data)
    if data:sub(1,14) ~= "<roblox!" .. string.char(0x89,0xFF,0x0D,0x0A,0x1A,0x0A) then
        return nil, "Header RBXL binary tidak valid"
    end
    if #data < 32 then return nil, "Header RBXL terlalu pendek" end

    local version = string.byte(data,15) + string.byte(data,16)*256
    if version ~= 0 then return nil, "RBXL version tidak didukung: "..tostring(version) end

    local classCount = select(1, rbxl_u32le(data,17))
    local instanceCount = select(1, rbxl_u32le(data,21))
    local pos = 33
    local chunks = {}
    local compressedSeen = {}
    local endSeen = false

    while pos + 15 <= #data do
        local name = data:sub(pos,pos+3)
        local clen = select(1, rbxl_u32le(data,pos+4))
        local ulen = select(1, rbxl_u32le(data,pos+8))
        pos = pos + 16

        if not clen then return nil, "Chunk header rusak" end
        local storedLen = clen ~= 0 and clen or ulen
        if pos + storedLen - 1 > #data then
            return nil, "Chunk "..name.." melebihi ukuran file"
        end

        local body = data:sub(pos, pos+storedLen-1)
        pos = pos + storedLen

        if clen ~= 0 then
            compressedSeen[name] = true
            local decoded, derr = rbxl_try_decompress(body, ulen)
            if not decoded then
                return nil, "Chunk "..name.." terkompresi: "..derr
            end
            body = decoded
        end

        chunks[#chunks+1] = {name=name, data=body, compressed=(clen ~= 0)}
        if name == "END\0" or name == "END." then
            endSeen = true
            break
        end
    end

    if not endSeen then
        return nil, "Chunk END tidak ditemukan"
    end

    return {
        version=version,
        classCount=classCount,
        instanceCount=instanceCount,
        chunks=chunks,
        compressedSeen=compressedSeen,
    }, nil
end

local function rbxl_parse_inst(chunk, model)
    local p = 1
    local classId = select(1, rbxl_u32le(chunk,p)); p=p+4
    local className; className,p = rbxl_string(chunk,p)
    if not className then return false end
    local objectFormat; objectFormat,p = rbxl_u8(chunk,p)
    local count; count,p = rbxl_u32le(chunk,p)
    if not count or count > RBXL_BETA.maxInstances then return false end

    local refs = {}
    for i=1,count do
        local v; v,p = rbxl_read_transformed_i32_be(chunk,p)
        if not v then return false end
        refs[i] = v
    end

    model.classes[classId] = {
        id=classId, name=className, service=(objectFormat == 1), refs=refs
    }
    for _, ref in ipairs(refs) do
        model.refClass[ref] = className
        model.refOrder[#model.refOrder+1] = ref
    end
    return true
end

local function rbxl_parse_prnt(chunk, model)
    local p = 1
    local ver; ver,p = rbxl_u8(chunk,p)
    local count; count,p = rbxl_u32le(chunk,p)
    if ver ~= 0 or not count or count > RBXL_BETA.maxInstances then return false end

    local children, parents = {}, {}
    for i=1,count do
        children[i],p = rbxl_read_transformed_i32_be(chunk,p)
        if not children[i] then return false end
    end
    for i=1,count do
        parents[i],p = rbxl_read_transformed_i32_be(chunk,p)
        if not parents[i] then return false end
    end
    model.parentPairs = {}
    for i=1,count do
        model.parentPairs[#model.parentPairs+1] = {child=children[i], parent=parents[i]}
    end
    return true
end

local function rbxl_safe_instance(className, name)
    local ok, obj = pcall(Instance.new, className)
    if not ok or not obj then return nil end
    pcall(function() obj.Name = name or className end)
    return obj
end

local function rbxl_materialize(model)
    local instances = {}
    local rootObjects = {}

    for ref, className in pairs(model.refClass) do
        if className ~= "DataModel" then
            local obj = rbxl_safe_instance(className, className)
            if obj then instances[ref] = obj end
        end
    end

    -- Apply hierarchy after all instances exist.
    for _, pair in ipairs(model.parentPairs or {}) do
        local child = instances[pair.child]
        if child then
            local parent = instances[pair.parent]
            if parent then
                pcall(function() child.Parent = parent end)
            else
                rootObjects[#rootObjects+1] = child
            end
        end
    end

    return instances, rootObjects
end

local function loadRBXLBinaryBeta(fileInfo)
    local data = safeReadFile(fileInfo.path)
    if not data or #data == 0 then
        return false, "RBXL BETA: readfile gagal"
    end

    local parsed, err = rbxl_decode_chunks(data)
    if not parsed then
        return false, "RBXL BETA: "..tostring(err)
    end

    local model = {
        classes={}, refClass={}, refOrder={}, parentPairs={}
    }

    for _, ch in ipairs(parsed.chunks) do
        if ch.name == "INST" then
            if not rbxl_parse_inst(ch.data, model) then
                return false, "RBXL BETA: INST chunk tidak dapat diparse"
            end
        elseif ch.name == "PRNT" then
            if not rbxl_parse_prnt(ch.data, model) then
                return false, "RBXL BETA: PRNT chunk tidak dapat diparse"
            end
        end
    end

    local instances, roots = rbxl_materialize(model)
    local count = 0
    for _, obj in ipairs(roots) do
        pcall(function()
            local target = SVC_MAP[obj.ClassName] or workspace
            if target == workspace and obj:IsA("Service") then target = ReplicatedStorage end
            obj.Parent = target
            injectAllScripts(obj, {})
            ApplyStudioLiteProperties(obj)
            LoadAssetsToSLServer(obj)
            count = count + 1
        end)
    end

    if count == 0 then
        return false, string.format(
            "RBXL BETA parsed (%d instance refs) tetapi root object belum dapat dimaterialisasi",
            parsed.instanceCount or 0
        )
    end

    return true, string.format(
        "RBXL BETA loaded • %d root object(s) • %d refs",
        count, parsed.instanceCount or 0
    )
end

-- RBXL/RBXLX dispatcher.
local function loadRBXL(fileInfo, sourceMap)
    local data = safeReadFile(fileInfo.path)
    if not data or #data == 0 then
        return false, "RBXL gagal: readfile gagal"
    end

    -- Binary place/model files start with <roblox!; XML files start with
    -- <roblox>. The binary beta parser is intentionally selected only for
    -- the binary signature.
    if data:sub(1,8) == "<roblox!" then
        return loadRBXLBinaryBeta(fileInfo)
    end

    -- RBXLX can still use the environment's local asset bridge.
    local attempts = {}
    if InsertService and InsertService.LoadLocalAsset then
        table.insert(attempts, function()
            return InsertService:LoadLocalAsset(fileInfo.path)
        end)
    end
    if getcustomasset then
        table.insert(attempts, function()
            local asset = getcustomasset(fileInfo.path)
            if not asset then return nil end
            return game:GetObjects(asset)
        end)
    end

    for _, loader in ipairs(attempts) do
        local ok, result = pcall(loader)
        if ok then
            local objects = normalizeLoadedObjects(result)
            if #objects > 0 then
                local count = insertObjects(objects, true, sourceMap or {})
                if count > 0 then
                    return true, string.format("RBXLX berhasil dimuat • %d object(s)", count)
                end
            end
        end
    end

    return false, "RBXLX/RBXL loader gagal"
end

local function loadFile(fileInfo)
    local isRbxl = fileInfo.ftype == "RBXL"
    local data = safeReadFile(fileInfo.path)
    if not data or #data == 0 then return false, "readfile gagal: " .. tostring(fileInfo.path) end

    if isRbxl then
        return loadRBXL(fileInfo, {})
    end

    local sourceMap = {}
    local ok, sources = pcall(parseRBXMForSources, data)
    if ok and sources then sourceMap = sources end

    if getcustomasset then
        local ok1, aid = pcall(getcustomasset, fileInfo.path)
        if ok1 and aid then
            local ok2, objs = pcall(function() return game:GetObjects(aid) end)
            if ok2 and objs and #objs > 0 then
                return true, insertObjects(objs, false, sourceMap) .. " object(s) loaded"
            end
        end
    end

    local ok3, o3 = pcall(function() return game:GetObjects("rbxasset://" .. fileInfo.path) end)
    if ok3 and o3 and #o3 > 0 then
        return true, insertObjects(o3, false, sourceMap) .. " object(s) loaded"
    end

    return false, "Semua metode RBXM loader gagal"
end

-- FILE SCANNER
--                                                                        
local function safeListFiles(p) if not listfiles then return nil end; local ok, f = pcall(listfiles, p); return ok and f or nil end
local function getFileName(p) return p:match("([^/]+)$") or p end
local function getFileType(n) 
    n = n:lower(); 
    if n:match("%.rbxl") or n:match("%.rbxlx") then return "RBXL" 
    elseif n:match("%.rbxm") or n:match("%.rbxmx") then return "RBXM" end; 
    return nil 
end
local function looksFolder(p) return not getFileName(p):match("%.[%a%d]+") end

local SCAN_PATHS = { "workspace", "Delta/workspace", "delta/workspace", "Android/Delta/workspace", "/sdcard/Delta/workspace", "/sdcard/Android/Delta/workspace", "../workspace", ".", "" }

local function scanDeep(folder, depth, results, seen)
    if depth > 4 or seen[folder] then return end
    seen[folder] = true
    local list = safeListFiles(folder)
    if not list then return end
    for _, path in ipairs(list) do
        local name = getFileName(path); local ftype = getFileType(name)
        if ftype and not seen[path] then
            seen[path] = true; table.insert(results, { name=name, path=path, ftype=ftype, folder=folder })
        elseif looksFolder(path) then scanDeep(path, depth+1, results, seen) end
    end
end

local function scanAll()
    local results, seen = {}, {}; 
    for _, p in ipairs(SCAN_PATHS) do 
        if safeListFiles(p) then scanDeep(p, 0, results, seen) end 
    end
    return results
end

