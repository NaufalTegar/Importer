local function generateSaveScript()
	local lines = {"-- Terrain Craft Export", "local T = workspace.Terrain"}
	for matName, list in pairs(TB.terrainData) do
		for _, e in ipairs(list) do
			if not e.undone then
				table.insert(lines, string.format(
					"T:FillBlock(CFrame.new(%.2f,%.2f,%.2f)*CFrame.Angles(0,math.rad(%d),0), Vector3.new(%.2f,%.2f,%.2f), Enum.Material.%s)",
					e.pos.X, e.pos.Y, e.pos.Z, e.rot, e.size.X, e.size.Y, e.size.Z, matName))
			end
		end
	end
	return table.concat(lines, "\n")
end

UI.saveBtn.MouseButton1Click:Connect(function()
	if not hasFile then
		UI.saveBtn.Text = "Executor tak dukung file"
		task.wait(2); UI.saveBtn.Text = "💾 Simpan ke File"
		return
	end
	safeMakeFolder("TerrainCraft")
	local ok = safeWrite("TerrainCraft/hasil_" .. os.time() .. ".lua", generateSaveScript())
	UI.saveBtn.Text = ok and "✓ Tersimpan!" or "✗ Gagal simpan"
	task.wait(2)
	UI.saveBtn.Text = "💾 Simpan ke File"
end)

-- ═══════════════════════════════════════════════════════════
-- INPUT — SUPPORT MOUSE & TOUCH LAYAR HP
-- ═══════════════════════════════════════════════════════════
local Camera = Workspace.CurrentCamera

local function screenToWorldHit(screenPos)
	local ok, result = pcall(function()
		local unitRay = Camera:ViewportPointToRay(screenPos.X, screenPos.Y)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		if player.Character then params.FilterDescendantsInstances = {player.Character} end
		return Workspace:Raycast(unitRay.Origin, unitRay.Direction * 1000, params)
	end)
	if ok and result then return result.Position end
	return nil
end

local currentInputPos = nil -- posisi layar aktif (mouse atau jari)
local isDrawing = false

local function tryBrush()
	if not TB.placementOn or not currentInputPos then return end
	local pos = screenToWorldHit(currentInputPos)
	if pos then
		if TB.lockY then pos = Vector3.new(pos.X, TB.lockedY, pos.Z) end
		brushOnce(pos)
		updateInfo()
	end
end

UIS.InputBegan:Connect(function(input, processed)
	if processed then return end -- klik di atas UI diabaikan
	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then
		isDrawing = true
		currentInputPos = Vector2.new(input.Position.X, input.Position.Y)
		if TB.placementOn then tryBrush() end
	end
end)

UIS.InputChanged:Connect(function(input, processed)
	if input.UserInputType == Enum.UserInputType.MouseMovement
	or input.UserInputType == Enum.UserInputType.Touch then
		currentInputPos = Vector2.new(input.Position.X, input.Position.Y)
	end
end)

UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then
		isDrawing = false
	end
end)

RunService.RenderStepped:Connect(function()
	if isDrawing and TB.placementOn then
		tryBrush()
	end
end)

updateInfo()

